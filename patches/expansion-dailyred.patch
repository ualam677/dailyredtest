diff --git a/src/tileset_anims.c b/src/tileset_anims.c
index bee91512..e66c7afe 100644
--- a/src/tileset_anims.c
+++ b/src/tileset_anims.c
@@ -1432,3 +1432,51 @@ void InitTilesetAnim_CeladonGym(void)
     sSecondaryTilesetAnimCallback = TilesetAnim_CeladonGym;
 }
 
+// Daily Red: Mt. Silver's summit. The sea of clouds beyond its edge drifts
+// left a pixel every 16 frames: its 12x14 tiles (after the tileset's own 96,
+// 16 to a row in the tileset like its sheet, the other 4 holding other summit
+// pieces; see summit_clouds in scripts/graphics/make-graphics.py) are kept in
+// EWRAM, and every step each pixel row turns one pixel left around the
+// strip's 96 px, which repeat seamlessly across the map, and each row of 12
+// tiles is copied back to VRAM.
+#define SUMMIT_CLOUD_WIDTH  12 // tiles
+#define SUMMIT_CLOUD_HEIGHT 14
+#define SUMMIT_CLOUD_TILE   (NUM_TILES_IN_PRIMARY_FRLG + 96)
+#define SUMMIT_CLOUD_DELAY  16 // frames per pixel
+
+static const u32 sTilesetAnims_MtSilverSummit_Clouds[] = INCGFX_U32("data/tilesets/secondary/mt_silver_summit/anim/clouds.png", ".4bpp");
+static EWRAM_DATA u32 sSummitClouds[SUMMIT_CLOUD_HEIGHT][SUMMIT_CLOUD_WIDTH][TILE_SIZE_4BPP / 4] = {0};
+
+static void TilesetAnim_MtSilverSummit(u16 timer)
+{
+    u32 ty, py, tx, first;
+
+    if (timer != 0)
+        return;
+    for (ty = 0; ty < SUMMIT_CLOUD_HEIGHT; ty++)
+    {
+        for (py = 0; py < 8; py++)
+        {
+            // A 4bpp tile row is a word with its leftmost pixel in the low
+            // nibble: shifting right moves every pixel one to the left.
+            first = sSummitClouds[ty][0][py];
+            for (tx = 0; tx < SUMMIT_CLOUD_WIDTH - 1; tx++)
+                sSummitClouds[ty][tx][py] = (sSummitClouds[ty][tx][py] >> 4) | (sSummitClouds[ty][tx + 1][py] << 28);
+            sSummitClouds[ty][tx][py] = (sSummitClouds[ty][tx][py] >> 4) | (first << 28);
+        }
+    }
+    for (ty = 0; ty < SUMMIT_CLOUD_HEIGHT; ty++)
+        AppendTilesetAnimToBuffer((const u16 *)sSummitClouds[ty], (u16 *)(BG_VRAM + TILE_OFFSET_4BPP(SUMMIT_CLOUD_TILE + ty * 16)), sizeof(sSummitClouds[ty]));
+}
+
+void InitTilesetAnim_MtSilverSummit(void)
+{
+    u32 ty, tx;
+
+    for (ty = 0; ty < SUMMIT_CLOUD_HEIGHT; ty++)
+        for (tx = 0; tx < SUMMIT_CLOUD_WIDTH; tx++)
+            CpuCopy32(&sTilesetAnims_MtSilverSummit_Clouds[(ty * SUMMIT_CLOUD_WIDTH + tx) * (TILE_SIZE_4BPP / 4)], sSummitClouds[ty][tx], TILE_SIZE_4BPP);
+    sSecondaryTilesetAnimCounter = 0;
+    sSecondaryTilesetAnimCounterMax = SUMMIT_CLOUD_DELAY;
+    sSecondaryTilesetAnimCallback = TilesetAnim_MtSilverSummit;
+}
