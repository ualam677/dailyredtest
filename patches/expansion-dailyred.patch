diff --git a/src/dailyred.c b/src/dailyred.c
new file mode 100644
index 00000000..a7e26f02
--- /dev/null
+++ b/src/dailyred.c
@@ -0,0 +1,232 @@
+#include "global.h"
+#include "dailyred.h"
+#include "event_data.h"
+#include "item.h"
+#include "load_save.h"
+#include "main.h"
+#include "malloc.h"
+#include "new_game.h"
+#include "overworld.h"
+#include "pokemon.h"
+#include "random.h"
+#include "save.h"
+#include "string_util.h"
+#include "gba/m4a_internal.h"
+#include "constants/maps.h"
+
+// Game flow for Daily Red: boot, starting a run and how a run ends.
+// The team rules live in dailyred_team.c, RED's team in
+// src/data/trainers_frlg.party (TRAINER_DAILYRED_RED).
+
+// The website fills in this struct in the ROM image before booting it,
+// finding it by its magic bytes (web/rom-config.js), so no emulator API is
+// needed beyond "load this ROM".
+//
+// A seed of 0 means the ROM wasn't patched (for example, it's running in a
+// desktop emulator). The game then shows the normal title screen and seeds
+// itself from the frame the player presses Start.
+struct DailyRedRomConfig
+{
+    u8 magic[16];
+    u32 seed;
+    u16 wins;    // the player's record before this game, for the record message
+    u16 battles;
+    u8 daily;    // TRUE: the website's daily game (one battle, then the game ends)
+    u8 padding[3];
+};
+
+const struct DailyRedRomConfig gDailyRedRomConfig __attribute__((used, aligned(4))) =
+{
+    .magic = {'D', 'A', 'I', 'L', 'Y', 'R', 'E', 'D', '-', 'C', 'O', 'N', 'F', '-', 'V', '2'},
+};
+
+// The website reads this from the emulator's memory (web/game-link.js) to
+// learn when RED's battle starts and how it ended. It finds the struct by the
+// magic bytes followed by the seed it injected, which only this live copy in
+// RAM has. Nothing in the game reads it, so it's volatile: otherwise the
+// compiler (with link-time optimization) drops every write to it.
+struct DailyRedStatus
+{
+    u8 magic[16];
+    u32 seed;
+    u8 phase;  // DAILYRED_PHASE_*
+    u8 result; // DAILYRED_RESULT_*
+    u8 padding[2];
+};
+
+enum
+{
+    DAILYRED_PHASE_EXPLORING,
+    DAILYRED_PHASE_BATTLE,   // RED's battle has started
+    DAILYRED_PHASE_RESULT,   // the battle is over and the result is set
+    DAILYRED_PHASE_FINISHED, // daily game: the closing messages are done
+};
+
+enum
+{
+    DAILYRED_RESULT_NONE,
+    DAILYRED_RESULT_WON,
+    DAILYRED_RESULT_LOST,
+};
+
+static const u8 sStatusMagic[16] = {'D', 'A', 'I', 'L', 'Y', 'R', 'E', 'D', '-', 'S', 'T', 'A', 'T', 'U', 'S', '1'};
+static EWRAM_DATA volatile struct DailyRedStatus sStatus __attribute__((used)) = {0};
+
+// Team generator RNGs, the player's and RED's. Seeded once per boot; each new
+// run continues from where the previous one stopped, so a seed fixes the
+// whole sequence of teams. RED's starts from the seed mixed with RED_RNG_SALT
+// so the two sequences aren't the same numbers (tests/red.mjs mirrors this).
+#define RED_RNG_SALT 0x52454421 // "RED!"
+static EWRAM_DATA u32 sTeamRngState = 0;
+static EWRAM_DATA u32 sRedRngState = 0;
+
+static const u8 sText_PlayerName[] = _("LEAF");
+static const u8 sText_RivalName[] = _("RED");
+
+// The config is read through volatile pointers: the compiler would otherwise
+// assume the values are still the zeros the ROM was built with.
+static u32 GetInjectedSeed(void)
+{
+    return *(const vu32 *)&gDailyRedRomConfig.seed;
+}
+
+static bool8 IsDailyGame(void)
+{
+    return *(const vu8 *)&gDailyRedRomConfig.daily;
+}
+
+static void InitStatus(u32 seed)
+{
+    u32 i;
+
+    for (i = 0; i < sizeof(sStatus.magic); i++)
+        sStatus.magic[i] = sStatusMagic[i];
+    sStatus.seed = seed;
+    sStatus.phase = DAILYRED_PHASE_EXPLORING;
+    sStatus.result = DAILYRED_RESULT_NONE;
+}
+
+bool8 DailyRed_HasInjectedSeed(void)
+{
+    return GetInjectedSeed() != 0;
+}
+
+bool32 DailyRed_IsOnSummit(void)
+{
+    return gSaveBlock1Ptr->location.mapGroup == MAP_GROUP(MAP_DAILY_RED_SUMMIT)
+        && gSaveBlock1Ptr->location.mapNum == MAP_NUM(MAP_DAILY_RED_SUMMIT);
+}
+
+// Fresh, unsaved game data every boot: LEAF, female, fast text, SET battle
+// style. CB2_NewGame then calls NewGameInitData, which calls
+// DailyRed_InitNewGame.
+static void StartNewGame(void)
+{
+    Sav2_ClearSetDefault();
+    SetPokemonCryStereo(gSaveBlock2Ptr->optionsSound);
+    gSaveBlock2Ptr->optionsTextSpeed = OPTIONS_TEXT_SPEED_FAST;
+    // No "Will LEAF change POKeMON?" when RED's Pokemon faints. The Options
+    // menu keeps this locked (option_menu.c).
+    gSaveBlock2Ptr->optionsBattleStyle = OPTIONS_BATTLE_STYLE_SET;
+    gSaveBlock2Ptr->playerGender = FEMALE; // FireRed's own female player, LEAF
+    StringCopy(gSaveBlock2Ptr->playerName, sText_PlayerName);
+    StringCopy(gSaveBlock1Ptr->rivalName, sText_RivalName);
+    SetMainCallback2(CB2_NewGame);
+}
+
+// Used instead of the intro and title screen when the website supplied a
+// seed (from the copyright screen, see intro_frlg.c).
+void CB2_DailyRed_StartFromCopyright(void)
+{
+    u32 seed = GetInjectedSeed();
+
+    // What SeedRngAndSetTrainerId does with the timer, but from the seed.
+    SeedRngAndSetTrainerIdFromSeed(seed);
+    sTeamRngState = seed;
+    sRedRngState = seed ^ RED_RNG_SALT;
+    InitStatus(seed);
+    // No resetting out of a losing battle in the daily game. Only saving,
+    // link play and trading turn it back on, and none of those exist here.
+    if (IsDailyGame())
+        gSoftResetDisabled = TRUE;
+    SetSaveBlocksPointers(GetSaveBlocksPointersBaseOffset());
+    ResetMenuAndMonGlobals();
+    Save_ResetSaveCounters();
+    LoadGameSave(SAVE_NORMAL);
+    InitHeap(gHeap, HEAP_SIZE);
+    StartNewGame();
+}
+
+// Used instead of the main menu when there's no injected seed: seeds the game
+// from the frame the player pressed Start on the title screen.
+void CB2_DailyRed_StartFromTitle(void)
+{
+    SeedRngAndSetTrainerId();
+    sTeamRngState = Random32();
+    sRedRngState = Random32();
+    InitStatus(0);
+    StartNewGame();
+}
+
+// The player's team and RED's for the next run.
+static void GenerateTeam(void)
+{
+    DailyRed_GenerateTeam(gParties[B_TRAINER_PLAYER], &sTeamRngState);
+    CalculatePlayerPartyCount();
+    DailyRed_GenerateRedTeam(&sRedRngState);
+}
+
+// Called from NewGameInitData in place of warping to the player's bedroom.
+void DailyRed_InitNewGame(void)
+{
+    FlagSet(FLAG_SYS_POKEMON_GET); // shows POKeMON in the start menu
+    // Obedience: with the expansion's Gen 8+ rules even your own Pokemon
+    // check badges (against the level they were met at). The Earth Badge
+    // makes every level obey, as Daily Red has always had them.
+    FlagSet(FLAG_BADGE08_GET);
+    EnableNationalPokedex();       // so Pokemon show national dex numbers
+    // Key items that let the player Mega Evolve and use Z-Moves (one of each
+    // per battle; the battle engine enforces that for both sides).
+    AddBagItem(ITEM_MEGA_RING, 1);
+    AddBagItem(ITEM_Z_POWER_RING, 1);
+    // Start the record from the website's saved stats (0 outside the website).
+    VarSet(VAR_DAILYRED_WINS, *(const vu16 *)&gDailyRedRomConfig.wins);
+    VarSet(VAR_DAILYRED_BATTLES, *(const vu16 *)&gDailyRedRomConfig.battles);
+    GenerateTeam();
+    SetWarpDestination(MAP_GROUP(MAP_DAILY_RED_SUMMIT), MAP_NUM(MAP_DAILY_RED_SUMMIT), WARP_ID_NONE, DAILYRED_START_X, DAILYRED_START_Y);
+    WarpIntoMap();
+}
+
+// Special: replaces the player's team after a battle (when not playing the
+// daily game). The map script then warps back to the start position, which
+// also resets RED.
+void DailyRed_StartNextRun(void)
+{
+    GenerateTeam();
+    sStatus.phase = DAILYRED_PHASE_EXPLORING;
+    sStatus.result = DAILYRED_RESULT_NONE;
+}
+
+// Specials the map script calls so the website can follow the battle.
+void DailyRed_OnBattleStart(void)
+{
+    sStatus.phase = DAILYRED_PHASE_BATTLE;
+}
+
+// Call right after the battle, while VAR_RESULT is TRUE if the player lost.
+void DailyRed_OnBattleEnd(void)
+{
+    sStatus.result = gSpecialVar_Result ? DAILYRED_RESULT_LOST : DAILYRED_RESULT_WON;
+    sStatus.phase = DAILYRED_PHASE_RESULT;
+}
+
+void DailyRed_OnDailyGameOver(void)
+{
+    sStatus.phase = DAILYRED_PHASE_FINISHED;
+}
+
+// Specialvar: TRUE in the website's daily game, which ends after one battle.
+u16 DailyRed_IsDailyGame(void)
+{
+    return IsDailyGame();
+}
diff --git a/src/dailyred_red.c b/src/dailyred_red.c
new file mode 100644
index 00000000..c91da5e3
--- /dev/null
+++ b/src/dailyred_red.c
@@ -0,0 +1,537 @@
+#include "global.h"
+#include "dailyred.h"
+#include "data.h"
+#include "pokemon.h"
+#include "random.h"
+#include "trainer_util.h"
+#include "constants/items.h"
+#include "constants/moves.h"
+#include "constants/opponents.h"
+#include "constants/pokeball.h"
+#include "constants/species.h"
+#include "constants/trainers.h"
+
+// RED's team for Daily Red, built at the start of each run (with the player's
+// team) into gDailyRedRedParty, which CreateNPCTrainerParty copies into the
+// battle (battle_setup.c). Every Pokemon gets one of its Pokemon Showdown
+// Random Battle sets (src/dailyred_sets.c) and perfect stats: all IVs maxed by
+// hyper training (the real IVs keep Hidden Power's type), with the set's
+// nature and EVs.
+//
+// On most days (see "RED's team" in the project README):
+//   - A Kanto starter: Venusaur, Charizard or Blastoise, holding its Mega
+//     Stone (Charizard X or Y), level 99.
+//   - Pikachu with a Light Ball and Volt Tackle, level 100.
+//   - A legendary, level 99, picked by the starter: usually its bird
+//     (Venusaur: Moltres, Charizard: Zapdos, Blastoise: Articuno), sometimes
+//     the Galarian bird, the Johto dog (Entei, Raikou, Suicune), Mewtwo
+//     (level 100), Deoxys (any forme), Mew (sometimes shiny), or, rarest,
+//     Mega Mewtwo X or Y (level 100). On a Mega Mewtwo day the starter holds
+//     a Z-Crystal instead of its Mega Stone. Any legendary but Mega Mewtwo
+//     and the Galarian birds (Gen 8, no Z-Moves) may hold a Z-Crystal if its
+//     set does.
+//   - Two of sRedPool and one fully evolved Pokemon from any generation
+//     (gDailyRedPickGroups: no starters, Pikachu's family, legendaries,
+//     mythicals, Ultra Beasts or Paradox Pokemon), level 96, never holding a
+//     Mega Stone or Z-Crystal. No two of these three share a type, no type is
+//     on more than 2 of the six (a Mega's types count with its base form's),
+//     and the team has at most one Eeveelution.
+//   - He leads with Pikachu or one of those three: one that sets entry
+//     hazards (Stealth Rock, Spikes...) if any does, otherwise at random.
+// On ORIGINAL_TEAM_ODDS% of days he has his original team instead, all level
+// 100: Pikachu, Espeon or Lapras, Snorlax, Venusaur, Charizard and Blastoise.
+// The three starters share out a Mega Evolution, a Z-Crystal and a Tera type
+// at random, each with that gimmick's sets (Gen 7 for Mega and Z, Gen 9 for
+// Tera). He leads with Pikachu, Espeon/Lapras or Snorlax.
+//
+// All his Pokemon are male, except the Eeveelutions, Lapras and Gyarados
+// (female) and species with a fixed gender (or none). Only the Tera starter
+// can Terastallize; nothing Dynamaxes.
+//
+// It draws from its own RNG state (see dailyred.c), so a seed always gives the
+// same RED. Its first three draws are always the day's original-team roll, the
+// starter and the legendary roll (tests/red.mjs predicts them).
+
+// Odds, in percent. Raise or lower them to taste; the legendary ones must add
+// up to at most 100 (the rest is the starter's own bird).
+#define ORIGINAL_TEAM_ODDS  5
+#define MEGA_MEWTWO_ODDS    2
+#define MEW_ODDS            5 // includes SHINY_MEW_ODDS
+#define SHINY_MEW_ODDS      1
+#define DEOXYS_ODDS         5
+#define MEWTWO_ODDS        10
+#define GALARIAN_BIRD_ODDS 15
+#define JOHTO_DOG_ODDS     20
+
+#define LEVEL_PIKACHU       100
+#define LEVEL_STARTER       99
+#define LEVEL_LEGENDARY     99
+#define LEVEL_MEWTWO        100 // Mewtwo and Mega Mewtwo
+#define LEVEL_PICK          96
+#define LEVEL_ORIGINAL_TEAM 100
+
+#define MAX_TYPE_COUNT     2  // Pokemon of one type on the team
+#define MAX_PICK_ATTEMPTS  500
+
+enum
+{
+    STARTER_VENUSAUR,
+    STARTER_CHARIZARD,
+    STARTER_BLASTOISE,
+    NUM_STARTERS,
+};
+
+enum
+{
+    LEGENDARY_BIRD,
+    LEGENDARY_GALARIAN_BIRD,
+    LEGENDARY_JOHTO_DOG,
+    LEGENDARY_MEWTWO,
+    LEGENDARY_DEOXYS,
+    LEGENDARY_MEW,
+    LEGENDARY_SHINY_MEW,
+    LEGENDARY_MEGA_MEWTWO,
+};
+
+struct RedStarter
+{
+    u16 species;
+    u16 megas[2]; // Mega formes (Charizard has two)
+    u16 bird;
+    u16 galarianBird;
+    u16 johtoDog;
+};
+
+static const struct RedStarter sRedStarters[NUM_STARTERS] =
+{
+    [STARTER_VENUSAUR]  = {SPECIES_VENUSAUR,  {SPECIES_VENUSAUR_MEGA,    SPECIES_VENUSAUR_MEGA},    SPECIES_MOLTRES,  SPECIES_MOLTRES_GALAR,  SPECIES_ENTEI},
+    [STARTER_CHARIZARD] = {SPECIES_CHARIZARD, {SPECIES_CHARIZARD_MEGA_X, SPECIES_CHARIZARD_MEGA_Y}, SPECIES_ZAPDOS,   SPECIES_ZAPDOS_GALAR,   SPECIES_RAIKOU},
+    [STARTER_BLASTOISE] = {SPECIES_BLASTOISE, {SPECIES_BLASTOISE_MEGA,   SPECIES_BLASTOISE_MEGA},   SPECIES_ARTICUNO, SPECIES_ARTICUNO_GALAR, SPECIES_SUICUNE},
+};
+
+static const u16 sDeoxysFormes[] = {SPECIES_DEOXYS_NORMAL, SPECIES_DEOXYS_ATTACK, SPECIES_DEOXYS_DEFENSE, SPECIES_DEOXYS_SPEED};
+
+// RED's own Pokemon (from the games and Pokemon Adventures), for two of the
+// three picks.
+static const u16 sRedPool[] =
+{
+    SPECIES_POLIWRATH, SPECIES_GYARADOS, SPECIES_AERODACTYL, SPECIES_LAPRAS, SPECIES_SNORLAX,
+    SPECIES_VAPOREON, SPECIES_JOLTEON, SPECIES_FLAREON, SPECIES_ESPEON, SPECIES_UMBREON,
+    SPECIES_LEAFEON, SPECIES_GLACEON, SPECIES_SYLVEON, SPECIES_HITMONLEE, SPECIES_KABUTOPS,
+    SPECIES_VICTREEBEL, SPECIES_MACHAMP, SPECIES_ARCANINE, SPECIES_GENGAR,
+};
+
+static const u16 sEeveelutions[] =
+{
+    SPECIES_VAPOREON, SPECIES_JOLTEON, SPECIES_FLAREON, SPECIES_ESPEON,
+    SPECIES_UMBREON, SPECIES_LEAFEON, SPECIES_GLACEON, SPECIES_SYLVEON,
+};
+
+static const u16 sFemaleSpecies[] = {SPECIES_LAPRAS, SPECIES_GYARADOS}; // and the Eeveelutions
+
+static const u16 sHazardMoves[] =
+{
+    MOVE_STEALTH_ROCK, MOVE_SPIKES, MOVE_TOXIC_SPIKES, MOVE_STICKY_WEB, MOVE_STONE_AXE, MOVE_CEASELESS_EDGE,
+};
+
+// Original-team days: which starter gets which gimmick.
+static const u8 sGimmickOrders[][NUM_STARTERS] =
+{
+    {DAILYRED_SETS_MEGA,  DAILYRED_SETS_ZMOVE, DAILYRED_SETS_TERA},
+    {DAILYRED_SETS_MEGA,  DAILYRED_SETS_TERA,  DAILYRED_SETS_ZMOVE},
+    {DAILYRED_SETS_ZMOVE, DAILYRED_SETS_MEGA,  DAILYRED_SETS_TERA},
+    {DAILYRED_SETS_ZMOVE, DAILYRED_SETS_TERA,  DAILYRED_SETS_MEGA},
+    {DAILYRED_SETS_TERA,  DAILYRED_SETS_MEGA,  DAILYRED_SETS_ZMOVE},
+    {DAILYRED_SETS_TERA,  DAILYRED_SETS_ZMOVE, DAILYRED_SETS_MEGA},
+};
+
+struct RedMember
+{
+    const struct DailyRedSet *set;
+    u32 typeMask;  // its types, and its Mega forme's
+    u16 baseSpecies;
+    u8 level;
+    bool8 shiny;
+};
+
+struct RedTeam
+{
+    struct RedMember members[PARTY_SIZE];
+    u8 count;
+    u8 typeCounts[NUMBER_OF_MON_TYPES];
+    u32 picksTypeMask; // types of the picks so far
+    bool8 hasEeveelution;
+};
+
+EWRAM_DATA struct Pokemon gDailyRedRedParty[PARTY_SIZE] = {0};
+
+static u16 RedRandom(u32 *rng)
+{
+    *rng = ISO_RANDOMIZE1(*rng);
+    return *rng >> 16;
+}
+
+static u32 RedRandom32(u32 *rng)
+{
+    u32 lo = RedRandom(rng);
+    return lo | ((u32)RedRandom(rng) << 16);
+}
+
+static bool32 IsInList(u16 value, const u16 *list, u32 count)
+{
+    u32 i;
+    for (i = 0; i < count; i++)
+    {
+        if (list[i] == value)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static bool32 IsEeveelution(u16 species)
+{
+    return IsInList(GET_BASE_SPECIES_ID(species), sEeveelutions, ARRAY_COUNT(sEeveelutions));
+}
+
+static u32 GetTypeMask(u16 species)
+{
+    return (1u << GetSpeciesType(species, 0)) | (1u << GetSpeciesType(species, 1));
+}
+
+static const struct DailyRedSetList *FindSetList(u16 species, u8 kind)
+{
+    u32 i;
+    for (i = 0; i < gDailyRedNumSetLists; i++)
+    {
+        if (gDailyRedSetLists[i].species == species && gDailyRedSetLists[i].kind == kind)
+            return &gDailyRedSetLists[i];
+    }
+    // Every species has a NORMAL list (the generator makes sure of that).
+    for (i = 0; i < gDailyRedNumSetLists; i++)
+    {
+        if (gDailyRedSetLists[i].species == species && gDailyRedSetLists[i].kind == DAILYRED_SETS_NORMAL)
+            return &gDailyRedSetLists[i];
+    }
+    errorf("Daily Red: no sets for species %d", species);
+    return &gDailyRedSetLists[0];
+}
+
+// One of a list's sets, with Showdown's odds.
+static const struct DailyRedSet *PickSet(const struct DailyRedSetList *list, u32 *rng)
+{
+    u32 i, total = 0, roll;
+    const struct DailyRedSet *sets = &gDailyRedSets[list->firstSet];
+
+    for (i = 0; i < list->numSets; i++)
+        total += sets[i].weight;
+    roll = RedRandom(rng) % total;
+    for (i = 0; i < list->numSets - 1; i++)
+    {
+        if (roll < sets[i].weight)
+            break;
+        roll -= sets[i].weight;
+    }
+    return &sets[i];
+}
+
+static void AddMember(struct RedTeam *team, const struct DailyRedSetList *list, u8 level, bool8 shiny, u32 *rng)
+{
+    struct RedMember *member = &team->members[team->count++];
+    u32 type;
+
+    member->set = PickSet(list, rng);
+    member->typeMask = GetTypeMask(list->species) | GetTypeMask(member->set->species);
+    member->baseSpecies = GET_BASE_SPECIES_ID(member->set->species);
+    member->level = level;
+    member->shiny = shiny;
+    for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+    {
+        if (member->typeMask & (1u << type))
+            team->typeCounts[type]++;
+    }
+    if (IsEeveelution(member->baseSpecies))
+        team->hasEeveelution = TRUE;
+}
+
+// Whether a species can be one of the three picks (see the rules at the top).
+static bool32 CanPick(const struct RedTeam *team, u16 species)
+{
+    u32 i, type, typeMask = GetTypeMask(species);
+    u16 baseSpecies = GET_BASE_SPECIES_ID(species);
+
+    for (i = 0; i < team->count; i++)
+    {
+        if (team->members[i].baseSpecies == baseSpecies)
+            return FALSE;
+    }
+    if (typeMask & team->picksTypeMask)
+        return FALSE;
+    for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+    {
+        if ((typeMask & (1u << type)) && team->typeCounts[type] >= MAX_TYPE_COUNT)
+            return FALSE;
+    }
+    if (team->hasEeveelution && IsEeveelution(species))
+        return FALSE;
+    return TRUE;
+}
+
+static void AddPick(struct RedTeam *team, const struct DailyRedSetList *list, u32 *rng)
+{
+    team->picksTypeMask |= GetTypeMask(list->species);
+    AddMember(team, list, LEVEL_PICK, FALSE, rng);
+}
+
+// Two of RED's own Pokemon, in a random order of sRedPool.
+static void AddPoolPicks(struct RedTeam *team, u32 *rng)
+{
+    u16 order[ARRAY_COUNT(sRedPool)];
+    u32 i, j, picked = 0;
+
+    for (i = 0; i < ARRAY_COUNT(sRedPool); i++)
+        order[i] = sRedPool[i];
+    for (i = 0; i < ARRAY_COUNT(sRedPool) - 1; i++)
+    {
+        u16 temp;
+        j = i + RedRandom(rng) % (ARRAY_COUNT(sRedPool) - i);
+        SWAP(order[i], order[j], temp);
+    }
+    for (i = 0; i < ARRAY_COUNT(sRedPool) && picked < 2; i++)
+    {
+        if (CanPick(team, order[i]))
+        {
+            AddPick(team, FindSetList(order[i], DAILYRED_SETS_NORMAL), rng);
+            picked++;
+        }
+    }
+}
+
+// One Pokemon from any generation: a random species, then a random forme of it.
+static void AddAnyPick(struct RedTeam *team, u32 *rng)
+{
+    u32 attempt, i;
+
+    for (attempt = 0; attempt < MAX_PICK_ATTEMPTS; attempt++)
+    {
+        const struct DailyRedPickGroup *group = &gDailyRedPickGroups[RedRandom(rng) % gDailyRedNumPickGroups];
+        const struct DailyRedSetList *list = &gDailyRedSetLists[gDailyRedPickLists[group->first + RedRandom(rng) % group->count]];
+        if (CanPick(team, list->species))
+        {
+            AddPick(team, list, rng);
+            return;
+        }
+    }
+    // Practically never: take the first one that fits.
+    for (i = 0; i < gDailyRedNumPickGroups; i++)
+    {
+        const struct DailyRedPickGroup *group = &gDailyRedPickGroups[i];
+        const struct DailyRedSetList *list = &gDailyRedSetLists[gDailyRedPickLists[group->first]];
+        if (CanPick(team, list->species))
+        {
+            AddPick(team, list, rng);
+            return;
+        }
+    }
+}
+
+static bool32 SetsHazards(const struct DailyRedSet *set)
+{
+    u32 i;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (IsInList(set->moves[i], sHazardMoves, ARRAY_COUNT(sHazardMoves)))
+            return TRUE;
+    }
+    return FALSE;
+}
+
+// Picks the lead among the members from firstLeadMember on (a hazard setter
+// if there is one), and the order of the others.
+static void OrderTeam(struct RedTeam *team, u8 firstLeadMember, u8 *order, u32 *rng)
+{
+    u8 candidates[PARTY_SIZE] = {0};
+    u8 count = 0, i, j, temp;
+
+    for (i = firstLeadMember; i < team->count; i++)
+    {
+        if (SetsHazards(team->members[i].set))
+            candidates[count++] = i;
+    }
+    if (count == 0)
+    {
+        for (i = firstLeadMember; i < team->count; i++)
+            candidates[count++] = i;
+    }
+    order[0] = candidates[RedRandom(rng) % count];
+    for (i = 0, j = 1; i < team->count; i++)
+    {
+        if (i != order[0])
+            order[j++] = i;
+    }
+    for (i = 1; i < team->count - 1; i++)
+    {
+        j = i + RedRandom(rng) % (team->count - i);
+        SWAP(order[i], order[j], temp);
+    }
+}
+
+static u8 GetRedGender(u16 species)
+{
+    u8 ratio = gSpeciesInfo[species].genderRatio;
+
+    if (ratio == MON_GENDERLESS || ratio == MON_MALE || ratio == MON_FEMALE)
+        return TRAINER_MON_RANDOM_GENDER; // fixed anyway
+    if (IsEeveelution(species) || IsInList(GET_BASE_SPECIES_ID(species), sFemaleSpecies, ARRAY_COUNT(sFemaleSpecies)))
+        return TRAINER_MON_FEMALE;
+    return TRAINER_MON_MALE;
+}
+
+static void CreateRedMon(struct Pokemon *mon, const struct RedMember *member, struct TrainerGenerator *trainerGen)
+{
+    const struct DailyRedSet *set = member->set;
+    struct TrainerMon trainerMon = {0};
+    u32 i, data;
+
+    trainerMon.species = set->species;
+    trainerMon.heldItem = set->item;
+    trainerMon.ability = set->ability;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        trainerMon.moves[i] = set->moves[i];
+    trainerMon.ev = set->evs;
+    trainerMon.iv = set->ivs;
+    trainerMon.lvl = member->level;
+    trainerMon.nature = set->nature;
+    trainerMon.gender = GetRedGender(set->species);
+    trainerMon.friendship = set->friendship;
+    trainerMon.isShiny = member->shiny;
+    trainerMon.ball = BALL_POKE;
+    trainerMon.teraType = set->teraType;
+    GenerateMonFromTrainerMon(mon, &trainerMon, trainerGen);
+
+    // Perfect stats: every IV counts as 31.
+    data = TRUE;
+    for (i = 0; i < NUM_STATS; i++)
+        SetMonData(mon, MON_DATA_HYPER_TRAINED_HP + i, &data);
+    // Only a Tera set Terastallizes.
+    if (set->teraType == TYPE_NONE)
+    {
+        data = TYPE_MYSTERY;
+        SetMonData(mon, MON_DATA_TERA_TYPE, &data);
+    }
+    CalculateMonStats(mon);
+}
+
+static void BuildUsualTeam(struct RedTeam *team, u32 starter, u32 legendaryRoll, u32 *rng)
+{
+    const struct RedStarter *info = &sRedStarters[starter];
+    u32 legendary;
+    u16 species;
+
+    if (legendaryRoll < MEGA_MEWTWO_ODDS)
+        legendary = LEGENDARY_MEGA_MEWTWO;
+    else if ((legendaryRoll -= MEGA_MEWTWO_ODDS) < MEW_ODDS)
+        legendary = legendaryRoll < SHINY_MEW_ODDS ? LEGENDARY_SHINY_MEW : LEGENDARY_MEW;
+    else if ((legendaryRoll -= MEW_ODDS) < DEOXYS_ODDS)
+        legendary = LEGENDARY_DEOXYS;
+    else if ((legendaryRoll -= DEOXYS_ODDS) < MEWTWO_ODDS)
+        legendary = LEGENDARY_MEWTWO;
+    else if ((legendaryRoll -= MEWTWO_ODDS) < GALARIAN_BIRD_ODDS)
+        legendary = LEGENDARY_GALARIAN_BIRD;
+    else if ((legendaryRoll -= GALARIAN_BIRD_ODDS) < JOHTO_DOG_ODDS)
+        legendary = LEGENDARY_JOHTO_DOG;
+    else
+        legendary = LEGENDARY_BIRD;
+
+    // The starter Mega Evolves, unless Mewtwo does.
+    if (legendary == LEGENDARY_MEGA_MEWTWO)
+        AddMember(team, FindSetList(info->species, DAILYRED_SETS_ZMOVE), LEVEL_STARTER, FALSE, rng);
+    else
+        AddMember(team, FindSetList(info->megas[RedRandom(rng) % 2], DAILYRED_SETS_MEGA), LEVEL_STARTER, FALSE, rng);
+
+    switch (legendary)
+    {
+    case LEGENDARY_MEGA_MEWTWO:
+        species = (RedRandom(rng) % 2) ? SPECIES_MEWTWO_MEGA_Y : SPECIES_MEWTWO_MEGA_X;
+        AddMember(team, FindSetList(species, DAILYRED_SETS_MEGA), LEVEL_MEWTWO, FALSE, rng);
+        break;
+    case LEGENDARY_MEWTWO:
+        AddMember(team, FindSetList(SPECIES_MEWTWO, DAILYRED_SETS_ZMOVE), LEVEL_MEWTWO, FALSE, rng);
+        break;
+    case LEGENDARY_MEW:
+    case LEGENDARY_SHINY_MEW:
+        AddMember(team, FindSetList(SPECIES_MEW, DAILYRED_SETS_ZMOVE), LEVEL_LEGENDARY, legendary == LEGENDARY_SHINY_MEW, rng);
+        break;
+    case LEGENDARY_DEOXYS:
+        species = sDeoxysFormes[RedRandom(rng) % ARRAY_COUNT(sDeoxysFormes)];
+        AddMember(team, FindSetList(species, DAILYRED_SETS_ZMOVE), LEVEL_LEGENDARY, FALSE, rng);
+        break;
+    case LEGENDARY_GALARIAN_BIRD:
+        AddMember(team, FindSetList(info->galarianBird, DAILYRED_SETS_NORMAL), LEVEL_LEGENDARY, FALSE, rng);
+        break;
+    case LEGENDARY_JOHTO_DOG:
+        AddMember(team, FindSetList(info->johtoDog, DAILYRED_SETS_ZMOVE), LEVEL_LEGENDARY, FALSE, rng);
+        break;
+    default:
+        AddMember(team, FindSetList(info->bird, DAILYRED_SETS_ZMOVE), LEVEL_LEGENDARY, FALSE, rng);
+        break;
+    }
+
+    // Members from here on can lead.
+    AddMember(team, FindSetList(SPECIES_PIKACHU, DAILYRED_SETS_NORMAL), LEVEL_PIKACHU, FALSE, rng);
+    AddPoolPicks(team, rng);
+    AddAnyPick(team, rng);
+}
+
+static void BuildOriginalTeam(struct RedTeam *team, u32 *rng)
+{
+    const u8 *gimmicks = sGimmickOrders[RedRandom(rng) % ARRAY_COUNT(sGimmickOrders)];
+    u32 i;
+
+    for (i = 0; i < NUM_STARTERS; i++)
+    {
+        const struct RedStarter *info = &sRedStarters[i];
+        u16 species = info->species;
+        if (gimmicks[i] == DAILYRED_SETS_MEGA)
+            species = info->megas[RedRandom(rng) % 2];
+        AddMember(team, FindSetList(species, gimmicks[i]), LEVEL_ORIGINAL_TEAM, FALSE, rng);
+    }
+    // Members from here on can lead.
+    AddMember(team, FindSetList(SPECIES_PIKACHU, DAILYRED_SETS_NORMAL), LEVEL_ORIGINAL_TEAM, FALSE, rng);
+    AddMember(team, FindSetList((RedRandom(rng) % 2) ? SPECIES_LAPRAS : SPECIES_ESPEON, DAILYRED_SETS_NORMAL), LEVEL_ORIGINAL_TEAM, FALSE, rng);
+    AddMember(team, FindSetList(SPECIES_SNORLAX, DAILYRED_SETS_NORMAL), LEVEL_ORIGINAL_TEAM, FALSE, rng);
+}
+
+void DailyRed_GenerateRedTeam(u32 *rng)
+{
+    struct RedTeam team = {0};
+    struct TrainerGenerator trainerGen;
+    u8 order[PARTY_SIZE];
+    u32 i;
+
+    // Always the first three draws, in this order (see the top of the file).
+    bool32 originalTeam = RedRandom(rng) % 100 < ORIGINAL_TEAM_ODDS;
+    u32 starter = RedRandom(rng) % NUM_STARTERS;
+    u32 legendaryRoll = RedRandom(rng) % 100;
+
+    if (originalTeam)
+        BuildOriginalTeam(&team, rng);
+    else
+        BuildUsualTeam(&team, starter, legendaryRoll, rng);
+
+    // The starter and the legendary (or the three starters) never lead.
+    OrderTeam(&team, originalTeam ? NUM_STARTERS : 2, order, rng);
+
+    MakeTrainerGenerator(&trainerGen, GetTrainerStructFromId(TRAINER_DAILYRED_RED));
+    trainerGen.localRngState = LocalRandomSeed(RedRandom32(rng));
+    ZeroPartyMons(gDailyRedRedParty);
+    for (i = 0; i < team.count; i++)
+        CreateRedMon(&gDailyRedRedParty[i], &team.members[order[i]], &trainerGen);
+}
+
+// Called from CreateNPCTrainerParty (battle_setup.c) for TRAINER_DAILYRED_RED.
+void DailyRed_CreateRedParty(struct Pokemon *party)
+{
+    u32 i;
+    for (i = 0; i < PARTY_SIZE; i++)
+        party[i] = gDailyRedRedParty[i];
+}
