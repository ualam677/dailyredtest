+// The page's panel, its windows and which sprites show.
+static void ShowPage(void)
+{
+    u32 page = sSummary->page;
+    u32 windowsPage = page == PAGE_MOVE_INFO ? PAGE_MOVES : page;
+    bool32 moveInfo = page == PAGE_MOVE_INFO;
+    s32 status = GetStatusIcon(CurMon());
+
+    for (u32 i = WIN_PAGE_A; i <= WIN_PAGE_C; i++)
+    {
+        if (sSummary->windows[i] != WINDOW_NONE)
+        {
+            ClearWindowTilemap(sSummary->windows[i]);
+            RemoveWindow(sSummary->windows[i]);
+            sSummary->windows[i] = WINDOW_NONE;
+        }
+    }
+    FillBgTilemapBufferRect_Palette0(BG_TEXT, 0, 0, 2, 32, 18);
+    for (u32 i = 0; i < 3; i++)
+    {
+        if (sPageWindows[windowsPage][i].width != 0)
+        {
+            sSummary->windows[WIN_PAGE_A + i] = AddWindow(&sPageWindows[windowsPage][i]);
+            FillWindowPixelBuffer(sSummary->windows[WIN_PAGE_A + i], PIXEL_FILL(0));
+        }
+    }
+
+    switch (page)
+    {
+    case PAGE_INFO:
+        LoadBgTilemap(BG_PAGE, sMap_Info, sizeof(sMap_Info), PAGE_MAP_OFFSET);
+        HideBg(BG_MOVES);
+        DrawInfoPage();
+        break;
+    case PAGE_SKILLS:
+        LoadBgTilemap(BG_PAGE, sMap_Skills, sizeof(sMap_Skills), PAGE_MAP_OFFSET);
+        HideBg(BG_MOVES);
+        DrawSkillsPage();
+        SetupHpBar();
+        SetupExpBar();
+        break;
+    case PAGE_MOVES:
+    case PAGE_MOVE_INFO:
+        LoadBgTilemap(BG_PAGE, moveInfo ? sMap_MoveInfo : sMap_KnownMoves, sizeof(sMap_KnownMoves), PAGE_MAP_OFFSET);
+        LoadBgTilemap(BG_MOVES, sMap_Moves, sizeof(sMap_Moves), 0);
+        ShowBg(BG_MOVES);
+        DrawMovesPage();
+        break;
+    }
+    DrawHeader();
+    for (u32 i = WIN_PAGE_A; i <= WIN_PAGE_C; i++)
+    {
+        if (sSummary->windows[i] != WINDOW_NONE)
+        {
+            PutWindowTilemap(sSummary->windows[i]);
+            CopyWindowToVram(sSummary->windows[i], COPYWIN_GFX);
+        }
+    }
+    CopyBgTilemapBufferToVram(BG_TEXT);
+
+    for (u32 i = 0; i < HP_BAR_TILES; i++)
+        gSprites[sSummary->hpBarSpriteIds[i]].invisible = page != PAGE_SKILLS;
+    for (u32 i = 0; i < EXP_BAR_TILES; i++)
+        gSprites[sSummary->expBarSpriteIds[i]].invisible = page != PAGE_SKILLS;
+    for (u32 i = 0; i < 2; i++)
+    {
+        gSprites[sSummary->cursorSpriteIds[i]].invisible = !moveInfo;
+        gSprites[sSummary->cursorSpriteIds[i]].y = sSummary->moveCursor * 28 + 34;
+    }
+    gSprites[sSummary->monSpriteId].invisible = moveInfo;
+    gSprites[sSummary->ballSpriteId].invisible = moveInfo;
+    gSprites[sSummary->iconSpriteId].invisible = !moveInfo;
+    gSprites[sSummary->shinySpriteId].invisible = !IsMonShiny(CurMon());
+    gSprites[sSummary->shinySpriteId].x = moveInfo ? 126 : 166;
+    gSprites[sSummary->shinySpriteId].y = moveInfo ? 20 : 50;
+    gSprites[sSummary->statusSpriteId].invisible = status < 0;
+    if (status >= 0)
+        SetSpriteFrame(sSummary->statusSpriteId, TAG_STATUS, status * 4);
+    gSprites[sSummary->statusSpriteId].x = moveInfo ? 16 : 214;
+    gSprites[sSummary->statusSpriteId].y = moveInfo ? 45 : 38;
+}
+
+static void ShowMon(bool8 playCry)
+{
+    struct Pokemon *mon = CurMon();
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u32 personality = GetMonData(mon, MON_DATA_PERSONALITY);
+    enum PokeBall ballId = ItemIdToBallId(GetMonData(mon, MON_DATA_POKEBALL));
+
+    // The expansion tags the picture's palette with the species.
+    sSummary->monSpriteId = CreateMonPicSprite(species, IsMonShiny(mon), personality, TRUE, 204, 78, 0, species);
+    gSprites[sSummary->monSpriteId].oam.priority = 0;
+    LoadBallGfx(ballId);
+    sSummary->ballSpriteId = CreateSprite(&gPokeBalls[ballId].spriteTemplate, 232, 39, 0);
+    gSprites[sSummary->ballSpriteId].callback = SpriteCallbackDummy;
+    gSprites[sSummary->ballSpriteId].oam.priority = 0;
+    LoadMonIconPalette(species);
+    sSummary->iconSpriteId = CreateMonIcon(species, SpriteCallbackDummy, 140, 28, 0, personality);
+    gSprites[sSummary->iconSpriteId].oam.priority = 0;
+    if (playCry)
+        PlayCry_Normal(species, 0);
+}
+
+static void HideMon(void)
+{
+    u16 species = GetMonData(CurMon(), MON_DATA_SPECIES);
+
+    FreeAndDestroyMonPicSprite(sSummary->monSpriteId);
+    DestroySprite(&gSprites[sSummary->ballSpriteId]);
+    FreeAndDestroyMonIconSprite(&gSprites[sSummary->iconSpriteId]);
+    FreeMonIconPalette(species);
+}
+
+static void Task_SummaryInput(u8 taskId)
+{
+    switch (sSummary->loadStep)
+    {
+    case 0:
+        InitDisplay();
+        for (u32 i = 0; i < WIN_COUNT; i++)
+            sSummary->windows[i] = WINDOW_NONE;
+        for (u32 i = WIN_TITLE; i <= WIN_NAME; i++)
+            sSummary->windows[i] = AddWindow(&sHeaderWindows[i]);
+        LoadGraphics();
+        CreateFixedSprites();
+        ShowMon(FALSE);
+        ShowPage();
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+        SetVBlankCallback(VBlankCB_Summary);
+        sSummary->loadStep++;
+        return;
+    case 1:
+        if (!gPaletteFade.active)
+        {
+            PlayCry_Normal(GetMonData(CurMon(), MON_DATA_SPECIES), 0);
+            sSummary->loadStep++;
+        }
+        return;
+    }
+
+    if (sSummary->exiting)
+    {
+        if (gPaletteFade.active)
+            return;
+        if (IsCryPlayingOrClearCrySongs())
+            StopCryAndClearCrySongs();
+        gLastViewedMonIndex = sSummary->curMon;
+        // Free the picture's 8 KB frame buffer (and its icon and palettes):
+        // leaving them made each visit leak heap until the battle couldn't
+        // reload its graphics ("out of memory" after a few summaries).
+        HideMon();
+        DestroyTask(taskId);
+        FreeAllWindowBuffers();
+        SetMainCallback2(sSummary->savedCallback);
+        FREE_AND_SET_NULL(sSummary);
+        return;
+    }
+
+    if (sSummary->page == PAGE_MOVE_INFO)
+    {
+        if (JOY_NEW(DPAD_UP | DPAD_DOWN))
+        {
+            if (JOY_NEW(DPAD_UP))
+                sSummary->moveCursor = sSummary->moveCursor == 0 ? MOVE_ROWS - 1 : sSummary->moveCursor - 1;
+            else
+                sSummary->moveCursor = sSummary->moveCursor == MOVE_ROWS - 1 ? 0 : sSummary->moveCursor + 1;
+            PlaySE(SE_SELECT);
+            ShowPage();
+        }
+        else if (JOY_NEW(B_BUTTON) || (JOY_NEW(A_BUTTON) && sSummary->moveCursor == MAX_MON_MOVES))
+        {
+            PlaySE(SE_SELECT);
+            sSummary->page = PAGE_MOVES;
+            ShowPage();
+        }
+        return;
+    }
+
+    if (JOY_NEW(DPAD_LEFT) && sSummary->page > PAGE_INFO)
+    {
+        PlaySE(SE_SELECT);
+        sSummary->page--;
+        ShowPage();
+    }
+    else if (JOY_NEW(DPAD_RIGHT) && sSummary->page < PAGE_MOVES)
+    {
+        PlaySE(SE_SELECT);
+        sSummary->page++;
+        ShowPage();
+    }
+    else if (JOY_NEW(DPAD_UP | DPAD_DOWN) && sSummary->lastIdx > 0)
+    {
+        u8 next = sSummary->curMon;
+
+        if (JOY_NEW(DPAD_UP))
+            next = next == 0 ? sSummary->lastIdx : next - 1;
+        else
+            next = next == sSummary->lastIdx ? 0 : next + 1;
+        HideMon();
+        sSummary->curMon = next;
+        ShowMon(TRUE);
+        ShowPage();
+    }
+    else if (JOY_NEW(A_BUTTON) && sSummary->page == PAGE_MOVES)
+    {
+        PlaySE(SE_SELECT);
+        sSummary->page = PAGE_MOVE_INFO;
+        sSummary->moveCursor = 0;
+        ShowPage();
+    }
+    else if (JOY_NEW(B_BUTTON) || (JOY_NEW(A_BUTTON) && sSummary->page == PAGE_INFO))
+    {
+        PlaySE(SE_SELECT);
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+        sSummary->exiting = TRUE;
+    }
+}
diff --git a/src/dailyred_team.c b/src/dailyred_team.c
new file mode 100644
index 00000000..4cdd35ad
--- /dev/null
+++ b/src/dailyred_team.c
@@ -0,0 +1,567 @@
+#include "global.h"
+#include "dailyred.h"
+#include "data.h"
+#include "item.h"
+#include "pokemon.h"
+#include "random.h"
+#include "string_util.h"
+#include "trainer_util.h"
+#include "constants/items.h"
+#include "constants/region_map_sections.h"
+#include "constants/species.h"
+#include "constants/trainers.h"
+
+// The player's team for Daily Red (see "Your team" in the project README):
+//   - A starter that counters RED's (sCounterStarters), level 100, holding its
+//     Mega Stone (Charizard X or Y), or a Firium Z for Typhlosion, which has
+//     no Mega. On RED's original-team days (he has all three Kanto starters)
+//     it's any of the nine.
+//   - Five fully evolved Pokemon in Daily Red's species scope (see
+//     DailyRed_IsSpeciesInScope), never holding a Mega Stone or Z-Crystal.
+//     LEGENDARY_TEAM_ODDS% of teams have exactly one legendary among them
+//     (never RED's legendary that day, in any forme); the rest have none.
+//   - On MIRROR_RED_ODDS% of days the team mirrors RED's instead: the starter,
+//     a shiny Pikachu (level 100, Light Ball and Volt Tackle, like his), a
+//     legendary for sure, and three more.
+//   - No species twice, at most one starter (sStarters: so the five never
+//     add a second one) and at most one Eeveelution, and the six add up to at
+//     least MIN_TEAM_BASE_STAT_TOTAL in base stats.
+//   - The team limits, like RED's (DailyRed_ItemFits and DailyRed_TypesFit):
+//     one item may be held by two of the six and every other by one at most;
+//     one type may be shared by two of the six and no other type (a Mega's
+//     types count with its base form's). A set whose item doesn't fit gives
+//     way to another of the species' sets; a species with none that fits
+//     isn't drawn.
+//   - Every Pokemon gets one of its Pokemon Showdown Random Battle sets (the
+//     table in dailyred_sets.c) with perfect stats, like RED's. The starter
+//     (and the mirror Pikachu) are level 100; the others are 94 to 99 by their
+//     Showdown tier (the list's .level): the stronger the tier, the lower.
+//   - On MEGA_SWAP_ODDS% of the days when another of the six can Mega Evolve
+//     (one of the five, or the legendary: Mewtwo, Latias, Latios...), it
+//     holds its Mega Stone and the starter a Z-Crystal instead of its own
+//     (Typhlosion keeps its Firium Z), as long as the Mega's types keep the
+//     team within the type limit.
+//   - The party order is random (the player can reorder it).
+//
+// It draws from its own RNG state (see dailyred.c), so a seed always gives the
+// same team. Its first draw is always the mirror-day roll (tests/party.mjs
+// predicts it).
+
+#define MIRROR_RED_ODDS 5 // percent of days
+#define LEGENDARY_TEAM_ODDS 20 // percent of teams
+#define MEGA_SWAP_ODDS 25 // percent of the days when another Pokemon can Mega Evolve
+
+// Minimum combined base stat total of the six. RED's original team adds up to
+// 2974 (Pikachu 320, Espeon 525, Snorlax 540, Venusaur 525, Charizard 534,
+// Blastoise 530). Raise it for stronger teams, lower it for weaker ones; 0
+// turns it off.
+#define MIN_TEAM_BASE_STAT_TOTAL 2700
+
+#define LEVEL_STARTER 100
+#define LEVEL_PIKACHU 100
+
+#define MAX_SPECIES_ATTEMPTS 4000
+#define MAX_TEAM_ATTEMPTS    200
+
+static const u16 sLegendaries[] =
+{
+    SPECIES_ARTICUNO, SPECIES_ZAPDOS, SPECIES_MOLTRES, SPECIES_MEWTWO, SPECIES_MEW,
+    SPECIES_RAIKOU, SPECIES_ENTEI, SPECIES_SUICUNE, SPECIES_LUGIA, SPECIES_HO_OH, SPECIES_CELEBI,
+    SPECIES_REGIROCK, SPECIES_REGICE, SPECIES_REGISTEEL, SPECIES_LATIAS, SPECIES_LATIOS,
+    SPECIES_KYOGRE, SPECIES_GROUDON, SPECIES_RAYQUAZA, SPECIES_JIRACHI, SPECIES_DEOXYS,
+};
+
+// RED's starter -> the three that counter it.
+struct CounterStarters
+{
+    u16 redStarter;
+    u16 counters[3];
+};
+
+static const struct CounterStarters sCounterStarters[] =
+{
+    {SPECIES_VENUSAUR,  {SPECIES_CHARIZARD, SPECIES_TYPHLOSION, SPECIES_BLAZIKEN}},
+    {SPECIES_CHARIZARD, {SPECIES_BLASTOISE, SPECIES_FERALIGATR, SPECIES_SWAMPERT}},
+    {SPECIES_BLASTOISE, {SPECIES_VENUSAUR,  SPECIES_MEGANIUM,   SPECIES_SCEPTILE}},
+};
+
+// Each starter's Mega forme(s); none for Typhlosion (it holds a Z-Crystal).
+struct StarterMega
+{
+    u16 species;
+    u16 megas[2];
+};
+
+static const struct StarterMega sStarterMegas[] =
+{
+    {SPECIES_VENUSAUR,   {SPECIES_VENUSAUR_MEGA,    SPECIES_VENUSAUR_MEGA}},
+    {SPECIES_CHARIZARD,  {SPECIES_CHARIZARD_MEGA_X, SPECIES_CHARIZARD_MEGA_Y}},
+    {SPECIES_BLASTOISE,  {SPECIES_BLASTOISE_MEGA,   SPECIES_BLASTOISE_MEGA}},
+    {SPECIES_MEGANIUM,   {SPECIES_MEGANIUM_MEGA,    SPECIES_MEGANIUM_MEGA}},
+    {SPECIES_FERALIGATR, {SPECIES_FERALIGATR_MEGA,  SPECIES_FERALIGATR_MEGA}},
+    {SPECIES_SCEPTILE,   {SPECIES_SCEPTILE_MEGA,    SPECIES_SCEPTILE_MEGA}},
+    {SPECIES_BLAZIKEN,   {SPECIES_BLAZIKEN_MEGA,    SPECIES_BLAZIKEN_MEGA}},
+    {SPECIES_SWAMPERT,   {SPECIES_SWAMPERT_MEGA,    SPECIES_SWAMPERT_MEGA}},
+};
+
+// The starters in the species scope (their final forms): a team has one.
+static const u16 sStarters[] =
+{
+    SPECIES_VENUSAUR, SPECIES_CHARIZARD, SPECIES_BLASTOISE,
+    SPECIES_MEGANIUM, SPECIES_TYPHLOSION, SPECIES_FERALIGATR,
+    SPECIES_SCEPTILE, SPECIES_BLAZIKEN, SPECIES_SWAMPERT,
+};
+
+static const u16 sEeveelutions[] =
+{
+    SPECIES_VAPOREON, SPECIES_JOLTEON, SPECIES_FLAREON, SPECIES_ESPEON,
+    SPECIES_UMBREON, SPECIES_LEAFEON, SPECIES_GLACEON, SPECIES_SYLVEON,
+};
+
+#define TeamRandom   DailyRed_Random
+#define TeamRandom32 DailyRed_Random32
+
+// Daily Red's species scope ("Generations 1-3"):
+//   - the 386 Pokemon of Generations 1-3 (national dex 1-386),
+//   - their evolutions from later generations (sLaterEvolutions),
+//   - and the Mega Evolutions of any of those.
+// Regional forms (Alolan Raichu, Galarian Ponyta, ...) are later-generation
+// Pokemon in their own right, so they and their evolutions (Sirfetch'd,
+// Obstagoon, Sneasler, Clodsire, ...) are out. tests/party.mjs rebuilds this
+// list from the ROM's evolution tables and checks it against this one.
+static const u16 sLaterEvolutions[] =
+{
+    // Generation 4
+    SPECIES_AMBIPOM, SPECIES_MISMAGIUS, SPECIES_HONCHKROW, SPECIES_WEAVILE, SPECIES_MAGNEZONE,
+    SPECIES_LICKILICKY, SPECIES_RHYPERIOR, SPECIES_TANGROWTH, SPECIES_ELECTIVIRE, SPECIES_MAGMORTAR,
+    SPECIES_TOGEKISS, SPECIES_YANMEGA, SPECIES_LEAFEON, SPECIES_GLACEON, SPECIES_GLISCOR,
+    SPECIES_MAMOSWINE, SPECIES_PORYGON_Z, SPECIES_GALLADE, SPECIES_PROBOPASS, SPECIES_DUSKNOIR,
+    SPECIES_FROSLASS, SPECIES_ROSERADE,
+    // Generation 6
+    SPECIES_SYLVEON,
+    // Generation 8 (Legends: Arceus)
+    SPECIES_KLEAVOR, SPECIES_URSALUNA, SPECIES_WYRDEER,
+    // Generation 9
+    SPECIES_ANNIHILAPE, SPECIES_FARIGIRAF, SPECIES_DUDUNSPARCE,
+};
+
+struct TeamMember
+{
+    const struct DailyRedSet *set;
+    u32 typeMask;  // its types, and its Mega forme's
+    u16 baseSpecies;
+    u8 level;
+    bool8 shiny;
+};
+
+struct Team
+{
+    struct TeamMember members[PARTY_SIZE];
+    u8 count;
+    u8 typeCounts[NUMBER_OF_MON_TYPES];
+};
+
+static bool32 IsInList(u16 value, const u16 *list, u32 count)
+{
+    u32 i;
+    for (i = 0; i < count; i++)
+    {
+        if (list[i] == value)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+// A Pokemon in its regular form that's in scope (see above).
+static bool32 IsScopeBaseSpecies(u16 species)
+{
+    if (species == SPECIES_NONE || species >= NUM_SPECIES || !IsSpeciesEnabled(species))
+        return FALSE;
+    return species <= SPECIES_DEOXYS || IsInList(species, sLaterEvolutions, ARRAY_COUNT(sLaterEvolutions));
+}
+
+bool32 DailyRed_IsSpeciesInScope(u16 species)
+{
+    if (species == SPECIES_NONE || species >= NUM_SPECIES)
+        return FALSE;
+    if (gSpeciesInfo[species].isMegaEvolution)
+        return IsScopeBaseSpecies(GET_BASE_SPECIES_ID(species));
+    return IsScopeBaseSpecies(species);
+}
+
+// Doesn't evolve into anything (in this game).
+static bool32 IsFinalStage(u16 species)
+{
+    const struct Evolution *evolutions = GetSpeciesEvolutions(species);
+    u32 i;
+
+    if (evolutions == NULL)
+        return TRUE;
+    for (i = 0; evolutions[i].method != EVOLUTIONS_END; i++)
+    {
+        if (IsSpeciesEnabled(evolutions[i].targetSpecies))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static bool32 IsLegendary(u16 species)
+{
+    return IsInList(species, sLegendaries, ARRAY_COUNT(sLegendaries));
+}
+
+// Which species may be drawn for the five: in scope in its regular form,
+// fully evolved, not legendary, and with Showdown sets.
+static bool32 IsEligibleSpecies(u16 species)
+{
+    return IsScopeBaseSpecies(species) && IsFinalStage(species) && !IsLegendary(species)
+        && DailyRed_FindSetList(species, DAILYRED_SETS_NORMAL) != NULL;
+}
+
+static u32 GetBaseStatTotal(u16 species)
+{
+    return GetSpeciesBaseHP(species) + GetSpeciesBaseAttack(species) + GetSpeciesBaseDefense(species)
+         + GetSpeciesBaseSpeed(species) + GetSpeciesBaseSpAttack(species) + GetSpeciesBaseSpDefense(species);
+}
+
+// The items the team holds so far; returns how many.
+static u32 GetTeamItems(const struct Team *team, u16 *items)
+{
+    u32 i;
+    for (i = 0; i < team->count; i++)
+        items[i] = team->members[i].set->item;
+    return team->count;
+}
+
+// Whether a Pokemon (its types: typeMask; its sets: list) can join the team.
+static bool32 CanAdd(const struct Team *team, u16 species, u32 typeMask, const struct DailyRedSetList *list)
+{
+    u16 items[PARTY_SIZE];
+    u32 i;
+    u16 baseSpecies = GET_BASE_SPECIES_ID(species);
+
+    bool32 isStarter = IsInList(baseSpecies, sStarters, ARRAY_COUNT(sStarters));
+    bool32 isEeveelution = IsInList(baseSpecies, sEeveelutions, ARRAY_COUNT(sEeveelutions));
+
+    for (i = 0; i < team->count; i++)
+    {
+        u16 member = team->members[i].baseSpecies;
+        if (member == baseSpecies)
+            return FALSE;
+        if (isStarter && IsInList(member, sStarters, ARRAY_COUNT(sStarters)))
+            return FALSE;
+        if (isEeveelution && IsInList(member, sEeveelutions, ARRAY_COUNT(sEeveelutions)))
+            return FALSE;
+    }
+    if (!DailyRed_TypesFit(team->typeCounts, typeMask))
+        return FALSE;
+    return DailyRed_HasFittingSet(list, items, GetTeamItems(team, items));
+}
+
+// Adds a Pokemon with one of the list's sets whose item fits the team (the
+// starter and the mirror Pikachu, which come first, take any set if none
+// does).
+static void AddMember(struct Team *team, const struct DailyRedSetList *list, u8 level, bool8 shiny, u32 *rng)
+{
+    u16 items[PARTY_SIZE];
+    u32 count = GetTeamItems(team, items);
+    struct TeamMember *member = &team->members[team->count++];
+    u32 type;
+
+    member->set = DailyRed_PickFittingSet(list, items, count, rng);
+    if (member->set == NULL)
+        member->set = DailyRed_PickSet(list, rng);
+    member->typeMask = DailyRed_GetTypeMask(list->species) | DailyRed_GetTypeMask(member->set->species);
+    member->baseSpecies = GET_BASE_SPECIES_ID(member->set->species);
+    member->level = level;
+    member->shiny = shiny;
+    for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+    {
+        if (member->typeMask & (1u << type))
+            team->typeCounts[type]++;
+    }
+}
+
+static void RemoveLastMember(struct Team *team)
+{
+    struct TeamMember *member = &team->members[--team->count];
+    u32 type;
+
+    for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+    {
+        if (member->typeMask & (1u << type))
+            team->typeCounts[type]--;
+    }
+}
+
+static void AddStarter(struct Team *team, u16 redStarter, u32 *rng)
+{
+    const struct DailyRedSetList *list = NULL;
+    u16 starter;
+    u32 i;
+
+    if (redStarter == SPECIES_NONE)
+    {
+        // RED has all three: any of the nine counters.
+        u32 pick = TeamRandom(rng) % (ARRAY_COUNT(sCounterStarters) * 3);
+        starter = sCounterStarters[pick / 3].counters[pick % 3];
+    }
+    else
+    {
+        starter = sCounterStarters[0].counters[0];
+        for (i = 0; i < ARRAY_COUNT(sCounterStarters); i++)
+        {
+            if (sCounterStarters[i].redStarter == redStarter)
+                starter = sCounterStarters[i].counters[TeamRandom(rng) % 3];
+        }
+    }
+
+    for (i = 0; i < ARRAY_COUNT(sStarterMegas); i++)
+    {
+        if (sStarterMegas[i].species == starter)
+            list = DailyRed_FindSetList(sStarterMegas[i].megas[TeamRandom(rng) % 2], DAILYRED_SETS_MEGA);
+    }
+    if (list == NULL)
+        list = DailyRed_FindSetList(starter, DAILYRED_SETS_ZMOVE); // Typhlosion
+    if (list == NULL)
+        list = DailyRed_FindSetList(starter, DAILYRED_SETS_NORMAL);
+    AddMember(team, list, LEVEL_STARTER, FALSE, rng);
+}
+
+// Whether RED has this legendary today (any forme: his Galarian Moltres rules
+// out Moltres). His team is built before the player's.
+static bool32 IsRedsLegendary(u16 species)
+{
+    u32 i;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (GET_BASE_SPECIES_ID(GetMonData(&gDailyRedRedParty[i], MON_DATA_SPECIES)) == GET_BASE_SPECIES_ID(species))
+            return TRUE;
+    }
+    return FALSE;
+}
+
+// A random legendary that fits the team and isn't RED's (practically always
+// the first try or two).
+static void AddLegendary(struct Team *team, u32 *rng)
+{
+    u32 attempt;
+
+    for (attempt = 0; attempt < 100; attempt++)
+    {
+        u16 species = sLegendaries[TeamRandom(rng) % ARRAY_COUNT(sLegendaries)];
+        const struct DailyRedSetList *list = DailyRed_FindSetList(species, DAILYRED_SETS_NORMAL);
+        if (list != NULL && !IsRedsLegendary(species) && CanAdd(team, species, DailyRed_GetTypeMask(species), list))
+        {
+            AddMember(team, list, list->level, FALSE, rng);
+            return;
+        }
+    }
+}
+
+// A random eligible species that fits the team.
+static bool32 AddRandomMember(struct Team *team, u32 *rng)
+{
+    u32 attempt;
+    u16 species;
+
+    for (attempt = 0; attempt < MAX_SPECIES_ATTEMPTS; attempt++)
+    {
+        species = 1 + TeamRandom(rng) % (NUM_SPECIES - 1);
+        if (IsEligibleSpecies(species) && CanAdd(team, species, DailyRed_GetTypeMask(species), DailyRed_FindSetList(species, DAILYRED_SETS_NORMAL)))
+            break;
+    }
+    // Only reachable if the rules leave almost nothing to pick.
+    if (attempt == MAX_SPECIES_ATTEMPTS)
+    {
+        for (species = 1; species < NUM_SPECIES; species++)
+        {
+            if (IsEligibleSpecies(species) && CanAdd(team, species, DailyRed_GetTypeMask(species), DailyRed_FindSetList(species, DAILYRED_SETS_NORMAL)))
+                break;
+        }
+        if (species == NUM_SPECIES)
+            return FALSE;
+    }
+    const struct DailyRedSetList *list = DailyRed_FindSetList(species, DAILYRED_SETS_NORMAL);
+    AddMember(team, list, list->level, FALSE, rng);
+    return TRUE;
+}
+
+static u32 GetTeamBaseStatTotal(const struct Team *team)
+{
+    u32 i, total = 0;
+    for (i = 0; i < team->count; i++)
+        total += GetBaseStatTotal(team->members[i].set->species);
+    return total;
+}
+
+static void BuildTeam(struct Team *team, u16 redStarter, u32 *rng)
+{
+    struct Team best;
+    u32 attempt, fixedCount, bestTotal = 0;
+
+    // Always the first draw (see the top of the file).
+    bool32 mirror = TeamRandom(rng) % 100 < MIRROR_RED_ODDS;
+
+    AddStarter(team, redStarter, rng);
+    if (mirror)
+    {
+        AddMember(team, DailyRed_FindSetList(SPECIES_PIKACHU, DAILYRED_SETS_NORMAL), LEVEL_PIKACHU, TRUE, rng);
+        AddLegendary(team, rng);
+    }
+    else if (TeamRandom(rng) % 100 < LEGENDARY_TEAM_ODDS)
+    {
+        // Decided once per team, before the minimum, so the minimum can't
+        // make legendaries more likely.
+        AddLegendary(team, rng);
+    }
+
+    // The rest, drawn again until the team meets the minimum, so every
+    // qualifying team is equally likely. In the practically impossible case
+    // that none does, the strongest one drawn is used.
+    fixedCount = team->count;
+    for (attempt = 0; attempt < MAX_TEAM_ATTEMPTS; attempt++)
+    {
+        u32 total;
+        while (team->count > fixedCount)
+            RemoveLastMember(team);
+        while (team->count < PARTY_SIZE && AddRandomMember(team, rng))
+            ;
+        total = GetTeamBaseStatTotal(team);
+        if (total >= MIN_TEAM_BASE_STAT_TOTAL)
+            return;
+        if (total > bestTotal)
+        {
+            bestTotal = total;
+            best = *team;
+        }
+    }
+    *team = best;
+}
+
+// The Mega Evolution lists (not Primal Reversion) of a species; returns how
+// many (Mewtwo and Charizard have two).
+static u32 GetMegaLists(u16 species, const struct DailyRedSetList **lists)
+{
+    u32 i, count = 0;
+
+    for (i = 0; i < gDailyRedNumSetLists && count < 2; i++)
+    {
+        const struct DailyRedSetList *list = &gDailyRedSetLists[i];
+        if (list->kind == DAILYRED_SETS_MEGA && gSpeciesInfo[list->species].isMegaEvolution
+         && GET_BASE_SPECIES_ID(list->species) == species)
+            lists[count++] = list;
+    }
+    return count;
+}
+
+// Whether the team's types (each member's typeMask, with member `swapped`
+// taking newMask instead) keep to the type limit: no type on three, one
+// shared at most.
+static bool32 TypesWithinLimit(const struct Team *team, u32 swapped, u32 newMask, u32 starterMask)
+{
+    u8 counts[NUMBER_OF_MON_TYPES] = {0};
+    u32 i, type, shared = 0;
+
+    for (i = 0; i < team->count; i++)
+    {
+        u32 mask = (i == swapped) ? newMask : (i == 0) ? starterMask : team->members[i].typeMask;
+        for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+        {
+            if (mask & (1u << type))
+                counts[type]++;
+        }
+    }
+    for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+    {
+        if (counts[type] > 2)
+            return FALSE;
+        if (counts[type] == 2)
+            shared++;
+    }
+    return shared <= 1;
+}
+
+// See MEGA_SWAP_ODDS at the top: another Pokemon Mega Evolves, the starter
+// gets a Z-Crystal.
+static void TryMegaSwap(struct Team *team, u32 *rng)
+{
+    struct TeamMember *starter = &team->members[0];
+    const struct DailyRedSetList *options[PARTY_SIZE * 2];
+    u8 optionMembers[PARTY_SIZE * 2];
+    bool32 starterMegas = (GetItemHoldEffect(starter->set->item) == HOLD_EFFECT_MEGA_STONE);
+    u32 starterMask = starterMegas ? DailyRed_GetTypeMask(starter->baseSpecies) : starter->typeMask;
+    u32 i, j, count = 0;
+
+    for (i = 1; i < team->count; i++)
+    {
+        const struct DailyRedSetList *megas[2];
+        u32 numMegas = GetMegaLists(team->members[i].baseSpecies, megas);
+        for (j = 0; j < numMegas; j++)
+        {
+            u32 mask = DailyRed_GetTypeMask(team->members[i].baseSpecies) | DailyRed_GetTypeMask(megas[j]->species);
+            if (TypesWithinLimit(team, i, mask, starterMask))
+            {
+                options[count] = megas[j];
+                optionMembers[count++] = i;
+            }
+        }
+    }
+    if (count == 0 || TeamRandom(rng) % 100 >= MEGA_SWAP_ODDS)
+        return;
+
+    i = TeamRandom(rng) % count;
+    {
+        struct TeamMember *member = &team->members[optionMembers[i]];
+        member->set = DailyRed_PickSet(options[i], rng);
+        member->typeMask = DailyRed_GetTypeMask(member->baseSpecies) | DailyRed_GetTypeMask(options[i]->species);
+        member->level = options[i]->level;
+    }
+    if (starterMegas)
+    {
+        starter->set = DailyRed_PickSet(DailyRed_FindSetList(starter->baseSpecies, DAILYRED_SETS_ZMOVE), rng);
+        starter->typeMask = starterMask;
+    }
+}
+
+void DailyRed_GenerateTeam(struct Pokemon *party, u32 *rng, u16 redStarter)
+{
+    struct Team team = {0};
+    struct TrainerGenerator trainerGen = {0};
+    u8 order[PARTY_SIZE];
+    u8 metLocation = METLOC_FATEFUL_ENCOUNTER;
+    u8 fateful = TRUE;
+    u32 i, j;
+
+    BuildTeam(&team, redStarter, rng);
+    TryMegaSwap(&team, rng);
+
+    // A random party order.
+    for (i = 0; i < team.count; i++)
+        order[i] = i;
+    for (i = 0; i + 1 < team.count; i++)
+    {
+        u8 temp;
+        j = i + TeamRandom(rng) % (team.count - i);
+        SWAP(order[i], order[j], temp);
+    }
+
+    // Owned by the player.
+    trainerGen.gender = gSaveBlock2Ptr->playerGender;
+    trainerGen.otID = OTID_STRUCT_PLAYER_ID;
+    StringCopyN(trainerGen.name, gSaveBlock2Ptr->playerName, PLAYER_NAME_LENGTH + 1);
+    trainerGen.localRngState = LocalRandomSeed(TeamRandom32(rng));
+
+    for (i = 0; i < PARTY_SIZE; i++)
+        ZeroMonData(&party[i]);
+    for (i = 0; i < team.count; i++)
+    {
+        const struct TeamMember *member = &team.members[order[i]];
+        // The usual shiny odds, except the mirror Pikachu (always shiny).
+        bool8 shiny = member->shiny || (TeamRandom(rng) < SHINY_ODDS);
+        DailyRed_CreateSetMon(&party[i], member->set, member->level, TRAINER_MON_RANDOM_GENDER, shiny, &trainerGen);
+        // Event Pokemon like Mew and Deoxys, as Daily Red's have always been.
+        SetMonData(&party[i], MON_DATA_MODERN_FATEFUL_ENCOUNTER, &fateful);
+        SetMonData(&party[i], MON_DATA_MET_LOCATION, &metLocation);
+    }
+}
