+// Daily Red: where the active printer on a window has got to in its string
+// (the next character it will draw), or NULL if none is printing there.
+const u8 *GetTextPrinterCurrentCharOnWindow(u32 windowId)
+{
+    struct TextPrinter *currentPrinter;
+
+    for (currentPrinter = sFirstTextPrinter; currentPrinter != NULL; currentPrinter = currentPrinter->nextPrinter)
+    {
+        if (currentPrinter->printerTemplate.type == WINDOW_TEXT_PRINTER
+         && currentPrinter->printerTemplate.windowId == windowId
+         && currentPrinter->active)
+            return currentPrinter->printerTemplate.currentChar;
+    }
+    return NULL;
+}
+
+// Daily Red: stops any printer still drawing on a window (before new text
+// replaces it).
+void StopTextPrintersOnWindow(u32 windowId)
+{
+    struct TextPrinter *currentPrinter;
+
+    for (currentPrinter = sFirstTextPrinter; currentPrinter != NULL; currentPrinter = currentPrinter->nextPrinter)
+    {
+        if (currentPrinter->printerTemplate.type == WINDOW_TEXT_PRINTER
+         && currentPrinter->printerTemplate.windowId == windowId)
+            currentPrinter->active = FALSE;
+    }
+}
