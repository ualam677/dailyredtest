+// partly filled one (0 to 7, as the original works them out), empty ones (0)
+// and the right cap (11).
+static void SetupHpBar(void)
+{
+    struct Pokemon *mon = CurMon();
+    u32 curHp = GetMonData(mon, MON_DATA_HP), maxHp = GetMonData(mon, MON_DATA_MAX_HP);
+    u32 palOffset = 0, whole = 2, frame;
+    u8 *ids = sSummary->hpBarSpriteIds;
+
+    // The battle HP bar's colours: yellow at half, red at a fifth.
+    if (curHp * 48 <= maxHp * 9)
+        palOffset = 2;
+    else if (curHp * 48 <= maxHp * 24)
+        palOffset = 1;
+    for (u32 i = 0; i < HP_BAR_TILES; i++)
+        gSprites[ids[i]].oam.paletteNum = IndexOfSpritePaletteTag(TAG_HP_BAR + palOffset);
+
+    if (curHp >= maxHp)
+    {
+        for (u32 i = 2; i < 8; i++)
+            SetSpriteFrame(ids[i], TAG_HP_BAR, 8);
+    }
+    else
+    {
+        u32 perTile = (maxHp * 4) / 6, left = curHp * 4;
+
+        while (left > perTile)
+        {
+            left -= perTile;
+            whole++;
+        }
+        for (u32 i = 2; i < whole; i++)
+            SetSpriteFrame(ids[i], TAG_HP_BAR, 8);
+        frame = perTile ? (left * 6) / perTile : 0;
+        SetSpriteFrame(ids[whole], TAG_HP_BAR, frame);
+        for (u32 i = whole + 1; i < 8; i++)
+            SetSpriteFrame(ids[i], TAG_HP_BAR, 0);
+    }
+    SetSpriteFrame(ids[0], TAG_HP_BAR, 9);
+    SetSpriteFrame(ids[1], TAG_HP_BAR, 10);
+    SetSpriteFrame(ids[8], TAG_HP_BAR, 11);
+}
+
+static void SetupExpBar(void)
+{
+    struct Pokemon *mon = CurMon();
+    u32 level = GetMonData(mon, MON_DATA_LEVEL);
+    u32 growth = gSpeciesInfo[GetMonData(mon, MON_DATA_SPECIES)].growthRate;
+    u8 *ids = sSummary->expBarSpriteIds;
+
+    for (u32 i = 2; i < 10; i++)
+        SetSpriteFrame(ids[i], TAG_EXP_BAR, 0);
+    if (level < MAX_LEVEL)
+    {
+        u32 total = gExperienceTables[growth][level + 1] - gExperienceTables[growth][level];
+        u32 cur = GetMonData(mon, MON_DATA_EXP) - gExperienceTables[growth][level];
+        u32 perTile = (total * 4) / 8, left = cur * 4, whole = 2;
+
+        while (left > perTile && whole < 10)
+        {
+            left -= perTile;
+            whole++;
+        }
+        for (u32 i = 2; i < whole; i++)
+            SetSpriteFrame(ids[i], TAG_EXP_BAR, 8);
+        if (whole < 10)
+            SetSpriteFrame(ids[whole], TAG_EXP_BAR, perTile ? (left * 8) / perTile : 0);
+    }
+    SetSpriteFrame(ids[0], TAG_EXP_BAR, 9);
+    SetSpriteFrame(ids[1], TAG_EXP_BAR, 10);
+    SetSpriteFrame(ids[10], TAG_EXP_BAR, 11);
+}
+
+// The status icon's picture: poisoned, paralysed, asleep, frozen, burned,
+// Pokerus, fainted; -1 for none.
+static s32 GetStatusIcon(struct Pokemon *mon)
+{
+    u32 status = GetMonData(mon, MON_DATA_STATUS);
+
+    if (GetMonData(mon, MON_DATA_HP) == 0)
+        return 6;
+    if (status & STATUS1_PSN_ANY)
+        return 0;
+    if (status & STATUS1_PARALYSIS)
+        return 1;
+    if (status & STATUS1_SLEEP)
+        return 2;
+    if (status & (STATUS1_FREEZE | STATUS1_FROSTBITE))
+        return 3;
+    if (status & STATUS1_BURN)
+        return 4;
+    if (ShouldPokemonShowActivePokerus(mon))
+        return 5;
+    return -1;
+}
