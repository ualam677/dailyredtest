diff --git a/src/dailyred.c b/src/dailyred.c
new file mode 100644
index 00000000..5fb01f8f
--- /dev/null
+++ b/src/dailyred.c
@@ -0,0 +1,249 @@
+#include "global.h"
+#include "dailyred.h"
+#include "event_data.h"
+#include "item.h"
+#include "load_save.h"
+#include "main.h"
+#include "malloc.h"
+#include "new_game.h"
+#include "overworld.h"
+#include "pokemon.h"
+#include "random.h"
+#include "save.h"
+#include "string_util.h"
+#include "gba/m4a_internal.h"
+#include "constants/items.h"
+#include "constants/maps.h"
+
+// Game flow for Daily Red: boot, starting a run and how a run ends. The team
+// rules live in dailyred_team.c and RED's in dailyred_red.c.
+
+// The website fills in this struct in the ROM image before booting it,
+// finding it by its magic bytes (web/rom-config.js), so no emulator API is
+// needed beyond "load this ROM".
+//
+// A seed of 0 means the ROM wasn't patched (for example, it's running in a
+// desktop emulator). The game then shows the normal title screen and seeds
+// itself from the frame the player presses Start.
+struct DailyRedRomConfig
+{
+    u8 magic[16];
+    u32 seed;
+    u16 wins;    // the player's record before this game, for the record message
+    u16 battles;
+    u8 daily;    // TRUE: the website's daily game (one battle, then the game ends)
+    u8 padding[3];
+};
+
+const struct DailyRedRomConfig gDailyRedRomConfig __attribute__((used, aligned(4))) =
+{
+    .magic = {'D', 'A', 'I', 'L', 'Y', 'R', 'E', 'D', '-', 'C', 'O', 'N', 'F', '-', 'V', '2'},
+};
+
+// The website reads this from the emulator's memory (web/game-link.js) to
+// learn when RED's battle starts and how it ended. It finds the struct by the
+// magic bytes followed by the seed it injected, which only this live copy in
+// RAM has.
+struct DailyRedStatus
+{
+    u8 magic[16];
+    u32 seed;
+    u8 phase;  // DAILYRED_PHASE_*
+    u8 result; // DAILYRED_RESULT_*
+    u8 padding[2];
+};
+
+enum
+{
+    DAILYRED_PHASE_EXPLORING,
+    DAILYRED_PHASE_BATTLE,   // RED's battle has started
+    DAILYRED_PHASE_RESULT,   // the battle is over and the result is set
+    DAILYRED_PHASE_FINISHED, // daily game: the closing messages are done
+};
+
+enum
+{
+    DAILYRED_RESULT_NONE,
+    DAILYRED_RESULT_WON,
+    DAILYRED_RESULT_LOST,
+};
+
+static const u8 sStatusMagic[16] = {'D', 'A', 'I', 'L', 'Y', 'R', 'E', 'D', '-', 'S', 'T', 'A', 'T', 'U', 'S', '1'};
+static EWRAM_DATA struct DailyRedStatus sStatus = {0};
+
+// Team RNGs. Seeded once per boot; each new run continues from where the
+// previous one stopped, so a seed fixes the whole sequence of teams. RED's
+// team has its own stream, so changing his rules never changes the player's
+// teams (and vice versa).
+static EWRAM_DATA rng_value_t sPlayerRng = {0};
+static EWRAM_DATA rng_value_t sRedRng = {0};
+
+// RED's team for this run, picked with the player's and created when the
+// battle starts (from sRedCreateRng, so it's the same every time).
+static EWRAM_DATA struct DailyRedPick sRedPicks[PARTY_SIZE] = {0};
+static EWRAM_DATA rng_value_t sRedCreateRng = {0};
+
+#define RED_STREAM_SALT 0x52454421 // "RED!"
+
+static const u8 sText_PlayerName[] = _("LEAF");
+static const u8 sText_RivalName[] = _("RED");
+
+// The config is read through volatile pointers: the compiler would otherwise
+// assume the values are still the zeros the ROM was built with.
+static u32 GetInjectedSeed(void)
+{
+    return *(const vu32 *)&gDailyRedRomConfig.seed;
+}
+
+static bool8 IsDailyGame(void)
+{
+    return *(const vu8 *)&gDailyRedRomConfig.daily;
+}
+
+static void InitStatus(u32 seed)
+{
+    memcpy(sStatus.magic, sStatusMagic, sizeof(sStatus.magic));
+    sStatus.seed = seed;
+    sStatus.phase = DAILYRED_PHASE_EXPLORING;
+    sStatus.result = DAILYRED_RESULT_NONE;
+}
+
+static void SeedTeams(u32 seed)
+{
+    sPlayerRng = LocalRandomSeed(seed);
+    sRedRng = LocalRandomSeed(seed ^ RED_STREAM_SALT);
+}
+
+bool8 DailyRed_HasInjectedSeed(void)
+{
+    return GetInjectedSeed() != 0;
+}
+
+// Fresh, unsaved game data every boot: LEAF, female, fast text, SET battle
+// style. CB2_NewGame then calls NewGameInitData, which calls
+// DailyRed_InitNewGame.
+static void StartNewGame(void)
+{
+    Sav2_ClearSetDefault();
+    SetPokemonCryStereo(gSaveBlock2Ptr->optionsSound);
+    gSaveBlock2Ptr->optionsTextSpeed = OPTIONS_TEXT_SPEED_FAST;
+    // No "Will LEAF change POKeMON?" when RED's Pokemon faints. The Options
+    // menu keeps this locked (option_menu.c).
+    gSaveBlock2Ptr->optionsBattleStyle = OPTIONS_BATTLE_STYLE_SET;
+    gSaveBlock2Ptr->playerGender = FEMALE; // FireRed's own female player, LEAF
+    StringCopy(gSaveBlock2Ptr->playerName, sText_PlayerName);
+    StringCopy(gSaveBlock1Ptr->rivalName, sText_RivalName);
+    SetMainCallback2(CB2_NewGame);
+}
+
+// Used instead of the intro and title screen when the website supplied a
+// seed (from the copyright screen, see intro_frlg.c).
+void CB2_DailyRed_StartFromCopyright(void)
+{
+    u32 seed = GetInjectedSeed();
+
+    // What SeedRngAndSetTrainerId does with the timer, but from the seed.
+    SeedRngAndSetTrainerIdFromSeed(seed);
+    SeedTeams(seed);
+    InitStatus(seed);
+    // No resetting out of a losing battle in the daily game. Only saving,
+    // link play and trading turn it back on, and none of those exist here.
+    if (IsDailyGame())
+        gSoftResetDisabled = TRUE;
+    SetSaveBlocksPointers(GetSaveBlocksPointersBaseOffset());
+    ResetMenuAndMonGlobals();
+    Save_ResetSaveCounters();
+    LoadGameSave(SAVE_NORMAL);
+    InitHeap(gHeap, HEAP_SIZE);
+    StartNewGame();
+}
+
+// Used instead of the main menu when there's no injected seed: seeds the game
+// from the frame the player pressed Start on the title screen.
+void CB2_DailyRed_StartFromTitle(void)
+{
+    SeedRngAndSetTrainerId();
+    SeedTeams(Random32());
+    InitStatus(0);
+    StartNewGame();
+}
+
+static void GenerateTeams(void)
+{
+    struct DailyRedPick picks[PARTY_SIZE];
+    u32 i;
+
+    DailyRed_PickPlayerTeam(picks, &sPlayerRng);
+    ZeroPlayerPartyMons();
+    for (i = 0; i < PARTY_SIZE; i++)
+        DailyRed_CreateMonFromSet(&gParties[B_TRAINER_PLAYER][i], &picks[i], TRUE, &sPlayerRng);
+    CalculatePlayerPartyCount();
+
+    DailyRed_PickRedTeam(sRedPicks, &sRedRng);
+    sRedCreateRng = sRedRng;
+    LocalRandom32(&sRedRng); // the next run's team starts somewhere else
+}
+
+// Called from NewGameInitData in place of warping to the player's bedroom.
+void DailyRed_InitNewGame(void)
+{
+    FlagSet(FLAG_SYS_POKEMON_GET); // shows POKeMON in the start menu
+    FlagSet(FLAG_SYS_B_DASH);      // running shoes (B) for the climb
+    FlagSet(FLAG_BADGE08_GET);     // level 100 Pokemon obey (in Gen 8+ rules, even your own)
+    EnableNationalPokedex();       // national dex numbers in the summary
+    // Showdown teams can Mega Evolve and use Z-Moves; the player needs the
+    // items for that.
+    AddBagItem(ITEM_MEGA_RING, 1);
+    AddBagItem(ITEM_Z_POWER_RING, 1);
+    // Start the record from the website's saved stats (0 outside the website).
+    VarSet(VAR_DAILYRED_WINS, *(const vu16 *)&gDailyRedRomConfig.wins);
+    VarSet(VAR_DAILYRED_BATTLES, *(const vu16 *)&gDailyRedRomConfig.battles);
+    GenerateTeams();
+    SetWarpDestination(MAP_GROUP(MAP_DAILYRED_MT_SILVER), MAP_NUM(MAP_DAILYRED_MT_SILVER), WARP_ID_NONE, DAILYRED_START_X, DAILYRED_START_Y);
+    WarpIntoMap();
+}
+
+// Called from CreateNPCTrainerParty when RED's battle starts.
+void DailyRed_CreateRedParty(struct Pokemon *party)
+{
+    rng_value_t rng = sRedCreateRng;
+    u32 i;
+
+    ZeroPartyMons(party);
+    for (i = 0; i < PARTY_SIZE; i++)
+        DailyRed_CreateMonFromSet(&party[i], &sRedPicks[i], FALSE, &rng);
+}
+
+// Special: replaces both teams after a battle (when not playing the daily
+// game). The map script then warps back to the start position, which also
+// resets RED.
+void DailyRed_StartNextRun(void)
+{
+    GenerateTeams();
+    sStatus.phase = DAILYRED_PHASE_EXPLORING;
+    sStatus.result = DAILYRED_RESULT_NONE;
+}
+
+// Specials the map script calls so the website can follow the battle.
+void DailyRed_OnBattleStart(void)
+{
+    sStatus.phase = DAILYRED_PHASE_BATTLE;
+}
+
+// Call right after the battle, while VAR_RESULT is TRUE if the player lost.
+void DailyRed_OnBattleEnd(void)
+{
+    sStatus.result = gSpecialVar_Result ? DAILYRED_RESULT_LOST : DAILYRED_RESULT_WON;
+    sStatus.phase = DAILYRED_PHASE_RESULT;
+}
+
+void DailyRed_OnDailyGameOver(void)
+{
+    sStatus.phase = DAILYRED_PHASE_FINISHED;
+}
+
+// Specialvar: TRUE in the website's daily game, which ends after one battle.
+u16 DailyRed_IsDailyGame(void)
+{
+    return IsDailyGame();
+}
diff --git a/src/dailyred_red.c b/src/dailyred_red.c
new file mode 100644
index 00000000..7f9a0d15
--- /dev/null
+++ b/src/dailyred_red.c
@@ -0,0 +1,142 @@
+#include "global.h"
+#include "dailyred.h"
+#include "random.h"
+#include "constants/species.h"
+
+// RED's team. This file is the one place to edit it.
+//
+// Every run he brings six level 100 Pokemon with Showdown Gen 7 Random Battle
+// sets (gDailyRedSets), built from his Pokemon Adventures and Mt. Silver teams:
+//
+//   - Pikachu, always.
+//   - One Mega Evolving Kanto starter: Venusaur, Charizard (X or Y) or
+//     Blastoise, holding its Mega Stone.
+//   - One legendary: Mewtwo, Deoxys (any forme), Articuno, Zapdos or Moltres.
+//   - Three more from sPool, which can't all share a type (two of them may).
+//   - He leads with Pikachu or one of those three; the rest come in a random
+//     order.
+//
+// Sets follow Showdown's team rules too: the starter is his only Mega, and at
+// most one of the others is a Z-Move user. The battle (name, class, sprite,
+// AI) is TRAINER_DAILYRED_RED in src/data/trainers_frlg.party.
+
+static const u16 sPool[] =
+{
+    // HeartGold/SoulSilver
+    SPECIES_ESPEON,
+    SPECIES_SNORLAX,
+    // Pokemon Adventures
+    SPECIES_POLIWRATH,
+    SPECIES_GYARADOS,
+    SPECIES_AERODACTYL,
+    SPECIES_LAPRAS,
+    SPECIES_JOLTEON,
+    SPECIES_FLAREON,
+    SPECIES_VAPOREON,
+    SPECIES_HITMONLEE,
+    SPECIES_KABUTOPS,
+    SPECIES_VICTREEBEL,
+    SPECIES_MACHAMP,
+    SPECIES_ARCANINE,
+    SPECIES_GENGAR,
+};
+
+// Each row is one choice; a row with several formes picks one of them.
+static const u16 sStarters[][2] =
+{
+    {SPECIES_VENUSAUR_MEGA},
+    {SPECIES_CHARIZARD_MEGA_X, SPECIES_CHARIZARD_MEGA_Y},
+    {SPECIES_BLASTOISE_MEGA},
+};
+
+static const u16 sLegendaries[][4] =
+{
+    {SPECIES_MEWTWO},
+    {SPECIES_DEOXYS_NORMAL, SPECIES_DEOXYS_ATTACK, SPECIES_DEOXYS_DEFENSE, SPECIES_DEOXYS_SPEED},
+    {SPECIES_ARTICUNO},
+    {SPECIES_ZAPDOS},
+    {SPECIES_MOLTRES},
+};
+
+#define NUM_POOL_PICKS 3
+
+static u32 RandomBelow(rng_value_t *rng, u32 n)
+{
+    return n == 0 ? 0 : ((u64)LocalRandom32(rng) * n) >> 32;
+}
+
+static u16 Forme(u16 species)
+{
+    s32 forme = DailyRed_FindForme(species);
+
+    return forme < 0 ? 0 : forme; // every species above is in the table (checked by the tests)
+}
+
+// A random entry of a row, ignoring its unused (SPECIES_NONE) slots.
+static u16 PickFromRow(const u16 *row, u32 rowLength, rng_value_t *rng)
+{
+    u32 count = 0;
+
+    while (count < rowLength && row[count] != SPECIES_NONE)
+        count++;
+    return row[RandomBelow(rng, count)];
+}
+
+void DailyRed_PickRedTeam(struct DailyRedPick *picks, rng_value_t *rng)
+{
+    u16 formes[PARTY_SIZE];
+    u16 order[PARTY_SIZE];
+    u16 pool[ARRAY_COUNT(sPool)];
+    u32 i, j, temp, teamFlags = 0;
+    bool32 zUsed = FALSE;
+    u16 setId;
+
+    // Three from the pool that don't all share a type: a partial shuffle of
+    // the pool, redrawn until the rule holds, so every allowed trio is
+    // equally likely.
+    do
+    {
+        for (i = 0; i < ARRAY_COUNT(sPool); i++)
+            pool[i] = sPool[i];
+        for (i = 0; i < NUM_POOL_PICKS; i++)
+        {
+            j = i + RandomBelow(rng, ARRAY_COUNT(sPool) - i);
+            SWAP(pool[i], pool[j], temp);
+        }
+    } while (gDailyRedFormes[Forme(pool[0])].types
+           & gDailyRedFormes[Forme(pool[1])].types
+           & gDailyRedFormes[Forme(pool[2])].types);
+
+    // Slots 0-3 can lead (Pikachu and the three), 4-5 can't.
+    formes[0] = Forme(SPECIES_PIKACHU);
+    for (i = 0; i < NUM_POOL_PICKS; i++)
+        formes[1 + i] = Forme(pool[i]);
+    i = RandomBelow(rng, ARRAY_COUNT(sStarters));
+    formes[4] = Forme(PickFromRow(sStarters[i], ARRAY_COUNT(sStarters[i]), rng));
+    i = RandomBelow(rng, ARRAY_COUNT(sLegendaries));
+    formes[5] = Forme(PickFromRow(sLegendaries[i], ARRAY_COUNT(sLegendaries[i]), rng));
+
+    // The lead, then the other five in a random order.
+    for (i = 0; i < PARTY_SIZE; i++)
+        order[i] = i;
+    j = RandomBelow(rng, 1 + NUM_POOL_PICKS);
+    SWAP(order[0], order[j], temp);
+    for (i = 1; i < PARTY_SIZE - 1; i++)
+    {
+        j = i + RandomBelow(rng, PARTY_SIZE - i);
+        SWAP(order[i], order[j], temp);
+    }
+
+    // Sets, in party order: once one is a Z-Move user, the rest can't be.
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        picks[i].forme = formes[order[i]];
+        setId = DailyRed_PickSet(picks[i].forme, zUsed, teamFlags & DAILYRED_SET_ONE_PER_TEAM, rng);
+        if (setId == DAILYRED_NO_SET) // only Z-Move sets left: allow a second one rather than none
+            setId = DailyRed_PickSet(picks[i].forme, FALSE, 0, rng);
+        picks[i].set = setId;
+        if (gDailyRedSets[setId].flags & DAILYRED_SET_ZMOVE)
+            zUsed = TRUE;
+        teamFlags |= gDailyRedSets[setId].flags;
+    }
+}
diff --git a/src/dailyred_sets.c b/src/dailyred_sets.c
new file mode 100644
index 00000000..777e2e5b
--- /dev/null
+++ b/src/dailyred_sets.c
@@ -0,0 +1,6184 @@
+// Generated by scripts/sets/generate.mjs. Don't edit by hand: change the
+// script's options and run it again.
+//
+// Source: Pokémon Showdown 0.11.11 (MIT license), format gen7randombattle:
+// 600 randomSet() calls per forme with and without a Z-Move user on the team,
+// sets under 1% in both dropped, at most 24 per forme.
+// 3946 sets, 574 formes, 449 species.
+//
+// Type masks: bit i is 0 Bug, 1 Dark, 2 Dragon, 3 Electric, 4 Fairy, 5 Fighting, 6 Fire, 7 Flying, 8 Ghost, 9 Grass, 10 Ground, 11 Ice, 12 Normal, 13 Poison, 14 Psychic, 15 Rock, 16 Steel, 17 Water.
+
+#include "global.h"
+#include "dailyred.h"
+#include "constants/abilities.h"
+#include "constants/items.h"
+#include "constants/moves.h"
+#include "constants/species.h"
+
+const u8 gDailyRedNumTypes = 18;
+const u16 gDailyRedNumSets = 3946;
+const u16 gDailyRedNumFormes = 574;
+const u16 gDailyRedNumGroups = 449;
+
+// One line per set: species, item, ability, moves, flags, EVs and IVs
+// (HP/Atk/Def/SpA/SpD/Spe), stats maxed with Bottle Caps, friendship, and its
+// weight while the team has no Z-Move user / once it has one.
+#define SET(sp, it, ab, m1, m2, m3, m4, fl, evs_, ivs_, ht, fr, wOpen, wClosed) \
+    {.species = SPECIES_##sp, .item = ITEM_##it, .ability = ABILITY_##ab, \
+     .moves = {MOVE_##m1, MOVE_##m2, MOVE_##m3, MOVE_##m4}, .flags = (fl), \
+     .evs = evs_, .ivs = ivs_, .hyperTrained = ht, .friendship = fr, .weightOpen = wOpen, .weightClosed = wClosed}
+#define STATS(hp, atk, def, spa, spd, spe) {hp, atk, def, spa, spd, spe}
+#define MEGA DAILYRED_SET_MEGA
+#define ZMOVE DAILYRED_SET_ZMOVE
+#define STEALTH_ROCK DAILYRED_SET_STEALTH_ROCK
+#define SPIKES DAILYRED_SET_SPIKES
+#define TOXIC_SPIKES DAILYRED_SET_TOXIC_SPIKES
+#define STICKY_WEB DAILYRED_SET_STICKY_WEB
+#define HAZARD_CLEAR DAILYRED_SET_HAZARD_CLEAR
+#define SCREENS DAILYRED_SET_SCREENS
+#define STATUS_CURE DAILYRED_SET_STATUS_CURE
+#define ILLUSION DAILYRED_SET_ILLUSION
+#define FIRE_ABILITY DAILYRED_SET_FIRE_ABILITY
+
+const struct DailyRedSet gDailyRedSets[] =
+{
+    // Venusaur (Showdown level 84)
+    SET(VENUSAUR, BLACK_SLUDGE, CHLOROPHYLL, LEECH_SEED, SLEEP_POWDER, SLUDGE_BOMB, SUBSTITUTE, 0, STATS(85, 0, 85, 85, 85, 85), STATS(31, 0, 31, 31, 31, 31), 0, 255, 67, 72), // Staller, 27% / 29%
+    SET(VENUSAUR, BLACK_SLUDGE, OVERGROW, GIGA_DRAIN, LEECH_SEED, SLUDGE_BOMB, SUBSTITUTE, 0, STATS(85, 0, 85, 85, 85, 85), STATS(31, 0, 31, 31, 31, 31), 0, 255, 61, 64), // Staller, 24% / 26%
+    SET(VENUSAUR, BLACK_SLUDGE, OVERGROW, EARTHQUAKE, ENERGY_BALL, SLUDGE_BOMB, SYNTHESIS, 0, STATS(85, 85, 85, 85, 85, 85), STATS(31, 31, 31, 31, 31, 31), 0, 255, 31, 27), // Bulky Attacker, 12% / 11%
+    SET(VENUSAUR, BLACK_SLUDGE, OVERGROW, ENERGY_BALL, KNOCK_OFF, SLUDGE_BOMB, SYNTHESIS, 0, STATS(85, 85, 85, 85, 85, 85), STATS(31, 31, 31, 31, 31, 31), 0, 255, 27, 26), // Bulky Attacker, 11% / 11%
+    SET(VENUSAUR, BLACK_SLUDGE, CHLOROPHYLL, EARTHQUAKE, KNOCK_OFF, SLUDGE_BOMB, SYNTHESIS, 0, STATS(85, 85, 85, 85, 85, 85), STATS(31, 31, 31, 31, 31, 31), 0, 255, 28, 25), // Bulky Attacker, 11% / 10%
+    SET(VENUSAUR, BLACK_SLUDGE, CHLOROPHYLL, EARTHQUAKE, SLEEP_POWDER, SLUDGE_BOMB, SYNTHESIS, 0, STATS(85, 85, 85, 85, 85, 85), STATS(31, 31, 31, 31, 31, 31), 0, 255, 18, 10), // Bulky Attacker, 7% / 4%
+    SET(VENUSAUR, BLACK_SLUDGE, CHLOROPHYLL, KNOCK_OFF, SLEEP_POWDER, SLUDGE_BOMB, SYNTHESIS, 0, STATS(85, 85, 85, 85, 85, 85), STATS(31, 31, 31, 31, 31, 31), 0, 255, 10, 14), // Bulky Attacker, 4% / 6%
+    SET(VENUSAUR, BLACK_SLUDGE, OVERGROW, ENERGY_BALL, SLEEP_POWDER, SLUDGE_BOMB, SYNTHESIS, 0, STATS(85, 0, 85, 85, 85, 85), STATS(31, 0, 31, 31, 31, 31), 0, 255, 10, 12), // Bulky Attacker, 4% / 5%
