+// The move name's start in the printed message (its last occurrence: the
+// attacker's name comes first), or NULL.
+static const u8 *FindMoveName(const u8 *text, const u8 *name)
+{
+    const u8 *found = NULL;
+    u32 len = StringLength(name);
+
+    if (len == 0)
+        return NULL;
+    for (; *text != EOS; text++)
+    {
+        if (memcmp(text, name, len) == 0)
+            found = text;
+    }
+    return found;
+}
+
+// The start of the message's last word (after its last space or line break).
+static const u8 *FindLastWord(const u8 *text)
+{
+    const u8 *word = text;
+
+    for (; *text != EOS; text++)
+    {
+        if ((*text == CHAR_SPACE || *text == CHAR_NEWLINE || *text == CHAR_PROMPT_SCROLL || *text == CHAR_PROMPT_CLEAR) && text[1] != EOS)
+            word = text + 1;
+    }
+    return word;
