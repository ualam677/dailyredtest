+static void CB2_Summary(void)
+{
+    RunTasks();
+    AnimateSprites();
+    BuildOamBuffer();
+    UpdatePaletteFade();
+    ChangeBgX(BG_GRID, 80, BG_COORD_ADD);
+    ChangeBgY(BG_GRID, 80, BG_COORD_ADD);
+}
+
+static void VBlankCB_Summary(void)
+{
+    LoadOam();
+    ProcessSpriteCopyRequests();
+    TransferPlttBuffer();
+}
