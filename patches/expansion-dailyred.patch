+void DailyRed_ShowSummary(struct Pokemon *mons, u8 monIndex, u8 maxMonIndex, void (*callback)(void))
+{
+    sSummary = AllocZeroed(sizeof(*sSummary));
+    sSummary->mons = mons;
+    sSummary->curMon = monIndex;
+    sSummary->lastIdx = maxMonIndex;
+    sSummary->savedCallback = callback;
+    sSummary->page = PAGE_INFO;
+    SetMainCallback2(CB2_Summary);
+    CreateTask(Task_SummaryInput, 0);
+}
+
+static void InitDisplay(void)
+{
+    SetVBlankCallback(NULL);
+    SetHBlankCallback(NULL);
+    ResetSpriteData();
+    ResetPaletteFade();
+    FreeAllSpritePalettes();
+    ScanlineEffect_Stop();
+    DmaClearLarge16(3, (void *)VRAM, VRAM_SIZE, 0x1000);
+    DmaClear32(3, (void *)OAM, OAM_SIZE);
+    DmaClear16(3, (void *)PLTT, PLTT_SIZE);
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    ResetBgsAndClearDma3BusyFlags(0);
+    InitBgsFromTemplates(0, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+    for (u32 bg = 0; bg < 4; bg++)
+    {
+        ChangeBgX(bg, 0, BG_COORD_SET);
+        ChangeBgY(bg, 0, BG_COORD_SET);
+    }
+    SetBgTilemapBuffer(BG_TEXT, sSummary->textTilemap);
+    InitWindows((const struct WindowTemplate[]){DUMMY_WIN_TEMPLATE});
+    DeactivateAllTextPrinters();
+    // The page's panel is see-through over the grid.
+    SetGpuReg(REG_OFFSET_BLDCNT, BLDCNT_EFFECT_BLEND | BLDCNT_TGT1_BG1 | BLDCNT_TGT2_BG2);
+    SetGpuReg(REG_OFFSET_BLDALPHA, BLDALPHA_BLEND(13, 16));
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_OBJ_1D_MAP | DISPCNT_OBJ_ON);
+    ShowBg(BG_TEXT);
+    ShowBg(BG_PAGE);
+    ShowBg(BG_GRID);
+}
