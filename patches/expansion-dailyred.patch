+static void PrintRightAligned(u8 windowId, const u8 *str, u32 right, u32 y, const u8 *color)
+{
+    AddTextPrinterParameterized3(windowId, FONT_NORMAL, right - GetStringWidth(FONT_NORMAL, str, 0), y, color, TEXT_SKIP_DRAW, str);
+}
+
+// Prints str's lines (split at newlines) `spacing` pixels apart.
+static void PrintLines(u8 windowId, u32 fontId, u32 x, u32 y, u32 spacing, const u8 *color, const u8 *str)
+{
+    u8 *line = gStringVar4, *p;
+
+    if (str != gStringVar4)
+        StringCopy(gStringVar4, str);
+    for (p = line; ; p++)
+    {
+        bool32 end = (*p == EOS);
+
+        if (*p == CHAR_NEWLINE || end)
+        {
+            *p = EOS;
+            AddTextPrinterParameterized3(windowId, fontId, x, y, color, TEXT_SKIP_DRAW, line);
+            if (end)
+                break;
+            line = p + 1;
+            y += spacing;
+        }
+    }
+}
+
+// Copies str to gStringVar4 with its lines rewrapped to fit `width`; returns
+// how many lines that makes.
+static u32 WrapText(const u8 *str, u32 fontId, u32 width)
+{
+    u8 *lineStart = gStringVar4, *lastSpace = NULL, *p;
+    u32 lines = 1;
+
+    StringCopy(gStringVar4, str);
+    for (p = gStringVar4; ; p++)
+    {
+        u8 c = *p;
+
+        if (c == CHAR_NEWLINE)
+            c = *p = CHAR_SPACE;
+        if (c == CHAR_SPACE || c == EOS)
+        {
+            *p = EOS;
+            if (GetStringWidth(fontId, lineStart, 0) > width && lastSpace != NULL)
+            {
+                *lastSpace = CHAR_NEWLINE;
+                lineStart = lastSpace + 1;
+                lines++;
+            }
+            *p = c;
+            if (c == EOS)
+                break;
+            lastSpace = p;
+        }
+    }
+    return lines;
+}
