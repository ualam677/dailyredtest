diff --git a/data/maps/DailyRed_MtSilver/scripts.inc b/data/maps/DailyRed_MtSilver/scripts.inc
new file mode 100644
index 00000000..e962d547
--- /dev/null
+++ b/data/maps/DailyRed_MtSilver/scripts.inc
@@ -0,0 +1,111 @@
+DailyRed_MtSilver_MapScripts::
+	.byte 0
+
+@ Talking to RED starts the battle. trainerbattle_earlyrival with
+@ RIVAL_BATTLE_HEAL_AFTER lets the player lose without whiting out, and sets
+@ VAR_RESULT to TRUE if they lost. The DailyRed_On* specials tell the website
+@ how the battle is going (see src/dailyred.c).
+DailyRed_MtSilver_EventScript_Red::
+	lock
+	faceplayer
+	textcolor NPC_TEXT_COLOR_MALE
+	msgbox DailyRed_MtSilver_Text_RedIntro
+	special DailyRed_OnBattleStart
+	trainerbattle_earlyrival TRAINER_DAILYRED_RED, RIVAL_BATTLE_HEAL_AFTER, DailyRed_MtSilver_Text_RedDefeat, DailyRed_MtSilver_Text_RedVictory
+	special DailyRed_OnBattleEnd
+	addvar VAR_DAILYRED_BATTLES, 1
+	textcolor NPC_TEXT_COLOR_NEUTRAL
+	goto_if_eq VAR_RESULT, TRUE, DailyRed_MtSilver_EventScript_PlayerLost
+	addvar VAR_DAILYRED_WINS, 1
+	playfanfare MUS_OBTAIN_BADGE
+	message DailyRed_MtSilver_Text_PlayerWon
+	waitmessage
+	waitfanfare
+	waitbuttonpress
+	call DailyRed_MtSilver_EventScript_BufferRecord
+	specialvar VAR_RESULT, DailyRed_IsDailyGame
+	goto_if_eq VAR_RESULT, TRUE, DailyRed_MtSilver_EventScript_DailyWin
+	goto DailyRed_MtSilver_EventScript_NextRun
+	end
+
+DailyRed_MtSilver_EventScript_PlayerLost::
+	msgbox DailyRed_MtSilver_Text_PlayerLost
+	call DailyRed_MtSilver_EventScript_BufferRecord
+	specialvar VAR_RESULT, DailyRed_IsDailyGame
+	goto_if_eq VAR_RESULT, TRUE, DailyRed_MtSilver_EventScript_DailyLoss
+	goto DailyRed_MtSilver_EventScript_NextRun
+	end
+
+DailyRed_MtSilver_EventScript_BufferRecord::
+	buffernumberstring STR_VAR_1, VAR_DAILYRED_WINS
+	buffernumberstring STR_VAR_2, VAR_DAILYRED_BATTLES
+	return
+
+@ The website's daily game: one battle a day. After the record the screen
+@ fades out and the website closes the game.
+DailyRed_MtSilver_EventScript_DailyWin::
+	msgbox DailyRed_MtSilver_Text_RecordWin
+	goto DailyRed_MtSilver_EventScript_DailyGameOver
+	end
+
+DailyRed_MtSilver_EventScript_DailyLoss::
+	msgbox DailyRed_MtSilver_Text_RecordLoss
+	goto DailyRed_MtSilver_EventScript_DailyGameOver
+	end
+
+DailyRed_MtSilver_EventScript_DailyGameOver::
+	closemessage
+	fadescreen FADE_TO_BLACK
+	special DailyRed_OnDailyGameOver
+	@ Keep the script running so the player can't move or talk to RED again
+	@ before the website closes the game.
+DailyRed_MtSilver_EventScript_DailyGameOverHold::
+	delay 60
+	goto DailyRed_MtSilver_EventScript_DailyGameOverHold
+	end
+
+@ Anywhere else (practice runs, desktop emulators): straight into a new run.
+DailyRed_MtSilver_EventScript_NextRun::
+	msgbox DailyRed_MtSilver_Text_NextRun
+	closemessage
+	fadescreen FADE_TO_BLACK
+	special DailyRed_StartNextRun
+	@ Re-entering the map puts the player back at the start and resets RED.
+	warpsilent MAP_DAILYRED_MT_SILVER, DAILYRED_START_X, DAILYRED_START_Y
+	waitstate
+	release
+	end
+
+DailyRed_MtSilver_Text_RedIntro::
+	.string "…\p"
+	.string "…………$"
+
+@ Shown in battle when RED loses.
+DailyRed_MtSilver_Text_RedDefeat::
+	.string "…$"
+
+@ Shown in battle when RED wins.
+DailyRed_MtSilver_Text_RedVictory::
+	.string "…$"
+
+DailyRed_MtSilver_Text_PlayerWon::
+	.string "You defeated RED!$"
+
+DailyRed_MtSilver_Text_PlayerLost::
+	.string "Your team was wiped out…$"
+
+DailyRed_MtSilver_Text_RecordWin::
+	.string "Record: {STR_VAR_1} win(s) in\n"
+	.string "{STR_VAR_2} battle(s).\p"
+	.string "Play again tomorrow!$"
+
+DailyRed_MtSilver_Text_RecordLoss::
+	.string "Record: {STR_VAR_1} win(s) in\n"
+	.string "{STR_VAR_2} battle(s).\p"
+	.string "Try again tomorrow.$"
+
+DailyRed_MtSilver_Text_NextRun::
+	.string "Record: {STR_VAR_1} win(s) in\n"
+	.string "{STR_VAR_2} battle(s).\p"
+	.string "New teams of six are ready.\n"
+	.string "Climb back up and face RED!$"
