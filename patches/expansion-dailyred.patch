+static void DrawSkillsPage(void)
+{
+    struct Pokemon *mon = CurMon();
+    u8 a = sSummary->windows[WIN_PAGE_A], c = sSummary->windows[WIN_PAGE_C];
+    u8 nature = GetNature(mon);
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u32 level = GetMonData(mon, MON_DATA_LEVEL);
+    enum Ability ability = GetMonAbility(mon);
+    static const u8 sStats[] = {STAT_ATK, STAT_DEF, STAT_SPATK, STAT_SPDEF, STAT_SPEED};
+    static const u8 sStatData[] = {[STAT_ATK] = MON_DATA_ATK, [STAT_DEF] = MON_DATA_DEF, [STAT_SPATK] = MON_DATA_SPATK,
+                                   [STAT_SPDEF] = MON_DATA_SPDEF, [STAT_SPEED] = MON_DATA_SPEED};
+    static const u8 *const sStatNames[] = {[STAT_ATK] = COMPOUND_STRING("Attack"), [STAT_DEF] = COMPOUND_STRING("Defense"),
+                                           [STAT_SPATK] = COMPOUND_STRING("Sp. Atk"), [STAT_SPDEF] = COMPOUND_STRING("Sp. Def."),
+                                           [STAT_SPEED] = COMPOUND_STRING("Speed")};
+    u8 *end;
+
+    AddTextPrinterParameterized3(a, FONT_NORMAL, 44, 0, sColor_White, TEXT_SKIP_DRAW, COMPOUND_STRING("HP"));
+    end = ConvertIntToDecimalStringN(gStringVar1, GetMonData(mon, MON_DATA_HP), STR_CONV_MODE_LEFT_ALIGN, 3);
+    end = StringCopy(end, gText_Slash);
+    ConvertIntToDecimalStringN(end, GetMonData(mon, MON_DATA_MAX_HP), STR_CONV_MODE_LEFT_ALIGN, 3);
+    PrintRightAligned(a, gStringVar1, 68 + 63, 0, sColor_Dark);
+    for (u32 i = 0; i < ARRAY_COUNT(sStats); i++)
+    {
+        u8 stat = sStats[i];
+        const u8 *color = sColor_White;
+
+        if (gNaturesInfo[nature].statUp != gNaturesInfo[nature].statDown)
+        {
+            if (stat == gNaturesInfo[nature].statUp)
+                color = sColor_Red;
+            else if (stat == gNaturesInfo[nature].statDown)
+                color = sColor_Blue;
+        }
+        AddTextPrinterParameterized3(a, FONT_NORMAL, 10, 19 + 12 * i, color, TEXT_SKIP_DRAW, sStatNames[stat]);
+        ConvertIntToDecimalStringN(gStringVar1, GetMonData(mon, sStatData[stat]), STR_CONV_MODE_LEFT_ALIGN, 3);
+        PrintRightAligned(a, gStringVar1, 90 + 27, 20 + 12 * i, sColor_Dark);
+    }
+    AddTextPrinterParameterized3(a, FONT_NORMAL, 10, 79, sColor_White, TEXT_SKIP_DRAW, COMPOUND_STRING("Exp. Points"));
+    AddTextPrinterParameterized3(a, FONT_NORMAL, 10, 91, sColor_White, TEXT_SKIP_DRAW, COMPOUND_STRING("To Next Lv."));
+    ConvertIntToDecimalStringN(gStringVar1, GetMonData(mon, MON_DATA_EXP), STR_CONV_MODE_LEFT_ALIGN, 7);
+    PrintRightAligned(a, gStringVar1, 55 + 63, 80, sColor_Dark);
+    if (level < MAX_LEVEL)
+        ConvertIntToDecimalStringN(gStringVar1, gExperienceTables[gSpeciesInfo[species].growthRate][level + 1] - GetMonData(mon, MON_DATA_EXP),
+                                   STR_CONV_MODE_LEFT_ALIGN, 7);
+    else
+        StringCopy(gStringVar1, COMPOUND_STRING("0"));
+    PrintRightAligned(a, gStringVar1, 55 + 63, 92, sColor_Dark);
+
+    AddTextPrinterParameterized3(c, FONT_NORMAL, 11, 4, sColor_White, TEXT_SKIP_DRAW, COMPOUND_STRING("Ability"));
+    AddTextPrinterParameterized3(c, FONT_NORMAL, 60, 4, sColor_Dark, TEXT_SKIP_DRAW, gAbilitiesInfo[ability].name);
+    AddTextPrinterParameterized3(c, FONT_NORMAL, 20, 23, sColor_Dark, TEXT_SKIP_DRAW, gAbilitiesInfo[ability].description);
+}
