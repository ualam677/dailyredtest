+    LoadPalette(sTiles_Pal, BG_PLTT_ID(0), PLTT_SIZE_4BPP);
+    ListMenuLoadStdPalAt(BG_PLTT_ID(TEXT_PAL), 1);
+    LoadPalette(&sShadowLight, BG_PLTT_ID(TEXT_PAL) + TEXT_SHADOW_LIGHT, PLTT_SIZEOF(1));
+    LoadPalette(sTitle_Pal, BG_PLTT_ID(TITLE_PAL), PLTT_SIZE_4BPP);
+    LoadBgTilemap(BG_GRID, sMap_Grid, sizeof(sMap_Grid), 0);
+
+    {
+        const struct SpriteSheet sheets[] =
+        {
+            {sHpBar_Gfx, sizeof(sHpBar_Gfx), TAG_HP_BAR},
+            {sExpBar_Gfx, sizeof(sExpBar_Gfx), TAG_EXP_BAR},
+            {sStatus_Gfx, sizeof(sStatus_Gfx), TAG_STATUS},
+            {sShiny_Gfx, sizeof(sShiny_Gfx), TAG_SHINY},
+            {sCursorLeft_Gfx, sizeof(sCursorLeft_Gfx), TAG_CURSOR_LEFT},
+            {sCursorRight_Gfx, sizeof(sCursorRight_Gfx), TAG_CURSOR_RIGHT},
+            {0},
+        };
+        const struct SpritePalette pals[] =
+        {
+            {sHpBar0_Pal, TAG_HP_BAR},
+            {sHpBar1_Pal, TAG_HP_BAR + 1},
+            {sHpBar2_Pal, TAG_HP_BAR + 2},
+            {sStatus_Pal, TAG_STATUS},
+            {sShiny_Pal, TAG_SHINY},
+            {sCursor_Pal, TAG_CURSOR_PAL},
+            {0},
+        };
+        LoadSpriteSheets(sheets);
+        LoadSpritePalettes(pals);
+    }
+}
