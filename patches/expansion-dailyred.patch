+    // (UpdateSnowflakeSprite), starting at a random point of its circle.
+    sprite->tDeltaY = (rand & 3) * 21 + 128;
     sprite->tDeltaY2 = sprite->tDeltaY;
     StartSpriteAnim(sprite, (rand & 1) ? 0 : 1);
