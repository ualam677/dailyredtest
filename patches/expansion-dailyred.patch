@@ -0,0 +1,8180 @@
+// Generated by scripts/sets/generate.mjs. Don't edit by hand: change the
+// script's options and run it again.
+//
+// Source: Pokémon Showdown 0.11.11 (MIT license), Random Battle sets from
+// Gens 7, 8 and 9, each an equal share of a species' list (Mega and Z-Move lists
+// Gen 7, Tera lists Gen 9, Pokémon Champions for Mega Meganium and Mega
+// Feraligatr), and the hand-written lead sets of scripts/sets/lead-sets.mjs
+// (25% of a list). 400 randomSet() calls per generation, sets under
+// 2% dropped, at most 10 per generation.
+// Gimmick sets left out (gimmickReason in the script): built for Dynamax (Max Moves); Tera Blast without a Tera type; status Z-Move.
+// 6454 sets in 790 lists; 81 species for RED's random pick.
+
+#include "global.h"
+#include "data.h"
+#include "dailyred.h"
+#include "constants/abilities.h"
+#include "constants/items.h"
+#include "constants/moves.h"
+#include "constants/pokemon.h"
+#include "constants/species.h"
+
+// species, item, ability, moves, nature, EVs (HP/Atk/Def/SpA/SpD/Spe), IVs
+// (same order; only Hidden Power's type uses them), Tera type, friendship,
+// weight within the list.
+#define SET(sp, it, ab, m1, m2, m3, m4, nat, evs_, ivs_, tera, fr, w) \
+    {.species = SPECIES_##sp, .item = ITEM_##it, .ability = ABILITY_##ab, \
+     .moves = {MOVE_##m1, MOVE_##m2, MOVE_##m3, MOVE_##m4}, .nature = NATURE_##nat, \
+     .evs = evs_, .ivs = ivs_, .teraType = TYPE_##tera, .friendship = fr, .weight = w}
+#define EVS(hp, atk, def, spa, spd, spe) {hp, atk, def, spa, spd, spe}
+#define IVS(hp, atk, def, spa, spd, spe) TRAINER_PARTY_IVS(hp, atk, def, spe, spa, spd)
+
+const struct DailyRedSet gDailyRedSets[] =
+{
+    // Venusaur-Mega, MEGA (Gen 7)
+    SET(VENUSAUR, VENUSAURITE, CHLOROPHYLL, EARTHQUAKE, GIGA_DRAIN, SLUDGE_BOMB, SYNTHESIS, RASH, EVS(252, 4, 0, 252, 0, 0), IVS(31, 31, 31, 31, 31, 31), NONE, 255, 255), // Bulky Attacker, Gen 7, 35%
+    SET(VENUSAUR, VENUSAURITE, CHLOROPHYLL, GIGA_DRAIN, KNOCK_OFF, SLUDGE_BOMB, SYNTHESIS, RASH, EVS(252, 4, 0, 252, 0, 0), IVS(31, 31, 31, 31, 31, 31), NONE, 255, 239), // Bulky Attacker, Gen 7, 33%
+    SET(VENUSAUR, VENUSAURITE, CHLOROPHYLL, GIGA_DRAIN, SLEEP_POWDER, SLUDGE_BOMB, SYNTHESIS, MODEST, EVS(252, 0, 4, 252, 0, 0), IVS(31, 0, 31, 31, 31, 31), NONE, 255, 235), // Bulky Attacker, Gen 7, 32%
+    // Charizard-Mega-X, MEGA (Gen 7)
