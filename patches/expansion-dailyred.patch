+static void DrawInfoPage(void)
+{
+    struct Pokemon *mon = CurMon();
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u8 a = sSummary->windows[WIN_PAGE_A], b = sSummary->windows[WIN_PAGE_B];
+    u16 item = GetMonData(mon, MON_DATA_HELD_ITEM);
+    u32 dexNum = SpeciesToNationalPokedexNum(species);
+    static const u8 *const labels[] =
+    {
+        COMPOUND_STRING("Dex No."), COMPOUND_STRING("Name"), COMPOUND_STRING("Type"),
+        COMPOUND_STRING("OT"), COMPOUND_STRING("ID No."), COMPOUND_STRING("Item"),
+    };
+
+    for (u32 i = 0; i < ARRAY_COUNT(labels); i++)
+        AddTextPrinterParameterized3(a, FONT_NORMAL, 10, 7 + 12 * i, sColor_White, TEXT_SKIP_DRAW, labels[i]);
+    ConvertIntToDecimalStringN(gStringVar1, dexNum, STR_CONV_MODE_LEADING_ZEROS, dexNum > 999 ? 4 : 3);
+    AddTextPrinterParameterized3(a, FONT_NORMAL, 80, 8, IsMonShiny(mon) ? sColor_RedOnLight : sColor_Dark, TEXT_SKIP_DRAW, gStringVar1);
+    AddTextPrinterParameterized3(a, FONT_NORMAL, 80, 20, sColor_Dark, TEXT_SKIP_DRAW, GetSpeciesName(species));
+    BlitMenuInfoIcon(a, GetSpeciesType(species, 0) + 1, 78, 33);
+    if (GetSpeciesType(species, 0) != GetSpeciesType(species, 1))
+        BlitMenuInfoIcon(a, GetSpeciesType(species, 1) + 1, 110, 33);
+    GetMonData(mon, MON_DATA_OT_NAME, gStringVar1);
+    AddTextPrinterParameterized3(a, FONT_NORMAL, 80, 44, gSaveBlock2Ptr->playerGender == FEMALE ? sColor_RedOnLight : sColor_BlueOnLight, TEXT_SKIP_DRAW, gStringVar1);
+    ConvertIntToDecimalStringN(gStringVar1, GetMonData(mon, MON_DATA_OT_ID) & 0xFFFF, STR_CONV_MODE_LEADING_ZEROS, 5);
+    AddTextPrinterParameterized3(a, FONT_NORMAL, 80, 56, sColor_Dark, TEXT_SKIP_DRAW, gStringVar1);
+    AddTextPrinterParameterized3(a, FONT_NORMAL, 80, 68, sColor_Dark, TEXT_SKIP_DRAW, item == ITEM_NONE ? gText_None : GetItemName(item));
+
+    // The memo: the nature, and where the team came from.
+    AddTextPrinterParameterized3(b, FONT_NORMAL, 6, 0, sColor_White, TEXT_SKIP_DRAW, COMPOUND_STRING("Trainer Memo"));
+    StringCopy(gStringVar1, gNaturesInfo[GetNature(mon)].name);
+    ConvertIntToDecimalStringN(gStringVar2, GetMonData(mon, MON_DATA_LEVEL), STR_CONV_MODE_LEFT_ALIGN, 3);
+    StringExpandPlaceholders(gStringVar4, COMPOUND_STRING("{STR_VAR_1} nature.\nMet on MT. SILVER\nat Lv. {STR_VAR_2}."));
+    PrintLines(b, FONT_NORMAL, 16, 12, 12, sColor_Dark, gStringVar4);
+}
