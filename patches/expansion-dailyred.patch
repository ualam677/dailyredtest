+    sprite->tWaveIndex = (rand >> 4) & 0xFF;
+    sprite->tWaveDelta = ((rand >> 12) & 3) + 3;
+    sprite->tDrift = -(96 + ((rand >> 2) & 127));
+    sprite->tDriftSub = 0;
 }
 
 static void UNUSED WaitSnowflakeSprite(struct Sprite *sprite)
