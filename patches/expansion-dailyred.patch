+static u8 CreateTileSprite(u16 tileTag, u16 palTag, const struct OamData *oam, s16 x, s16 y)
+{
+    struct SpriteTemplate template = {
+        .tileTag = tileTag,
+        .paletteTag = palTag,
+        .oam = oam,
+        .anims = gDummySpriteAnimTable,
+        .images = NULL,
+        .affineAnims = gDummySpriteAffineAnimTable,
+        .callback = SpriteCallbackDummy,
+    };
+    return CreateSprite(&template, x, y, 0);
+}
+
+static void SetSpriteFrame(u8 spriteId, u16 tileTag, u16 tileOffset)
+{
+    gSprites[spriteId].oam.tileNum = GetSpriteTileStartByTag(tileTag) + tileOffset;
+}
