+};
+
+struct TeamMember
+{
+    const struct DailyRedSet *set;
+    u32 typeMask;  // its types, and its Mega forme's
+    u16 baseSpecies;
+    u8 level;
+    bool8 shiny;
+};
+
+struct Team
+{
+    struct TeamMember members[PARTY_SIZE];
+    u8 count;
+    u8 typeCounts[NUMBER_OF_MON_TYPES];
+};
+
+static bool32 IsInList(u16 value, const u16 *list, u32 count)
+{
+    u32 i;
+    for (i = 0; i < count; i++)
+    {
+        if (list[i] == value)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+// A Pokemon in its regular form that's in scope (see above).
+static bool32 IsScopeBaseSpecies(u16 species)
+{
+    if (species == SPECIES_NONE || species >= NUM_SPECIES || !IsSpeciesEnabled(species))
+        return FALSE;
+    return species <= SPECIES_DEOXYS || IsInList(species, sLaterEvolutions, ARRAY_COUNT(sLaterEvolutions));
+}
+
+bool32 DailyRed_IsSpeciesInScope(u16 species)
+{
+    if (species == SPECIES_NONE || species >= NUM_SPECIES)
+        return FALSE;
+    if (gSpeciesInfo[species].isMegaEvolution)
+        return IsScopeBaseSpecies(GET_BASE_SPECIES_ID(species));
+    return IsScopeBaseSpecies(species);
+}
+
+// Doesn't evolve into anything (in this game).
+static bool32 IsFinalStage(u16 species)
+{
+    const struct Evolution *evolutions = GetSpeciesEvolutions(species);
+    u32 i;
+
+    if (evolutions == NULL)
+        return TRUE;
+    for (i = 0; evolutions[i].method != EVOLUTIONS_END; i++)
+    {
+        if (IsSpeciesEnabled(evolutions[i].targetSpecies))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static bool32 IsLegendary(u16 species)
+{
+    return IsInList(species, sLegendaries, ARRAY_COUNT(sLegendaries));
+}
+
+// Which species may be drawn for the five: in scope in its regular form,
+// fully evolved, not legendary, and with Showdown sets.
+static bool32 IsEligibleSpecies(u16 species)
+{
+    return IsScopeBaseSpecies(species) && IsFinalStage(species) && !IsLegendary(species)
+        && DailyRed_FindSetList(species, DAILYRED_SETS_NORMAL) != NULL;
+}
+
+static u32 GetBaseStatTotal(u16 species)
+{
+    return GetSpeciesBaseHP(species) + GetSpeciesBaseAttack(species) + GetSpeciesBaseDefense(species)
+         + GetSpeciesBaseSpeed(species) + GetSpeciesBaseSpAttack(species) + GetSpeciesBaseSpDefense(species);
+}
+
+// Whether a Pokemon (its types: typeMask) can join the team.
+static bool32 CanAdd(const struct Team *team, u16 species, u32 typeMask)
+{
+    u32 i, type;
+    u16 baseSpecies = GET_BASE_SPECIES_ID(species);
+
+    bool32 isStarter = IsInList(baseSpecies, sStarters, ARRAY_COUNT(sStarters));
+    bool32 isEeveelution = IsInList(baseSpecies, sEeveelutions, ARRAY_COUNT(sEeveelutions));
+
+    for (i = 0; i < team->count; i++)
+    {
+        u16 member = team->members[i].baseSpecies;
+        if (member == baseSpecies)
+            return FALSE;
+        if (isStarter && IsInList(member, sStarters, ARRAY_COUNT(sStarters)))
+            return FALSE;
+        if (isEeveelution && IsInList(member, sEeveelutions, ARRAY_COUNT(sEeveelutions)))
+            return FALSE;
+    }
+    for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+    {
+        if ((typeMask & (1u << type)) && team->typeCounts[type] >= MAX_TYPE_COUNT)
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static void AddMember(struct Team *team, const struct DailyRedSetList *list, u8 level, bool8 shiny, u32 *rng)
+{
+    struct TeamMember *member = &team->members[team->count++];
+    u32 type;
+
+    member->set = DailyRed_PickSet(list, rng);
+    member->typeMask = DailyRed_GetTypeMask(list->species) | DailyRed_GetTypeMask(member->set->species);
+    member->baseSpecies = GET_BASE_SPECIES_ID(member->set->species);
+    member->level = level;
+    member->shiny = shiny;
+    for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+    {
+        if (member->typeMask & (1u << type))
+            team->typeCounts[type]++;
+    }
+}
+
+static void RemoveLastMember(struct Team *team)
+{
+    struct TeamMember *member = &team->members[--team->count];
+    u32 type;
+
+    for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+    {
+        if (member->typeMask & (1u << type))
+            team->typeCounts[type]--;
+    }
+}
+
+static void AddStarter(struct Team *team, u16 redStarter, u32 *rng)
+{
+    const struct DailyRedSetList *list = NULL;
+    u16 starter;
+    u32 i;
+
+    if (redStarter == SPECIES_NONE)
+    {
+        // RED has all three: any of the nine counters.
+        u32 pick = TeamRandom(rng) % (ARRAY_COUNT(sCounterStarters) * 3);
+        starter = sCounterStarters[pick / 3].counters[pick % 3];
+    }
+    else
+    {
+        starter = sCounterStarters[0].counters[0];
+        for (i = 0; i < ARRAY_COUNT(sCounterStarters); i++)
+        {
+            if (sCounterStarters[i].redStarter == redStarter)
+                starter = sCounterStarters[i].counters[TeamRandom(rng) % 3];
+        }
+    }
+
+    for (i = 0; i < ARRAY_COUNT(sStarterMegas); i++)
+    {
+        if (sStarterMegas[i].species == starter)
+            list = DailyRed_FindSetList(sStarterMegas[i].megas[TeamRandom(rng) % 2], DAILYRED_SETS_MEGA);
+    }
+    if (list == NULL)
+        list = DailyRed_FindSetList(starter, DAILYRED_SETS_ZMOVE); // Typhlosion
+    if (list == NULL)
+        list = DailyRed_FindSetList(starter, DAILYRED_SETS_NORMAL);
+    AddMember(team, list, LEVEL_STARTER, FALSE, rng);
+}
+
+// A random legendary that fits the team (practically always the first try).
+static void AddLegendary(struct Team *team, u32 *rng)
+{
+    u32 attempt;
+
+    for (attempt = 0; attempt < 100; attempt++)
+    {
+        u16 species = sLegendaries[TeamRandom(rng) % ARRAY_COUNT(sLegendaries)];
+        const struct DailyRedSetList *list = DailyRed_FindSetList(species, DAILYRED_SETS_NORMAL);
+        if (list != NULL && CanAdd(team, species, DailyRed_GetTypeMask(species)))
+        {
+            AddMember(team, list, list->level, FALSE, rng);
+            return;
+        }
+    }
+}
+
+// A random eligible species that fits the team.
+static bool32 AddRandomMember(struct Team *team, u32 *rng)
+{
+    u32 attempt;
+    u16 species;
+
+    for (attempt = 0; attempt < MAX_SPECIES_ATTEMPTS; attempt++)
+    {
+        species = 1 + TeamRandom(rng) % (NUM_SPECIES - 1);
+        if (IsEligibleSpecies(species) && CanAdd(team, species, DailyRed_GetTypeMask(species)))
+            break;
+    }
+    // Only reachable if the rules leave almost nothing to pick.
+    if (attempt == MAX_SPECIES_ATTEMPTS)
+    {
+        for (species = 1; species < NUM_SPECIES; species++)
+        {
+            if (IsEligibleSpecies(species) && CanAdd(team, species, DailyRed_GetTypeMask(species)))
+                break;
+        }
+        if (species == NUM_SPECIES)
+            return FALSE;
+    }
+    const struct DailyRedSetList *list = DailyRed_FindSetList(species, DAILYRED_SETS_NORMAL);
+    AddMember(team, list, list->level, FALSE, rng);
+    return TRUE;
+}
+
+static u32 GetTeamBaseStatTotal(const struct Team *team)
+{
+    u32 i, total = 0;
+    for (i = 0; i < team->count; i++)
+        total += GetBaseStatTotal(team->members[i].set->species);
+    return total;
+}
+
+static void BuildTeam(struct Team *team, u16 redStarter, u32 *rng)
+{
+    struct Team best;
+    u32 attempt, fixedCount, bestTotal = 0;
+
+    // Always the first draw (see the top of the file).
+    bool32 mirror = TeamRandom(rng) % 100 < MIRROR_RED_ODDS;
+
+    AddStarter(team, redStarter, rng);
+    if (mirror)
+    {
+        AddMember(team, DailyRed_FindSetList(SPECIES_PIKACHU, DAILYRED_SETS_NORMAL), LEVEL_PIKACHU, TRUE, rng);
+        AddLegendary(team, rng);
+    }
+    else if (TeamRandom(rng) % LEGENDARY_TEAM_ODDS == 0)
+    {
+        // Decided once per team, before the minimum, so the minimum can't
+        // make legendaries more likely.
+        AddLegendary(team, rng);
+    }
+
+    // The rest, drawn again until the team meets the minimum, so every
+    // qualifying team is equally likely. In the practically impossible case
+    // that none does, the strongest one drawn is used.
+    fixedCount = team->count;
+    for (attempt = 0; attempt < MAX_TEAM_ATTEMPTS; attempt++)
+    {
+        u32 total;
+        while (team->count > fixedCount)
+            RemoveLastMember(team);
+        while (team->count < PARTY_SIZE && AddRandomMember(team, rng))
+            ;
+        total = GetTeamBaseStatTotal(team);
+        if (total >= MIN_TEAM_BASE_STAT_TOTAL)
+            return;
+        if (total > bestTotal)
+        {
+            bestTotal = total;
+            best = *team;
+        }
+    }
+    *team = best;
+}
+
+void DailyRed_GenerateTeam(struct Pokemon *party, u32 *rng, u16 redStarter)
+{
+    struct Team team = {0};
+    struct TrainerGenerator trainerGen = {0};
+    u8 order[PARTY_SIZE];
+    u8 metLocation = METLOC_FATEFUL_ENCOUNTER;
+    u8 fateful = TRUE;
+    u32 i, j;
+
+    BuildTeam(&team, redStarter, rng);
+
+    // A random party order.
+    for (i = 0; i < team.count; i++)
+        order[i] = i;
+    for (i = 0; i + 1 < team.count; i++)
+    {
+        u8 temp;
+        j = i + TeamRandom(rng) % (team.count - i);
+        SWAP(order[i], order[j], temp);
+    }
+
+    // Owned by the player.
+    trainerGen.gender = gSaveBlock2Ptr->playerGender;
+    trainerGen.otID = OTID_STRUCT_PLAYER_ID;
+    StringCopyN(trainerGen.name, gSaveBlock2Ptr->playerName, PLAYER_NAME_LENGTH + 1);
+    trainerGen.localRngState = LocalRandomSeed(TeamRandom32(rng));
+
+    for (i = 0; i < PARTY_SIZE; i++)
+        ZeroMonData(&party[i]);
+    for (i = 0; i < team.count; i++)
+    {
+        const struct TeamMember *member = &team.members[order[i]];
+        // The usual shiny odds, except the mirror Pikachu (always shiny).
+        bool8 shiny = member->shiny || (TeamRandom(rng) < SHINY_ODDS);
+        DailyRed_CreateSetMon(&party[i], member->set, member->level, TRAINER_MON_RANDOM_GENDER, shiny, &trainerGen);
+        // Event Pokemon like Mew and Deoxys, as Daily Red's have always been.
+        SetMonData(&party[i], MON_DATA_MODERN_FATEFUL_ENCOUNTER, &fateful);
+        SetMonData(&party[i], MON_DATA_MET_LOCATION, &metLocation);
+    }
+}
