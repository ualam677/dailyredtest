+
+enum
+{
+    WIN_POKEMON_NAME,
+    WIN_STATS,
+    WIN_BOTTOM_BOX,
+    WIN_HIDDEN_POWER,
+    WIN_TYPE,
+};
+
+#define TEXT_PAL 15
+#define TYPE_ICONS_PAL 12
+
+// The Pokemon's picture, and where it lands after jumping in from the right.
+#define PIC_X (8 * 20 + 40 - 2)
+#define PIC_Y (8 * 6 + 40)
+#define JUMP_FRAMES 48
+
+#define BALL_X 188
+#define BALL_Y 21
+#define BALL_SIZE 16
+#define BALL_ANIM_CLOSED 3
+#define BALL_ANIM_OPEN 4
+
+// The table: stat names, then base stats, EVs and IVs.
+#define NAME_X 4
+#define BS_X 61
+#define EV_X (BS_X + 30)
+#define IV_X (EV_X + 36)
+#define ROW_Y(row) (1 + (row) * 14)
+
+struct EvIv
+{
+    u8 callbackStep;
+    u8 state;
+    u8 currentMon;
+    u8 partyCount;
+    u8 picTaskId;
+    u8 ballSpriteIds[PARTY_SIZE];
+    u16 tilemapBuffer[0x400];
+};
+
+static EWRAM_DATA struct EvIv *sEvIv = NULL;
+
+static void Task_EvIvInit(u8 taskId);
+static void Task_EvIvInput(u8 taskId);
+static void ShowMon(void);
+
+static const u16 sEvIv_Pal[] = INCGFX_U16("graphics/dailyred/ev_iv/tiles.png", ".gbapal");
+static const u32 sEvIv_Gfx[] = INCGFX_U32("graphics/dailyred/ev_iv/tiles.png", ".4bpp");
+static const u16 sEvIv_Tilemap[] = INCBIN_U16("graphics/dailyred/ev_iv/map.bin");
+
+// 0 transparent, 1 white, 2 grey, 3 light grey, 4 red, 5 dark red, 6 blue,
+// 7 dark blue, 8 yellow, 9 dark yellow.
+static const u16 sTextPal[] = {0x542E, 0x7FFF, 0x318C, 0x675A, 0x319E, 0x1CFE, 0x7EC4, 0x6600, 0x239E, 0x0611};
+
+static const u8 sTextColor_Black[] = {TEXT_COLOR_TRANSPARENT, TEXT_COLOR_DARK_GRAY, TEXT_COLOR_LIGHT_GRAY};
+static const u8 sTextColor_Blue[] = {TEXT_COLOR_TRANSPARENT, 6, 7};
+static const u8 sTextColor_Red[] = {TEXT_COLOR_TRANSPARENT, 4, 5};
+static const u8 sTextColor_Gray[] = {TEXT_COLOR_TRANSPARENT, TEXT_COLOR_LIGHT_GRAY, TEXT_COLOR_DARK_GRAY};
+static const u8 sTextColor_Shiny[] = {TEXT_COLOR_TRANSPARENT, 8, 9};
+
+static const u8 sText_BsEvIv[] = _(" BS{CLEAR_TO 30} EV{CLEAR_TO 60} IV");
+static const u8 sText_Total[] = _("Total:");
+static const u8 sText_ArrowUp[] = _("{UP_ARROW}");
+static const u8 sText_ArrowDown[] = _("{DOWN_ARROW}");
+static const u8 sText_Male[] = _("♂");
+static const u8 sText_Female[] = _("♀");
+static const u8 sText_Is[] = _(" is ");
+static const u8 sText_Happy[] = _("% happy.");
+static const u8 sText_Level[] = _("Lv. ");
+
+// The table's rows, top to bottom.
+static const u8 sStatRows[NUM_STATS] = {STAT_HP, STAT_ATK, STAT_DEF, STAT_SPATK, STAT_SPDEF, STAT_SPEED};
+static const u8 *const sStatNames[NUM_STATS] =
+{
+    [STAT_HP]    = COMPOUND_STRING("HP"),
+    [STAT_ATK]   = COMPOUND_STRING("Attack"),
+    [STAT_DEF]   = COMPOUND_STRING("Defense"),
+    [STAT_SPATK] = COMPOUND_STRING("Sp. Atk."),
+    [STAT_SPDEF] = COMPOUND_STRING("Sp. Def."),
+    [STAT_SPEED] = COMPOUND_STRING("Speed"),
+};
+static const u8 sStatEvData[NUM_STATS] =
+{
+    [STAT_HP] = MON_DATA_HP_EV, [STAT_ATK] = MON_DATA_ATK_EV, [STAT_DEF] = MON_DATA_DEF_EV,
+    [STAT_SPEED] = MON_DATA_SPEED_EV, [STAT_SPATK] = MON_DATA_SPATK_EV, [STAT_SPDEF] = MON_DATA_SPDEF_EV,
+};
+static const u8 sStatIvData[NUM_STATS] =
+{
+    [STAT_HP] = MON_DATA_HP_IV, [STAT_ATK] = MON_DATA_ATK_IV, [STAT_DEF] = MON_DATA_DEF_IV,
+    [STAT_SPEED] = MON_DATA_SPEED_IV, [STAT_SPATK] = MON_DATA_SPATK_IV, [STAT_SPDEF] = MON_DATA_SPDEF_IV,
+};
+
+static const struct BgTemplate sBgTemplates[] =
+{
+    {
+        .bg = 0,
+        .charBaseIndex = 0,
+        .mapBaseIndex = 22,
+        .screenSize = 0,
+        .paletteMode = 0,
+        .priority = 0,
