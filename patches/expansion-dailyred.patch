diff --git a/src/dailyred.c b/src/dailyred.c
new file mode 100644
index 00000000..983819ab
--- /dev/null
+++ b/src/dailyred.c
@@ -0,0 +1,219 @@
+#include "global.h"
+#include "dailyred.h"
+#include "event_data.h"
+#include "load_save.h"
+#include "main.h"
+#include "malloc.h"
+#include "new_game.h"
+#include "overworld.h"
+#include "pokemon.h"
+#include "random.h"
+#include "save.h"
+#include "string_util.h"
+#include "gba/m4a_internal.h"
+#include "constants/maps.h"
+
+// Game flow for Daily Red: boot, starting a run and how a run ends.
+// The team rules live in dailyred_team.c, RED's team in
+// src/data/trainers_frlg.party (TRAINER_DAILYRED_RED).
+
+// The website fills in this struct in the ROM image before booting it,
+// finding it by its magic bytes (web/rom-config.js), so no emulator API is
+// needed beyond "load this ROM".
+//
+// A seed of 0 means the ROM wasn't patched (for example, it's running in a
+// desktop emulator). The game then shows the normal title screen and seeds
+// itself from the frame the player presses Start.
+struct DailyRedRomConfig
+{
+    u8 magic[16];
+    u32 seed;
+    u16 wins;    // the player's record before this game, for the record message
+    u16 battles;
+    u8 daily;    // TRUE: the website's daily game (one battle, then the game ends)
+    u8 padding[3];
+};
+
+const struct DailyRedRomConfig gDailyRedRomConfig __attribute__((used, aligned(4))) =
+{
+    .magic = {'D', 'A', 'I', 'L', 'Y', 'R', 'E', 'D', '-', 'C', 'O', 'N', 'F', '-', 'V', '2'},
+};
+
+// The website reads this from the emulator's memory (web/game-link.js) to
+// learn when RED's battle starts and how it ended. It finds the struct by the
+// magic bytes followed by the seed it injected, which only this live copy in
+// RAM has. Nothing in the game reads it, so it's volatile: otherwise the
+// compiler (with link-time optimization) drops every write to it.
+struct DailyRedStatus
+{
+    u8 magic[16];
+    u32 seed;
+    u8 phase;  // DAILYRED_PHASE_*
+    u8 result; // DAILYRED_RESULT_*
+    u8 padding[2];
+};
+
+enum
+{
+    DAILYRED_PHASE_EXPLORING,
+    DAILYRED_PHASE_BATTLE,   // RED's battle has started
+    DAILYRED_PHASE_RESULT,   // the battle is over and the result is set
+    DAILYRED_PHASE_FINISHED, // daily game: the closing messages are done
+};
+
+enum
+{
+    DAILYRED_RESULT_NONE,
+    DAILYRED_RESULT_WON,
+    DAILYRED_RESULT_LOST,
+};
+
+static const u8 sStatusMagic[16] = {'D', 'A', 'I', 'L', 'Y', 'R', 'E', 'D', '-', 'S', 'T', 'A', 'T', 'U', 'S', '1'};
+static EWRAM_DATA volatile struct DailyRedStatus sStatus __attribute__((used)) = {0};
+
+// Team generator RNG. Seeded once per boot; each new run continues from where
+// the previous one stopped, so a seed fixes the whole sequence of teams.
+static EWRAM_DATA u32 sTeamRngState = 0;
+
+static const u8 sText_PlayerName[] = _("LEAF");
+static const u8 sText_RivalName[] = _("RED");
+
+// The config is read through volatile pointers: the compiler would otherwise
+// assume the values are still the zeros the ROM was built with.
+static u32 GetInjectedSeed(void)
+{
+    return *(const vu32 *)&gDailyRedRomConfig.seed;
+}
+
+static bool8 IsDailyGame(void)
+{
+    return *(const vu8 *)&gDailyRedRomConfig.daily;
+}
+
+static void InitStatus(u32 seed)
+{
+    u32 i;
+
+    for (i = 0; i < sizeof(sStatus.magic); i++)
+        sStatus.magic[i] = sStatusMagic[i];
+    sStatus.seed = seed;
+    sStatus.phase = DAILYRED_PHASE_EXPLORING;
+    sStatus.result = DAILYRED_RESULT_NONE;
+}
+
+bool8 DailyRed_HasInjectedSeed(void)
+{
+    return GetInjectedSeed() != 0;
+}
+
+bool32 DailyRed_IsOnSummit(void)
+{
+    return gSaveBlock1Ptr->location.mapGroup == MAP_GROUP(MAP_DAILY_RED_SUMMIT)
+        && gSaveBlock1Ptr->location.mapNum == MAP_NUM(MAP_DAILY_RED_SUMMIT);
+}
+
+// Fresh, unsaved game data every boot: LEAF, female, fast text, SET battle
+// style. CB2_NewGame then calls NewGameInitData, which calls
+// DailyRed_InitNewGame.
+static void StartNewGame(void)
+{
+    Sav2_ClearSetDefault();
+    SetPokemonCryStereo(gSaveBlock2Ptr->optionsSound);
+    gSaveBlock2Ptr->optionsTextSpeed = OPTIONS_TEXT_SPEED_FAST;
+    // No "Will LEAF change POKeMON?" when RED's Pokemon faints. The Options
+    // menu keeps this locked (option_menu.c).
+    gSaveBlock2Ptr->optionsBattleStyle = OPTIONS_BATTLE_STYLE_SET;
+    gSaveBlock2Ptr->playerGender = FEMALE; // FireRed's own female player, LEAF
+    StringCopy(gSaveBlock2Ptr->playerName, sText_PlayerName);
+    StringCopy(gSaveBlock1Ptr->rivalName, sText_RivalName);
+    SetMainCallback2(CB2_NewGame);
+}
+
+// Used instead of the intro and title screen when the website supplied a
+// seed (from the copyright screen, see intro_frlg.c).
+void CB2_DailyRed_StartFromCopyright(void)
+{
+    u32 seed = GetInjectedSeed();
+
+    // What SeedRngAndSetTrainerId does with the timer, but from the seed.
+    SeedRngAndSetTrainerIdFromSeed(seed);
+    sTeamRngState = seed;
+    InitStatus(seed);
+    // No resetting out of a losing battle in the daily game. Only saving,
+    // link play and trading turn it back on, and none of those exist here.
+    if (IsDailyGame())
+        gSoftResetDisabled = TRUE;
+    SetSaveBlocksPointers(GetSaveBlocksPointersBaseOffset());
+    ResetMenuAndMonGlobals();
+    Save_ResetSaveCounters();
+    LoadGameSave(SAVE_NORMAL);
+    InitHeap(gHeap, HEAP_SIZE);
+    StartNewGame();
+}
+
+// Used instead of the main menu when there's no injected seed: seeds the game
+// from the frame the player pressed Start on the title screen.
+void CB2_DailyRed_StartFromTitle(void)
+{
+    SeedRngAndSetTrainerId();
+    sTeamRngState = Random32();
+    InitStatus(0);
+    StartNewGame();
+}
+
+static void GenerateTeam(void)
+{
+    DailyRed_GenerateTeam(gParties[B_TRAINER_PLAYER], &sTeamRngState);
+    CalculatePlayerPartyCount();
+}
+
+// Called from NewGameInitData in place of warping to the player's bedroom.
+void DailyRed_InitNewGame(void)
+{
+    FlagSet(FLAG_SYS_POKEMON_GET); // shows POKeMON in the start menu
+    // Obedience: with the expansion's Gen 8+ rules even your own Pokemon
+    // check badges (against the level they were met at). The Earth Badge
+    // makes every level obey, as Daily Red has always had them.
+    FlagSet(FLAG_BADGE08_GET);
+    EnableNationalPokedex();       // so Pokemon show national dex numbers
+    // Start the record from the website's saved stats (0 outside the website).
+    VarSet(VAR_DAILYRED_WINS, *(const vu16 *)&gDailyRedRomConfig.wins);
+    VarSet(VAR_DAILYRED_BATTLES, *(const vu16 *)&gDailyRedRomConfig.battles);
+    GenerateTeam();
+    SetWarpDestination(MAP_GROUP(MAP_DAILY_RED_SUMMIT), MAP_NUM(MAP_DAILY_RED_SUMMIT), WARP_ID_NONE, DAILYRED_START_X, DAILYRED_START_Y);
+    WarpIntoMap();
+}
+
+// Special: replaces the player's team after a battle (when not playing the
+// daily game). The map script then warps back to the start position, which
+// also resets RED.
+void DailyRed_StartNextRun(void)
+{
+    GenerateTeam();
+    sStatus.phase = DAILYRED_PHASE_EXPLORING;
+    sStatus.result = DAILYRED_RESULT_NONE;
+}
+
+// Specials the map script calls so the website can follow the battle.
+void DailyRed_OnBattleStart(void)
+{
+    sStatus.phase = DAILYRED_PHASE_BATTLE;
+}
+
+// Call right after the battle, while VAR_RESULT is TRUE if the player lost.
+void DailyRed_OnBattleEnd(void)
+{
+    sStatus.result = gSpecialVar_Result ? DAILYRED_RESULT_LOST : DAILYRED_RESULT_WON;
+    sStatus.phase = DAILYRED_PHASE_RESULT;
+}
+
+void DailyRed_OnDailyGameOver(void)
+{
+    sStatus.phase = DAILYRED_PHASE_FINISHED;
+}
+
+// Specialvar: TRUE in the website's daily game, which ends after one battle.
+u16 DailyRed_IsDailyGame(void)
+{
+    return IsDailyGame();
+}
diff --git a/src/dailyred_team.c b/src/dailyred_team.c
new file mode 100644
index 00000000..1a2c228c
--- /dev/null
+++ b/src/dailyred_team.c
@@ -0,0 +1,544 @@
+#include "global.h"
+#include "dailyred.h"
+#include "item.h"
+#include "move.h"
+#include "party_menu.h"
+#include "pokemon.h"
+#include "random.h"
+#include "constants/items.h"
+#include "constants/moves.h"
+#include "constants/region_map_sections.h"
+#include "constants/species.h"
+
+// Random team generator for Daily Red.
+//
+// Rules (see "Team generation" in the project README):
+//   - 6 different species out of the eligible ones (IsEligibleSpecies), whose
+//     base stat totals add up to at least MIN_TEAM_BASE_STAT_TOTAL. 1 team in
+//     LEGENDARY_TEAM_ODDS includes exactly one legendary; the rest have none.
+//   - Level 100 with a random personality (so random nature, gender, ability
+//     and the normal shiny chance), random IVs from MIN_TEAM_IV to 31, and
+//     EVs focused on its two best stats (see AssignFocusedEVs), close to RED's
+//     perfect IVs and hand-picked EV spreads.
+//   - Up to 4 different moves picked uniformly from everything the species can
+//     learn by level-up (at any level) or by TM/HM. If the species has any
+//     damaging move, at least one of the 4 is damaging.
+//   - One held item, picked uniformly from sBattleItems plus the type-boosting
+//     items for the types of its own attacking moves (RED's team holds items
+//     too).
+//
+// It draws from its own RNG state instead of the game's Random(), so a given
+// seed always produces the same sequence of teams regardless of what else in
+// the game consumed random numbers in between.
+
+#define MAX_CANDIDATE_MOVES  160 // Mew, the largest pool, has about 110
+#define MAX_TOTAL_EV_POINTS  510
+#define MAX_STAT_EV_POINTS   252
+#define MIN_TEAM_IV          25  // IVs are random from this to 31 (RED's are all 31)
+#define MAX_SPECIES_ATTEMPTS 4000
+#define MAX_MON_ATTEMPTS     10
+#define MAX_TEAM_ATTEMPTS    1000
+
+// Minimum combined base stat total (HP + Atk + Def + Speed + Sp. Atk +
+// Sp. Def) for the player's six. RED's team adds up to 2974 (Pikachu 320,
+// Espeon 525, Snorlax 540, Venusaur 525, Charizard 534, Blastoise 530), while
+// a fully random team averages about 2440. About 1 random draw in 12 meets
+// the minimum, and roughly 1 qualifying team in 24 out-totals RED's. Raise it
+// to make the game easier, lower it for harder. Set to 0 to turn the rule off.
+#define MIN_TEAM_BASE_STAT_TOTAL 2700
+
+// Legendary and mythical Pokemon average a base stat total of 613, against
+// 394 for everything else, so the minimum above would put one in most teams
+// (64% of them). Instead, 1 in LEGENDARY_TEAM_ODDS teams gets exactly one and
+// the others get none.
+#define LEGENDARY_TEAM_ODDS 8
+
+static const u16 sLegendaries[] =
+{
+    SPECIES_ARTICUNO, SPECIES_ZAPDOS, SPECIES_MOLTRES, SPECIES_MEWTWO, SPECIES_MEW,
+    SPECIES_RAIKOU, SPECIES_ENTEI, SPECIES_SUICUNE, SPECIES_LUGIA, SPECIES_HO_OH, SPECIES_CELEBI,
+    SPECIES_REGIROCK, SPECIES_REGICE, SPECIES_REGISTEEL, SPECIES_LATIAS, SPECIES_LATIOS,
+    SPECIES_KYOGRE, SPECIES_GROUDON, SPECIES_RAYQUAZA, SPECIES_JIRACHI, SPECIES_DEOXYS,
+};
+
+// Held items that help any Pokemon in a single battle.
+static const u16 sBattleItems[] =
+{
+    ITEM_LEFTOVERS,
+    ITEM_SHELL_BELL,
+    ITEM_CHOICE_BAND,
+    ITEM_QUICK_CLAW,
+    ITEM_KINGS_ROCK,
+    ITEM_SCOPE_LENS,
+    ITEM_BRIGHT_POWDER,
+    ITEM_FOCUS_BAND,
+    ITEM_WHITE_HERB,
+    ITEM_MENTAL_HERB,
+    ITEM_LUM_BERRY,
+    ITEM_SITRUS_BERRY,
+    ITEM_CHESTO_BERRY,
+    ITEM_LIECHI_BERRY,
+    ITEM_SALAC_BERRY,
+    ITEM_PETAYA_BERRY,
+};
+
+// The item that boosts moves of each type (types without one stay ITEM_NONE).
+static const u16 sTypeBoostItems[NUMBER_OF_MON_TYPES] =
+{
+    [TYPE_NORMAL]   = ITEM_SILK_SCARF,
+    [TYPE_FIGHTING] = ITEM_BLACK_BELT,
+    [TYPE_FLYING]   = ITEM_SHARP_BEAK,
+    [TYPE_POISON]   = ITEM_POISON_BARB,
+    [TYPE_GROUND]   = ITEM_SOFT_SAND,
+    [TYPE_ROCK]     = ITEM_HARD_STONE,
+    [TYPE_BUG]      = ITEM_SILVER_POWDER,
+    [TYPE_GHOST]    = ITEM_SPELL_TAG,
+    [TYPE_STEEL]    = ITEM_METAL_COAT,
+    [TYPE_FIRE]     = ITEM_CHARCOAL,
+    [TYPE_WATER]    = ITEM_MYSTIC_WATER,
+    [TYPE_GRASS]    = ITEM_MIRACLE_SEED,
+    [TYPE_ELECTRIC] = ITEM_MAGNET,
+    [TYPE_PSYCHIC]  = ITEM_TWISTED_SPOON,
+    [TYPE_ICE]      = ITEM_NEVER_MELT_ICE,
+    [TYPE_DRAGON]   = ITEM_DRAGON_FANG,
+    [TYPE_DARK]     = ITEM_BLACK_GLASSES,
+    [TYPE_FAIRY]    = ITEM_FAIRY_FEATHER,
+};
+
+static u16 TeamRandom(u32 *rng)
+{
+    *rng = ISO_RANDOMIZE1(*rng);
+    return *rng >> 16;
+}
+
+static u32 TeamRandom32(u32 *rng)
+{
+    u32 lo = TeamRandom(rng);
+    return lo | ((u32)TeamRandom(rng) << 16);
+}
+
+// Which species may appear on the player's team: the 386 Pokemon of
+// Generations 1-3, in their base forms. Add rules here, e.g. "fully evolved
+// only" or "no legendaries".
+static bool32 IsEligibleSpecies(u16 species)
+{
+    if (species == SPECIES_NONE || species > SPECIES_DEOXYS)
+        return FALSE;
+    return IsSpeciesEnabled(species);
+}
+
+static u32 GetBaseStatTotal(u16 species)
+{
+    return GetSpeciesBaseHP(species) + GetSpeciesBaseAttack(species) + GetSpeciesBaseDefense(species)
+         + GetSpeciesBaseSpeed(species) + GetSpeciesBaseSpAttack(species) + GetSpeciesBaseSpDefense(species);
+}
+
+static bool32 IsLegendary(u16 species)
+{
+    u32 i;
+
+    for (i = 0; i < ARRAY_COUNT(sLegendaries); i++)
+    {
+        if (sLegendaries[i] == species)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static bool32 IsSpeciesTaken(u16 species, const u16 *taken, u8 takenCount)
+{
+    u32 i;
+
+    for (i = 0; i < takenCount; i++)
+    {
+        if (taken[i] == species)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+// A random non-legendary species that isn't already on the team.
+static u16 PickSpecies(u32 *rng, const u16 *taken, u8 takenCount)
+{
+    u16 species;
+    s32 i;
+
+    for (i = 0; i < MAX_SPECIES_ATTEMPTS; i++)
+    {
+        species = 1 + TeamRandom(rng) % (NUM_SPECIES - 1);
+        if (IsEligibleSpecies(species) && !IsLegendary(species) && !IsSpeciesTaken(species, taken, takenCount))
+            return species;
+    }
+
+    // Only reachable if the eligibility rules leave almost nothing to pick.
+    for (species = 1; species < NUM_SPECIES; species++)
+    {
+        if (IsEligibleSpecies(species) && !IsLegendary(species) && !IsSpeciesTaken(species, taken, takenCount))
+            return species;
+    }
+    return SPECIES_BULBASAUR;
+}
+
+// Decides whether this team gets a legendary, then draws the other Pokemon
+// until the team meets MIN_TEAM_BASE_STAT_TOTAL (about 1 in 12 draws do), so
+// every qualifying team is equally likely. In the practically impossible case
+// that none does, the strongest team drawn is used.
+static void PickTeamSpecies(u16 *species, u32 *rng)
+{
+    u16 best[PARTY_SIZE];
+    u32 total, bestTotal = 0;
+    s32 attempt;
+    u8 i, first = 0, slot;
+    u16 temp;
+
+    // Decided once per team, before the minimum, so the minimum can't make
+    // legendaries more likely.
+    if (TeamRandom(rng) % LEGENDARY_TEAM_ODDS == 0)
+        species[first++] = sLegendaries[TeamRandom(rng) % ARRAY_COUNT(sLegendaries)];
+
+    for (attempt = 0; attempt < MAX_TEAM_ATTEMPTS; attempt++)
+    {
+        total = 0;
+        for (i = 0; i < PARTY_SIZE; i++)
+        {
+            if (i >= first)
+                species[i] = PickSpecies(rng, species, i);
+            total += GetBaseStatTotal(species[i]);
+        }
+        if (total >= MIN_TEAM_BASE_STAT_TOTAL)
+            break;
+        if (total > bestTotal)
+        {
+            bestTotal = total;
+            memcpy(best, species, sizeof(best));
+        }
+    }
+    if (attempt == MAX_TEAM_ATTEMPTS)
+        memcpy(species, best, sizeof(best));
+
+    // Put the legendary (if any) in a random party slot instead of the lead.
+    slot = TeamRandom(rng) % PARTY_SIZE;
+    SWAP(species[0], species[slot], temp);
+}
+
+static void AddCandidateMove(u16 *moves, u8 *count, u16 move)
+{
+    u32 i;
+
+    if (move == MOVE_NONE || move >= MOVES_COUNT || *count >= MAX_CANDIDATE_MOVES)
+        return;
+    for (i = 0; i < *count; i++)
+    {
+        if (moves[i] == move)
+            return;
+    }
+    moves[(*count)++] = move;
+}
+
+// Every move the Pokemon can learn by level-up (any level) or TM/HM.
+// Other sources (move tutors, egg moves) can be added here.
+static u8 GetLearnableMoves(struct Pokemon *mon, u16 *moves)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    const struct LevelUpMove *learnset = GetSpeciesLevelUpLearnset(species);
+    u8 count = 0;
+    u32 i;
+    u16 move;
+
+    for (i = 0; learnset[i].move != LEVEL_UP_MOVE_END; i++)
+        AddCandidateMove(moves, &count, learnset[i].move);
+
+    // TM/HM indices start at 1 (0 is ITEM_NONE / MOVE_NONE).
+    for (i = 1; i <= NUM_ALL_MACHINES; i++)
+    {
+        move = GetTMHMMoveId(i);
+        if (move != MOVE_NONE && CanLearnTeachableMove(species, move))
+            AddCandidateMove(moves, &count, move);
+    }
+    return count;
+}
+
+static bool32 IsDamagingMove(u16 move)
+{
+    return GetMoveCategory(move) != DAMAGE_CATEGORY_STATUS;
+}
+
+// Damage that doesn't come from the user's Attack or Sp. Atk, so neither EVs
+// nor type-boosting items change it (Seismic Toss, Super Fang, Counter, OHKO
+// moves, ...). Variable-power moves like Return or Low Kick do use them.
+static bool32 IsFixedDamageMove(u16 move)
+{
+    switch (GetMoveEffect(move))
+    {
+    case EFFECT_BIDE:
+    case EFFECT_OHKO:
+    case EFFECT_FIXED_PERCENT_DAMAGE:
+    case EFFECT_FIXED_HP_DAMAGE:
+    case EFFECT_LEVEL_DAMAGE:
+    case EFFECT_PSYWAVE:
+    case EFFECT_REFLECT_DAMAGE:
+    case EFFECT_ENDEAVOR:
+    case EFFECT_FINAL_GAMBIT:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+// Moves whose type is decided in battle (Hidden Power by the IVs, Weather
+// Ball by the weather, ...), so their listed type says nothing about which
+// type-boosting item would help.
+static bool32 HasVariableType(u16 move)
+{
+    switch (GetMoveEffect(move))
+    {
+    case EFFECT_HIDDEN_POWER:
+    case EFFECT_WEATHER_BALL:
+    case EFFECT_NATURAL_GIFT:
+    case EFFECT_CHANGE_TYPE_ON_ITEM:
+    case EFFECT_REVELATION_DANCE:
+    case EFFECT_AURA_WHEEL:
+    case EFFECT_TERRAIN_PULSE:
+    case EFFECT_RAGING_BULL:
+    case EFFECT_IVY_CUDGEL:
+    case EFFECT_TERA_BLAST:
+    case EFFECT_TERA_STARSTORM:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+// Attacks whose damage scales with the user's Attack or Sp. Atk.
+static bool32 UsesAttackingStat(u16 move)
+{
+    return move != MOVE_NONE && IsDamagingMove(move) && !IsFixedDamageMove(move);
+}
+
+static void AssignRandomMoves(struct Pokemon *mon, u32 *rng)
+{
+    u16 moves[MAX_CANDIDATE_MOVES];
+    u8 count, numMoves, numDamaging, i, j;
+    u16 temp;
+
+    count = GetLearnableMoves(mon, moves);
+    numMoves = min(count, MAX_MON_MOVES);
+
+    // Partial Fisher-Yates shuffle: moves[0..numMoves) becomes a uniformly
+    // random selection without repeats.
+    for (i = 0; i < numMoves; i++)
+    {
+        j = i + TeamRandom(rng) % (count - i);
+        SWAP(moves[i], moves[j], temp);
+    }
+
+    // If none of the picks can deal damage, swap one of them for a random
+    // damaging move from the rest of the pool (if there is one).
+    for (i = 0; i < numMoves && !IsDamagingMove(moves[i]); i++)
+        ;
+    if (i == numMoves)
+    {
+        numDamaging = 0;
+        for (j = numMoves; j < count; j++)
+        {
+            if (IsDamagingMove(moves[j]))
+                numDamaging++;
+        }
+        if (numDamaging != 0)
+        {
+            u8 pick = TeamRandom(rng) % numDamaging;
+            for (j = numMoves; j < count; j++)
+            {
+                if (IsDamagingMove(moves[j]) && pick-- == 0)
+                    break;
+            }
+            i = TeamRandom(rng) % numMoves;
+            SWAP(moves[i], moves[j], temp);
+        }
+    }
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        SetMonMoveSlot(mon, i < numMoves ? moves[i] : MOVE_NONE, i);
+}
+
+static void AssignRandomItem(struct Pokemon *mon, u32 *rng)
+{
+    u16 items[ARRAY_COUNT(sBattleItems) + MAX_MON_MOVES];
+    u8 count = 0;
+    u8 i, j;
+    u16 move, item;
+
+    for (i = 0; i < ARRAY_COUNT(sBattleItems); i++)
+        items[count++] = sBattleItems[i];
+
+    // Type boosters only for types the Pokemon attacks with.
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        move = GetMonData(mon, MON_DATA_MOVE1 + i);
+        if (!UsesAttackingStat(move) || HasVariableType(move))
+            continue;
+        item = sTypeBoostItems[GetMoveType(move)];
+        for (j = 0; j < count && items[j] != item; j++)
+            ;
+        if (item != ITEM_NONE && j == count)
+            items[count++] = item;
+    }
+
+    item = items[TeamRandom(rng) % count];
+    SetMonData(mon, MON_DATA_HELD_ITEM, &item);
+}
+
+// When two stats have the same base value, the one listed first wins.
+static const u8 sEVStatPriority[NUM_STATS] = {STAT_ATK, STAT_SPATK, STAT_SPEED, STAT_HP, STAT_DEF, STAT_SPDEF};
+
+// Trains the Pokemon like RED's: 252 EVs into each of its two highest base
+// stats and the last 6 into HP (or its third-best stat if HP is one of the
+// two). Attack and Sp. Atk only count if one of its attacks uses them, which
+// each move's physical/special category decides. Needs the moves set.
+static void AssignFocusedEVs(struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u8 base[NUM_STATS];
+    bool8 usable[NUM_STATS] = {TRUE, FALSE, TRUE, TRUE, FALSE, TRUE};
+    u8 order[NUM_STATS];
+    u8 evs[NUM_STATS] = {0};
+    u8 count = 0;
+    u8 i, j, stat;
+    u16 move;
+
+    base[STAT_HP] = GetSpeciesBaseHP(species);
+    base[STAT_ATK] = GetSpeciesBaseAttack(species);
+    base[STAT_DEF] = GetSpeciesBaseDefense(species);
+    base[STAT_SPEED] = GetSpeciesBaseSpeed(species);
+    base[STAT_SPATK] = GetSpeciesBaseSpAttack(species);
+    base[STAT_SPDEF] = GetSpeciesBaseSpDefense(species);
+
+    // Status moves and fixed-damage moves don't use either stat.
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        move = GetMonData(mon, MON_DATA_MOVE1 + i);
+        if (!UsesAttackingStat(move))
+            continue;
+        if (GetMoveCategory(move) == DAMAGE_CATEGORY_PHYSICAL)
+            usable[STAT_ATK] = TRUE;
+        else
+            usable[STAT_SPATK] = TRUE;
+    }
+
+    // Usable stats from highest base stat to lowest (insertion sort, stable
+    // so ties keep sEVStatPriority order).
+    for (i = 0; i < NUM_STATS; i++)
+    {
+        stat = sEVStatPriority[i];
+        if (!usable[stat])
+            continue;
+        for (j = count; j > 0 && base[order[j - 1]] < base[stat]; j--)
+            order[j] = order[j - 1];
+        order[j] = stat;
+        count++;
+    }
+
+    evs[order[0]] = MAX_STAT_EV_POINTS;
+    evs[order[1]] = MAX_STAT_EV_POINTS;
+    stat = (order[0] != STAT_HP && order[1] != STAT_HP) ? STAT_HP : order[2];
+    evs[stat] = MAX_TOTAL_EV_POINTS - 2 * MAX_STAT_EV_POINTS;
+
+    for (stat = 0; stat < NUM_STATS; stat++)
+        SetMonData(mon, MON_DATA_HP_EV + stat, &evs[stat]);
+}
+
+// A level 100 Pokemon with a random personality, owned by the player
+// (OTID_STRUCT_PLAYER_ID). It has no moves until they're assigned.
+static void CreateTeamMon(struct Pokemon *mon, u16 species, u32 *rng)
+{
+    CreateMon(mon, species, MAX_LEVEL, TeamRandom32(rng), OTID_STRUCT_PLAYER_ID);
+}
+
+// IVs, EVs, held item and final stats, once the moves are set.
+static void FinishTeamMon(struct Pokemon *mon, u32 *rng)
+{
+    u8 metLocation = METLOC_FATEFUL_ENCOUNTER;
+    u8 fateful = TRUE;
+    u8 i, iv;
+
+    for (i = 0; i < NUM_STATS; i++)
+    {
+        iv = MIN_TEAM_IV + TeamRandom(rng) % (MAX_PER_STAT_IVS - MIN_TEAM_IV + 1);
+        SetMonData(mon, MON_DATA_HP_IV + i, &iv);
+    }
+    AssignFocusedEVs(mon);
+
+    // Event Pokemon like Mew and Deoxys, as Daily Red's have always been.
+    SetMonData(mon, MON_DATA_MODERN_FATEFUL_ENCOUNTER, &fateful);
+    SetMonData(mon, MON_DATA_MET_LOCATION, &metLocation);
+
+    CalculateMonStats(mon);
+    AssignRandomItem(mon, rng);
+}
+
+static void CreateRandomTeamMon(struct Pokemon *mon, u16 species, u32 *rng)
+{
+    CreateTeamMon(mon, species, rng);
+    AssignRandomMoves(mon, rng);
+    FinishTeamMon(mon, rng);
+}
+
+static bool32 IsValidTeamMon(struct Pokemon *mon)
+{
+    u16 moves[MAX_MON_MOVES];
+    u32 i, j;
+
+    if (!IsEligibleSpecies(GetMonData(mon, MON_DATA_SPECIES)))
+        return FALSE;
+    if (GetMonData(mon, MON_DATA_LEVEL) != MAX_LEVEL)
+        return FALSE;
+    if (GetMonData(mon, MON_DATA_MAX_HP) == 0 || GetMonData(mon, MON_DATA_HP) != GetMonData(mon, MON_DATA_MAX_HP))
+        return FALSE;
+
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        moves[i] = GetMonData(mon, MON_DATA_MOVE1 + i);
+    if (moves[0] == MOVE_NONE || GetMonData(mon, MON_DATA_HELD_ITEM) == ITEM_NONE)
+        return FALSE;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (moves[i] == MOVE_NONE)
+            continue;
+        if (GetMonData(mon, MON_DATA_PP1 + i) == 0)
+            return FALSE;
+        for (j = i + 1; j < MAX_MON_MOVES; j++)
+        {
+            if (moves[i] == moves[j])
+                return FALSE;
+        }
+    }
+    return TRUE;
+}
+
+void DailyRed_GenerateTeam(struct Pokemon *party, u32 *rngState)
+{
+    u16 species[PARTY_SIZE];
+    u8 i, attempt;
+
+    for (i = 0; i < PARTY_SIZE; i++)
+        ZeroMonData(&party[i]);
+
+    PickTeamSpecies(species, rngState);
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        for (attempt = 0; attempt < MAX_MON_ATTEMPTS; attempt++)
+        {
+            CreateRandomTeamMon(&party[i], species[i], rngState);
+            if (IsValidTeamMon(&party[i]))
+                break;
+        }
+
+        // Should never happen, but never hand the player a broken Pokemon:
+        // fall back to the game's own default level 100 moveset.
+        if (attempt == MAX_MON_ATTEMPTS)
+        {
+            CreateTeamMon(&party[i], species[i], rngState);
+            GiveMonInitialMoveset(&party[i]);
+            FinishTeamMon(&party[i], rngState);
+        }
+    }
+}
