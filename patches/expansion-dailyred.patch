+    sprite->x += sprite->tDriftSub >> 7;
+    sprite->tDriftSub &= 0x7F;
 
     x = (sprite->x + sprite->centerToCornerVecX + gSpriteCoordOffsetX) & 0x1FF;
     if (x & 0x100)
