+    },
+    {
+        .bg = 1,
+        .charBaseIndex = 2,
+        .mapBaseIndex = 19,
+        .screenSize = 0,
+        .paletteMode = 0,
+        .priority = 2,
+        .baseTile = 0,
+    },
+};
+
+static const struct WindowTemplate sWindowTemplates[] =
+{
+    [WIN_POKEMON_NAME] = {.bg = 0, .tilemapLeft = 1, .tilemapTop = 0, .width = 30, .height = 5, .paletteNum = TEXT_PAL, .baseBlock = 0},
+    [WIN_STATS] = {.bg = 0, .tilemapLeft = 1, .tilemapTop = 5, .width = 20, .height = 11, .paletteNum = TEXT_PAL, .baseBlock = 150},
+    [WIN_BOTTOM_BOX] = {.bg = 0, .tilemapLeft = 1, .tilemapTop = 16, .width = 30, .height = 5, .paletteNum = TEXT_PAL, .baseBlock = 370},
+    [WIN_HIDDEN_POWER] = {.bg = 0, .tilemapLeft = 15, .tilemapTop = 16, .width = 5, .height = 2, .paletteNum = TYPE_ICONS_PAL, .baseBlock = 520},
+    [WIN_TYPE] = {.bg = 0, .tilemapLeft = 0, .tilemapTop = 2, .width = 9, .height = 3, .paletteNum = TYPE_ICONS_PAL, .baseBlock = 530},
+    DUMMY_WIN_TEMPLATE
+};
+
+static const u8 sBallCoords[PARTY_SIZE][2] =
+{
+    {BALL_X, BALL_Y},
+    {BALL_X + BALL_SIZE, BALL_Y},
+    {BALL_X + BALL_SIZE * 2, BALL_Y},
+    {BALL_X, BALL_Y + BALL_SIZE},
+    {BALL_X + BALL_SIZE, BALL_Y + BALL_SIZE},
+    {BALL_X + BALL_SIZE * 2, BALL_Y + BALL_SIZE},
+};
+
+static void CB2_EvIv(void)
+{
+    RunTasks();
+    AnimateSprites();
+    BuildOamBuffer();
+    UpdatePaletteFade();
+}
+
+static void VBlankCB_EvIv(void)
+{
+    LoadOam();
+    ProcessSpriteCopyRequests();
+    TransferPlttBuffer();
+}
+
+void CB2_DailyRedEvIv(void)
+{
+    sEvIv = AllocZeroed(sizeof(*sEvIv));
+    sEvIv->partyCount = gPartiesCount[B_TRAINER_PLAYER];
+    if (sEvIv->partyCount == 0 || sEvIv->partyCount > PARTY_SIZE)
+        sEvIv->partyCount = PARTY_SIZE;
+    sEvIv->picTaskId = TASK_NONE;
+    ResetSpriteData();
+    ResetPaletteFade();
+    FreeAllSpritePalettes();
+    ResetTasks();
+    ScanlineEffect_Stop();
+    PlaySE(SE_RG_CARD_OPEN);
+    CreateTask(Task_EvIvInit, 0);
+    SetMainCallback2(CB2_EvIv);
+}
+
+static void InitDisplay(void)
+{
+    SetVBlankCallback(NULL);
+    DmaClearLarge16(3, (void *)VRAM, VRAM_SIZE, 0x1000);
+    DmaClear32(3, (void *)OAM, OAM_SIZE);
+    DmaClear16(3, (void *)PLTT, PLTT_SIZE);
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    ResetBgsAndClearDma3BusyFlags(0);
+    InitBgsFromTemplates(0, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+    for (u32 bg = 0; bg < 4; bg++)
+    {
+        ChangeBgX(bg, 0, BG_COORD_SET);
+        ChangeBgY(bg, 0, BG_COORD_SET);
+    }
+    InitWindows(sWindowTemplates);
+    DeactivateAllTextPrinters();
+    SetGpuReg(REG_OFFSET_WIN0H, 0);
+    SetGpuReg(REG_OFFSET_WIN0V, 0);
+    SetGpuReg(REG_OFFSET_WININ, 0);
+    SetGpuReg(REG_OFFSET_WINOUT, 0);
+    SetGpuReg(REG_OFFSET_BLDCNT, 0);
+    SetGpuReg(REG_OFFSET_BLDALPHA, 0);
+    SetGpuReg(REG_OFFSET_BLDY, 0);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_OBJ_1D_MAP | DISPCNT_OBJ_ON);
+    SetBgTilemapBuffer(1, sEvIv->tilemapBuffer);
+    ShowBg(0);
+    ShowBg(1);
+    FillBgTilemapBufferRect_Palette0(0, 0, 0, 0, 30, 20);
+    FillBgTilemapBufferRect_Palette0(1, 0, 0, 0, 30, 20);
+}
+
+static void LoadBalls(void)
+{
+    for (u32 i = 0; i < sEvIv->partyCount; i++)
+    {
+        enum PokeBall ballId = ItemIdToBallId(GetMonData(&gParties[B_TRAINER_PLAYER][i], MON_DATA_POKEBALL));
+        u8 spriteId;
+
+        LoadBallGfx(ballId);
+        spriteId = CreateSprite(&gPokeBalls[ballId].spriteTemplate, sBallCoords[i][0], sBallCoords[i][1], 0);
+        gSprites[spriteId].callback = SpriteCallbackDummy;
+        gSprites[spriteId].oam.priority = 0;
+        StartSpriteAnim(&gSprites[spriteId], BALL_ANIM_CLOSED);
+        sEvIv->ballSpriteIds[i] = spriteId;
+    }
+}
+
+static void Task_EvIvInit(u8 taskId)
+{
+    switch (sEvIv->callbackStep)
+    {
+    case 0:
+        InitDisplay();
+        break;
+    case 1:
+        LoadBgTiles(1, sEvIv_Gfx, sizeof(sEvIv_Gfx), 0);
+        LoadPalette(sEvIv_Pal, BG_PLTT_ID(0), PLTT_SIZE_4BPP);
+        LoadPalette(sTextPal, BG_PLTT_ID(TEXT_PAL), sizeof(sTextPal));
+        ListMenuLoadStdPalAt(BG_PLTT_ID(TYPE_ICONS_PAL), 1);
+        break;
+    case 2:
+        CopyToBgTilemapBuffer(1, sEvIv_Tilemap, sizeof(sEvIv_Tilemap), 0);
+        break;
+    case 3:
+        LoadBalls();
+        ShowMon();
+        break;
+    case 4:
+        CopyBgTilemapBufferToVram(0);
+        CopyBgTilemapBufferToVram(1);
+        break;
+    case 5:
+        BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+        SetVBlankCallback(VBlankCB_EvIv);
+        break;
+    default:
+        if (!gPaletteFade.active)
+            gTasks[taskId].func = Task_EvIvInput;
+        return;
+    }
+    sEvIv->callbackStep++;
+}
+
+// The Pokemon's picture jumps in from the right in two hops.
+#define tState data[0]
+#define tSpriteId data[1]
+#define tFrame data[2]
+
+static void Task_MonPic(u8 taskId)
+{
+    struct Task *task = &gTasks[taskId];
+    struct Sprite *sprite = &gSprites[task->tSpriteId];
+    s16 f = task->tFrame;
+
+    switch (task->tState)
+    {
+    case 0:
+        if (f < JUMP_FRAMES)
+        {
+            static const s8 sHop[] = {0, 1, 2, 3, -3, -2, -1, 0, 1, 2, 3};
+            static const u8 sUntil[] = {10, 18, 24, 28, 30, 32, 36, 40, 44, 46, 48};
+            u32 i = 0;
+
+            while (f >= sUntil[i])
+                i++;
+            sprite->y += sHop[i];
+            sprite->x -= 1;
+            task->tFrame++;
+        }
+        break;
+    case 1: // replaced by the next Pokemon's
+        FreeAndDestroyMonPicSprite(task->tSpriteId);
+        DestroyTask(taskId);
+        break;
+    }
+}
+
+static void ShowMonPic(struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u16 spriteId;
+    u8 taskId;
+
+    // The expansion loads the picture's palette tagged with the species.
+    spriteId = CreateMonPicSprite(species, IsMonShiny(mon), GetMonData(mon, MON_DATA_PERSONALITY), TRUE,
+                                  PIC_X + JUMP_FRAMES, PIC_Y - 32, 0, species);
+    if (spriteId == 0xFFFF)
+        return;
+    gSprites[spriteId].callback = SpriteCallbackDummy;
+    gSprites[spriteId].oam.priority = 0;
+    taskId = CreateTask(Task_MonPic, 80);
+    gTasks[taskId].tSpriteId = spriteId;
+    sEvIv->picTaskId = taskId;
+    PlayCry_Normal(species, 0);
+}
+
+// On leaving the screen: free every picture still up (the shown one, and one
+// just replaced whose task hasn't run yet), or each visit leaks its 8 KB frame
+// buffer and the heap runs out later.
+static void FreeMonPics(void)
+{
+    u32 i;
+    for (i = 0; i < NUM_TASKS; i++)
+    {
+        if (gTasks[i].isActive && gTasks[i].func == Task_MonPic)
+        {
+            FreeAndDestroyMonPicSprite(gTasks[i].tSpriteId);
+            DestroyTask(i);
+        }
+    }
+    sEvIv->picTaskId = TASK_NONE;
+}
+
+static void HideMonPic(void)
+{
+    if (sEvIv->picTaskId != TASK_NONE)
+        gTasks[sEvIv->picTaskId].tState = 1;
+    sEvIv->picTaskId = TASK_NONE;
+}
+
+static void PrintStats(struct Pokemon *mon)
+{
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u8 nature = GetNature(mon);
+    u32 totalBs = 0, totalEv = 0;
+    u32 hpTypeBits = 0;
+
+    AddTextPrinterParameterized3(WIN_POKEMON_NAME, FONT_NORMAL, BS_X, 22, sTextColor_Gray, TEXT_SKIP_DRAW, sText_BsEvIv);
+    GetMonNickname(mon, gStringVar4);
+    AddTextPrinterParameterized3(WIN_POKEMON_NAME, FONT_NORMAL, 0, 2, IsMonShiny(mon) ? sTextColor_Shiny : sTextColor_Gray, TEXT_SKIP_DRAW, gStringVar4);
+    if (species != SPECIES_NIDORAN_M && species != SPECIES_NIDORAN_F)
+    {
+        switch (GetMonGender(mon))
+        {
+        case MON_MALE:
+            AddTextPrinterParameterized3(WIN_POKEMON_NAME, FONT_NORMAL, 58, 3, sTextColor_Blue, TEXT_SKIP_DRAW, sText_Male);
+            break;
+        case MON_FEMALE:
+            AddTextPrinterParameterized3(WIN_POKEMON_NAME, FONT_NORMAL, 58, 3, sTextColor_Red, TEXT_SKIP_DRAW, sText_Female);
+            break;
+        }
+    }
+
+    for (u32 row = 0; row < NUM_STATS; row++)
+    {
+        u8 stat = sStatRows[row];
+        u8 bs = GetSpeciesBaseStat(species, stat);
+        u8 ev = GetMonData(mon, sStatEvData[stat]);
+        u8 iv = GetMonData(mon, sStatIvData[stat]);
+        const u8 *color = sTextColor_Black;
+
+        if (gNaturesInfo[nature].statUp != gNaturesInfo[nature].statDown)
+        {
+            if (stat == gNaturesInfo[nature].statUp)
+            {
+                color = sTextColor_Red;
+                AddTextPrinterParameterized3(WIN_STATS, FONT_NORMAL, BS_X - 14, ROW_Y(row), sTextColor_Red, TEXT_SKIP_DRAW, sText_ArrowUp);
+            }
+            else if (stat == gNaturesInfo[nature].statDown)
+            {
+                color = sTextColor_Blue;
+                AddTextPrinterParameterized3(WIN_STATS, FONT_NORMAL, BS_X - 14, ROW_Y(row), sTextColor_Blue, TEXT_SKIP_DRAW, sText_ArrowDown);
+            }
+        }
+        AddTextPrinterParameterized3(WIN_STATS, FONT_NORMAL, NAME_X, ROW_Y(row), sTextColor_Black, TEXT_SKIP_DRAW, sStatNames[stat]);
+        ConvertIntToDecimalStringN(gStringVar1, bs, STR_CONV_MODE_RIGHT_ALIGN, 3);
+        ConvertIntToDecimalStringN(gStringVar2, ev, STR_CONV_MODE_RIGHT_ALIGN, 3);
+        ConvertIntToDecimalStringN(gStringVar3, iv, STR_CONV_MODE_RIGHT_ALIGN, 2);
+        AddTextPrinterParameterized3(WIN_STATS, FONT_NORMAL, BS_X, ROW_Y(row), color, TEXT_SKIP_DRAW, gStringVar1);
+        AddTextPrinterParameterized3(WIN_STATS, FONT_NORMAL, EV_X, ROW_Y(row), color, TEXT_SKIP_DRAW, gStringVar2);
+        AddTextPrinterParameterized3(WIN_STATS, FONT_NORMAL, IV_X, ROW_Y(row), color, TEXT_SKIP_DRAW, gStringVar3);
+        totalBs += bs;
+        totalEv += ev;
+    }
+
+    // Hidden Power's type, as battles work it out.
+    hpTypeBits = ((GetMonData(mon, MON_DATA_HP_IV) & 1) << 0)
+               | ((GetMonData(mon, MON_DATA_ATK_IV) & 1) << 1)
+               | ((GetMonData(mon, MON_DATA_DEF_IV) & 1) << 2)
+               | ((GetMonData(mon, MON_DATA_SPEED_IV) & 1) << 3)
+               | ((GetMonData(mon, MON_DATA_SPATK_IV) & 1) << 4)
+               | ((GetMonData(mon, MON_DATA_SPDEF_IV) & 1) << 5);
+    {
+        enum Type hpTypes[NUMBER_OF_MON_TYPES];
+        u32 count = 0;
+
+        for (u32 i = 0; i < NUMBER_OF_MON_TYPES; i++)
+        {
+            if (gTypesInfo[i].isHiddenPowerType)
+                hpTypes[count++] = i;
+        }
+        if (count != 0)
+            BlitMenuInfoIcon(WIN_HIDDEN_POWER, hpTypes[((count - 1) * hpTypeBits) / 63] + 1, 3, 2);
+    }
+
+    BlitMenuInfoIcon(WIN_TYPE, GetSpeciesType(species, 0) + 1, 1, 4);
+    if (GetSpeciesType(species, 0) != GetSpeciesType(species, 1))
+        BlitMenuInfoIcon(WIN_TYPE, GetSpeciesType(species, 1) + 1, 35, 4);
+
+    AddTextPrinterParameterized3(WIN_BOTTOM_BOX, FONT_NORMAL, 6, 1, sTextColor_Black, TEXT_SKIP_DRAW, sText_Total);
+    ConvertIntToDecimalStringN(gStringVar1, totalBs, STR_CONV_MODE_RIGHT_ALIGN, 3);
+    ConvertIntToDecimalStringN(gStringVar2, totalEv, STR_CONV_MODE_RIGHT_ALIGN, 3);
+    AddTextPrinterParameterized3(WIN_BOTTOM_BOX, FONT_NORMAL, BS_X + 1, 1, sTextColor_Black, TEXT_SKIP_DRAW, gStringVar1);
+    AddTextPrinterParameterized3(WIN_BOTTOM_BOX, FONT_NORMAL, EV_X + 1, 1, sTextColor_Black, TEXT_SKIP_DRAW, gStringVar2);
+
+    ConvertIntToDecimalStringN(gStringVar4, GetMonData(mon, MON_DATA_LEVEL), STR_CONV_MODE_LEFT_ALIGN, 3);
+    AddTextPrinterParameterized3(WIN_BOTTOM_BOX, FONT_NORMAL, 187, 5, IsMonShiny(mon) ? sTextColor_Shiny : sTextColor_Gray, TEXT_SKIP_DRAW, sText_Level);
+    AddTextPrinterParameterized3(WIN_BOTTOM_BOX, FONT_NORMAL, 208, 5, IsMonShiny(mon) ? sTextColor_Shiny : sTextColor_Gray, TEXT_SKIP_DRAW, gStringVar4);
+    AddTextPrinterParameterized3(WIN_BOTTOM_BOX, FONT_NORMAL, 187, 17, sTextColor_Gray, TEXT_SKIP_DRAW, gNaturesInfo[nature].name);
+
+    StringCopy(gStringVar4, GetSpeciesName(species));
+    StringAppend(gStringVar4, sText_Is);
+    ConvertIntToDecimalStringN(gStringVar2, GetMonData(mon, MON_DATA_FRIENDSHIP) * 100 / 255, STR_CONV_MODE_LEFT_ALIGN, 3);
+    StringAppend(gStringVar4, gStringVar2);
+    StringAppend(gStringVar4, sText_Happy);
+    AddTextPrinterParameterized3(WIN_BOTTOM_BOX, FONT_NORMAL, 6, 17, sTextColor_Black, TEXT_SKIP_DRAW, gStringVar4);
+}
+
+static void ShowMon(void)
+{
+    struct Pokemon *mon = &gParties[B_TRAINER_PLAYER][sEvIv->currentMon];
+
+    for (u32 win = 0; win <= WIN_TYPE; win++)
+        FillWindowPixelBuffer(win, PIXEL_FILL(0));
+    PrintStats(mon);
+    for (u32 win = 0; win <= WIN_TYPE; win++)
+    {
+        PutWindowTilemap(win);
+        CopyWindowToVram(win, COPYWIN_FULL);
+    }
+    StartSpriteAnim(&gSprites[sEvIv->ballSpriteIds[sEvIv->currentMon]], BALL_ANIM_OPEN);
+    ShowMonPic(mon);
+}
+
+static void ChangeMon(u8 newMon)
+{
+    if (newMon == sEvIv->currentMon)
+        return;
+    PlaySE(SE_BALL_OPEN);
+    StartSpriteAnim(&gSprites[sEvIv->ballSpriteIds[sEvIv->currentMon]], BALL_ANIM_CLOSED);
+    sEvIv->currentMon = newMon;
+    HideMonPic();
+    ShowMon();
+}
+
+static void Task_EvIvInput(u8 taskId)
+{
+    u8 count = sEvIv->partyCount;
+    u8 cur = sEvIv->currentMon;
+
+    switch (sEvIv->state)
+    {
+    case 0:
+        if (JOY_REPEAT(DPAD_RIGHT))
+            ChangeMon(cur == count - 1 ? 0 : cur + 1);
+        else if (JOY_REPEAT(DPAD_LEFT))
+            ChangeMon(cur == 0 ? count - 1 : cur - 1);
+        else if (JOY_REPEAT(DPAD_UP | DPAD_DOWN))
+        {
+            if (cur > 2)
+                ChangeMon(cur - 3);
+            else if (count > cur + 3)
+                ChangeMon(cur + 3);
+        }
+        else if (JOY_NEW(A_BUTTON))
+        {
+            PlayCry_Normal(GetMonData(&gParties[B_TRAINER_PLAYER][cur], MON_DATA_SPECIES), 0);
+        }
+        else if (JOY_NEW(B_BUTTON))
+        {
+            PlaySE(SE_RG_CARD_FLIP);
+            BeginNormalPaletteFade(PALETTES_ALL, 0, 0, 16, RGB_BLACK);
+            sEvIv->state++;
+        }
+        break;
+    case 1:
+        if (gPaletteFade.active || IsCryPlaying())
+            break;
+        FreeMonPics();
+        DestroyTask(taskId);
+        FreeAllWindowBuffers();
+        FREE_AND_SET_NULL(sEvIv);
+        SetMainCallback2(gMain.savedCallback);
+        break;
+    }
+}
diff --git a/src/dailyred_mon.c b/src/dailyred_mon.c
new file mode 100644
index 00000000..a8af713b
--- /dev/null
+++ b/src/dailyred_mon.c
@@ -0,0 +1,182 @@
+#include "global.h"
+#include "dailyred.h"
+#include "data.h"
+#include "pokemon.h"
+#include "random.h"
+#include "trainer_util.h"
+#include "constants/items.h"
+#include "constants/pokeball.h"
+#include "constants/region_map_sections.h"
+
+// Daily Red's Pokemon, the player's and RED's, come from the generated set
+// table (src/dailyred_sets.c, see dailyred.h). These are the helpers both
+// team builders share.
+
+// The team builders' RNG (each team has its own state, see dailyred.c).
+u16 DailyRed_Random(u32 *rng)
+{
+    *rng = ISO_RANDOMIZE1(*rng);
+    return *rng >> 16;
+}
+
+u32 DailyRed_Random32(u32 *rng)
+{
+    u32 lo = DailyRed_Random(rng);
+    return lo | ((u32)DailyRed_Random(rng) << 16);
+}
+
+// The species' list of sets of that kind, or NULL if it has none.
+const struct DailyRedSetList *DailyRed_FindSetList(u16 species, u8 kind)
+{
+    u32 i;
+    for (i = 0; i < gDailyRedNumSetLists; i++)
+    {
+        if (gDailyRedSetLists[i].species == species && gDailyRedSetLists[i].kind == kind)
+            return &gDailyRedSetLists[i];
+    }
+    return NULL;
+}
+
+// One of a list's sets, with Showdown's odds.
+const struct DailyRedSet *DailyRed_PickSet(const struct DailyRedSetList *list, u32 *rng)
+{
+    u32 i, total = 0, roll;
+    const struct DailyRedSet *sets = &gDailyRedSets[list->firstSet];
+
+    for (i = 0; i < list->numSets; i++)
+        total += sets[i].weight;
+    roll = DailyRed_Random(rng) % total;
+    for (i = 0; i < list->numSets - 1; i++)
+    {
+        if (roll < sets[i].weight)
+            break;
+        roll -= sets[i].weight;
+    }
+    return &sets[i];
+}
+
+u32 DailyRed_GetTypeMask(u16 species)
+{
+    return (1u << GetSpeciesType(species, 0)) | (1u << GetSpeciesType(species, 1));
+}
+
+// --- Team limits (both teams) -------------------------------------------------
+// Items: one item may be held by two of the six, every other by one at most.
+// Types: one type may be shared by two of the six, every other type is on one
+// at most (a Mega's types count with its base form's).
+
+// Whether one more Pokemon can hold `item`, given the `count` items already
+// on the team.
+bool32 DailyRed_ItemFits(const u16 *items, u32 count, u16 item)
+{
+    u32 i, j, held = 0;
+    bool32 hasPair = FALSE;
+
+    if (item == ITEM_NONE)
+        return TRUE;
+    for (i = 0; i < count; i++)
+    {
+        if (items[i] == item)
+            held++;
+        for (j = i + 1; j < count; j++)
+        {
+            if (items[i] != ITEM_NONE && items[i] == items[j])
+                hasPair = TRUE;
+        }
+    }
+    return held == 0 || (held == 1 && !hasPair);
+}
+
+// One of a list's sets whose item fits the team (ItemFits), with Showdown's
+// odds among them; NULL if none fits.
+const struct DailyRedSet *DailyRed_PickFittingSet(const struct DailyRedSetList *list, const u16 *items, u32 count, u32 *rng)
+{
+    u32 i, total = 0, roll;
+    const struct DailyRedSet *sets = &gDailyRedSets[list->firstSet];
+
+    for (i = 0; i < list->numSets; i++)
+    {
+        if (DailyRed_ItemFits(items, count, sets[i].item))
+            total += sets[i].weight;
+    }
+    if (total == 0)
+        return NULL;
+    roll = DailyRed_Random(rng) % total;
+    for (i = 0; i < list->numSets; i++)
+    {
+        if (!DailyRed_ItemFits(items, count, sets[i].item))
+            continue;
+        if (roll < sets[i].weight)
+            return &sets[i];
+        roll -= sets[i].weight;
+    }
+    return NULL;
+}
+
+bool32 DailyRed_HasFittingSet(const struct DailyRedSetList *list, const u16 *items, u32 count)
+{
+    u32 i;
+    for (i = 0; i < list->numSets; i++)
+    {
+        if (DailyRed_ItemFits(items, count, gDailyRedSets[list->firstSet + i].item))
+            return TRUE;
+    }
+    return FALSE;
+}
+
+// Whether a Pokemon of these types (typeMask) can join a team whose types are
+// counted in typeCounts: no type on a third Pokemon, and no second shared type
+// (if the team already has two, it can't get worse).
+bool32 DailyRed_TypesFit(const u8 *typeCounts, u32 typeMask)
+{
+    u32 type, pairs = 0, newPairs = 0;
+
+    for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+    {
+        if (typeCounts[type] >= 2)
+            pairs++;
+        if (!(typeMask & (1u << type)))
+            continue;
+        if (typeCounts[type] >= 2)
+            return FALSE;
+        if (typeCounts[type] == 1)
+            newPairs++;
+    }
+    return newPairs == 0 || pairs + newPairs <= 1;
+}
+
+// Creates a Pokemon from a set: the set's species, moves, item, ability,
+// nature, EVs and friendship, perfect stats (every IV maxed by hyper training;
+// the real IVs keep Hidden Power's type), and Terastallization only for a Tera
+// set. gender is a TRAINER_MON_* value.
+void DailyRed_CreateSetMon(struct Pokemon *mon, const struct DailyRedSet *set, u8 level, u8 gender, bool8 shiny, struct TrainerGenerator *trainerGen)
+{
+    struct TrainerMon trainerMon = {0};
+    u32 i, data;
+
+    trainerMon.species = set->species;
+    trainerMon.heldItem = set->item;
+    trainerMon.ability = set->ability;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        trainerMon.moves[i] = set->moves[i];
+    trainerMon.ev = set->evs;
+    trainerMon.iv = set->ivs;
+    trainerMon.lvl = level;
+    trainerMon.nature = set->nature;
+    trainerMon.gender = gender;
+    trainerMon.friendship = set->friendship;
+    trainerMon.isShiny = shiny;
+    trainerMon.ball = BALL_POKE;
+    trainerMon.teraType = set->teraType;
+    GenerateMonFromTrainerMon(mon, &trainerMon, trainerGen);
+
+    data = TRUE;
+    for (i = 0; i < NUM_STATS; i++)
+        SetMonData(mon, MON_DATA_HYPER_TRAINED_HP + i, &data);
+    if (set->teraType == TYPE_NONE)
+    {
+        data = TYPE_MYSTERY;
+        SetMonData(mon, MON_DATA_TERA_TYPE, &data);
+    }
+    CalculateMonStats(mon);
+}
diff --git a/src/dailyred_red.c b/src/dailyred_red.c
new file mode 100644
index 00000000..70b6a825
--- /dev/null
+++ b/src/dailyred_red.c
@@ -0,0 +1,626 @@
+#include "global.h"
+#include "dailyred.h"
+#include "battle.h"
+#include "battle_gfx_sfx_util.h"
+#include "sprite.h"
+#include "data.h"
+#include "pokemon.h"
+#include "random.h"
+#include "trainer_util.h"
+#include "constants/items.h"
+#include "constants/moves.h"
+#include "constants/opponents.h"
+#include "constants/pokeball.h"
+#include "constants/species.h"
+#include "constants/trainers.h"
+
+// RED's team for Daily Red, built at the start of each run (with the player's
+// team) into gDailyRedRedParty, which CreateNPCTrainerParty copies into the
+// battle (battle_setup.c). Every Pokemon gets one of its Pokemon Showdown
+// Random Battle sets (src/dailyred_sets.c) and perfect stats: all IVs maxed by
+// hyper training (the real IVs keep Hidden Power's type), with the set's
+// nature and EVs.
+//
+// On most days (see "RED's team" in the project README):
+//   - A Kanto starter: Venusaur, Charizard or Blastoise, holding its Mega
+//     Stone (Charizard X or Y), level 99.
+//   - Pikachu with a Light Ball and Volt Tackle, level 100. On
+//     CAP_PIKACHU_ODDS% of these days it's a Pikachu in one of Ash's caps
+//     instead, holding a Pikanium Z (Catastropika) and leading, and its
+//     totem aura raises all five of its stats by one stage as the battle
+//     starts (DailyRed_QueueRedTotemBoost).
+//   - A legendary, level 99, picked by the starter: usually its bird
+//     (Venusaur: Moltres, Charizard: Articuno, Blastoise: Zapdos), sometimes
+//     the Galarian bird, the Johto dog (Entei, Suicune, Raikou), Mewtwo,
+//     Deoxys (any forme), Mew (sometimes shiny), or, rarest, Mega Mewtwo X
+//     or Y. On a Mega Mewtwo day the starter holds
+//     a Z-Crystal instead of its Mega Stone. Any legendary but Mega Mewtwo
+//     and the Galarian birds (Gen 8, no Z-Moves) may hold a Z-Crystal if its
+//     set does. On capped-Pikachu days Pikachu has his one Z-Move, so the
+//     legendary never holds a Z-Crystal, and the Mega Mewtwo day starter
+//     gets a regular set.
+//   - Two of sRedPool and one fully evolved Pokemon from a Gen 1 family
+//     (gDailyRedPickGroups: Gen 1 Pokemon and their later evolutions, no
+//     starters, Pikachu's family, legendaries or mythicals), level 96, never
+//     holding a Mega Stone or Z-Crystal. No two of these three share a type,
+//     and the team has at most one Eeveelution.
+//   - He leads with Pikachu or one of those three: one that sets entry
+//     hazards (Stealth Rock, Spikes...) if any does, otherwise at random (his
+//     capped Pikachu always leads).
+// On ORIGINAL_TEAM_ODDS% of days ("HGSS days") he has his original team
+// instead, all level 100: Pikachu (never capped), Espeon or Lapras, Snorlax,
+// Venusaur, Charizard and Blastoise. The three starters share out a Mega
+// Evolution, a Z-Crystal and a Tera type at random, each with that gimmick's
+// sets (Gen 7 for Mega and Z, Gen 9 for Tera). Pikachu always leads, as in
+// HGSS.
+//
+// Every day the team limits apply (DailyRed_ItemFits and DailyRed_TypesFit,
+// for both teams): one item may be held by two of his six and every other by
+// one at most, and one type may be shared by two of them and no other type
+// (a Mega's types count with its base form's). A set whose item doesn't fit
+// gives way to another of the species' sets; a pick with none that fits is
+// passed over.
+//
+// All his Pokemon are male, except the Eeveelutions, Lapras and Gyarados
+// (female) and species with a fixed gender (or none). Only the Tera starter
+// can Terastallize; nothing Dynamaxes.
+//
+// It draws from its own RNG state (see dailyred.c), so a seed always gives the
+// same RED. Its first four draws are always the day's original-team roll, the
+// starter, the legendary roll and the capped-Pikachu roll (tests/red.mjs
+// predicts them).
+
+// Odds, in percent. Raise or lower them to taste; the legendary ones must add
+// up to at most 100 (the rest is the starter's own bird).
+#define ORIGINAL_TEAM_ODDS  5
+#define MEGA_MEWTWO_ODDS    2
+#define MEW_ODDS            5 // includes SHINY_MEW_ODDS
+#define SHINY_MEW_ODDS      1
+#define DEOXYS_ODDS         5
+#define MEWTWO_ODDS        10
+#define GALARIAN_BIRD_ODDS 15
+#define JOHTO_DOG_ODDS     20
+#define CAP_PIKACHU_ODDS   10 // of the days with his usual team
+
+#define LEVEL_PIKACHU       100
+#define LEVEL_STARTER       99
+#define LEVEL_LEGENDARY     99
+#define LEVEL_MEWTWO        99  // Mewtwo and Mega Mewtwo
+#define LEVEL_PICK          96
+#define LEVEL_ORIGINAL_TEAM 100
+
+#define MAX_PICK_ATTEMPTS  500
+
+enum
+{
+    STARTER_VENUSAUR,
+    STARTER_CHARIZARD,
+    STARTER_BLASTOISE,
+    NUM_STARTERS,
+};
+
+enum
+{
+    LEGENDARY_BIRD,
+    LEGENDARY_GALARIAN_BIRD,
+    LEGENDARY_JOHTO_DOG,
+    LEGENDARY_MEWTWO,
+    LEGENDARY_DEOXYS,
+    LEGENDARY_MEW,
+    LEGENDARY_SHINY_MEW,
+    LEGENDARY_MEGA_MEWTWO,
+};
+
+struct RedStarter
+{
+    u16 species;
+    u16 megas[2]; // Mega formes (Charizard has two)
+    u16 bird;
+    u16 galarianBird;
+    u16 johtoDog;
+};
+
+static const struct RedStarter sRedStarters[NUM_STARTERS] =
+{
+    [STARTER_VENUSAUR]  = {SPECIES_VENUSAUR,  {SPECIES_VENUSAUR_MEGA,    SPECIES_VENUSAUR_MEGA},    SPECIES_MOLTRES,  SPECIES_MOLTRES_GALAR,  SPECIES_ENTEI},
+    [STARTER_CHARIZARD] = {SPECIES_CHARIZARD, {SPECIES_CHARIZARD_MEGA_X, SPECIES_CHARIZARD_MEGA_Y}, SPECIES_ARTICUNO, SPECIES_ARTICUNO_GALAR, SPECIES_SUICUNE},
+    [STARTER_BLASTOISE] = {SPECIES_BLASTOISE, {SPECIES_BLASTOISE_MEGA,   SPECIES_BLASTOISE_MEGA},   SPECIES_ZAPDOS,   SPECIES_ZAPDOS_GALAR,   SPECIES_RAIKOU},
+};
+
+static const u16 sDeoxysFormes[] = {SPECIES_DEOXYS_NORMAL, SPECIES_DEOXYS_ATTACK, SPECIES_DEOXYS_DEFENSE, SPECIES_DEOXYS_SPEED};
+
+// RED's own Pokemon (from the games and Pokemon Adventures), for two of the
+// three picks.
+static const u16 sRedPool[] =
+{
+    SPECIES_POLIWRATH, SPECIES_GYARADOS, SPECIES_AERODACTYL, SPECIES_LAPRAS, SPECIES_SNORLAX,
+    SPECIES_VAPOREON, SPECIES_JOLTEON, SPECIES_FLAREON, SPECIES_ESPEON, SPECIES_UMBREON,
+    SPECIES_LEAFEON, SPECIES_GLACEON, SPECIES_SYLVEON, SPECIES_HITMONLEE, SPECIES_KABUTOPS,
+    SPECIES_VICTREEBEL, SPECIES_MACHAMP, SPECIES_ARCANINE, SPECIES_GENGAR,
+};
+
+static const u16 sEeveelutions[] =
+{
+    SPECIES_VAPOREON, SPECIES_JOLTEON, SPECIES_FLAREON, SPECIES_ESPEON,
+    SPECIES_UMBREON, SPECIES_LEAFEON, SPECIES_GLACEON, SPECIES_SYLVEON,
+};
+
+static const u16 sFemaleSpecies[] = {SPECIES_LAPRAS, SPECIES_GYARADOS}; // and the Eeveelutions
+
+// Pikachu in Ash's caps, for his capped-Pikachu days.
+static const u16 sCapPikachus[] =
+{
+    SPECIES_PIKACHU_ORIGINAL, SPECIES_PIKACHU_HOENN, SPECIES_PIKACHU_SINNOH, SPECIES_PIKACHU_UNOVA,
+    SPECIES_PIKACHU_KALOS, SPECIES_PIKACHU_ALOLA, SPECIES_PIKACHU_PARTNER, SPECIES_PIKACHU_WORLD,
+};
+
+static const u16 sHazardMoves[] =
+{
+    MOVE_STEALTH_ROCK, MOVE_SPIKES, MOVE_TOXIC_SPIKES, MOVE_STICKY_WEB, MOVE_STONE_AXE, MOVE_CEASELESS_EDGE,
+};
+
+// Original-team days: which starter gets which gimmick.
+static const u8 sGimmickOrders[][NUM_STARTERS] =
+{
+    {DAILYRED_SETS_MEGA,  DAILYRED_SETS_ZMOVE, DAILYRED_SETS_TERA},
+    {DAILYRED_SETS_MEGA,  DAILYRED_SETS_TERA,  DAILYRED_SETS_ZMOVE},
+    {DAILYRED_SETS_ZMOVE, DAILYRED_SETS_MEGA,  DAILYRED_SETS_TERA},
+    {DAILYRED_SETS_ZMOVE, DAILYRED_SETS_TERA,  DAILYRED_SETS_MEGA},
+    {DAILYRED_SETS_TERA,  DAILYRED_SETS_MEGA,  DAILYRED_SETS_ZMOVE},
+    {DAILYRED_SETS_TERA,  DAILYRED_SETS_ZMOVE, DAILYRED_SETS_MEGA},
+};
+
+struct RedMember
+{
+    const struct DailyRedSet *set;
+    u16 species;   // the species to create: the set's, or a capped Pikachu
+    u32 typeMask;  // its types, and its Mega forme's
+    u16 baseSpecies;
+    u8 level;
+    bool8 shiny;
+};
+
+struct RedTeam
+{
+    struct RedMember members[PARTY_SIZE];
+    u8 count;
+    u8 typeCounts[NUMBER_OF_MON_TYPES];
+    u32 picksTypeMask; // types of the picks so far
+    bool8 hasEeveelution;
+};
+
+EWRAM_DATA struct Pokemon gDailyRedRedParty[PARTY_SIZE] = {0};
+
+#define RedRandom   DailyRed_Random
+#define RedRandom32 DailyRed_Random32
+
+static bool32 IsInList(u16 value, const u16 *list, u32 count)
+{
+    u32 i;
+    for (i = 0; i < count; i++)
+    {
+        if (list[i] == value)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static bool32 IsEeveelution(u16 species)
+{
+    return IsInList(GET_BASE_SPECIES_ID(species), sEeveelutions, ARRAY_COUNT(sEeveelutions));
+}
+
+#define GetTypeMask DailyRed_GetTypeMask
+#define PickSet     DailyRed_PickSet
+
+// RED's lists all exist (the generator builds them); NORMAL is the fallback.
+static const struct DailyRedSetList *FindSetList(u16 species, u8 kind)
+{
+    const struct DailyRedSetList *list = DailyRed_FindSetList(species, kind);
+    if (list == NULL)
+        list = DailyRed_FindSetList(species, DAILYRED_SETS_NORMAL);
+    if (list == NULL)
+    {
+        errorf("Daily Red: no sets for species %d", species);
+        list = &gDailyRedSetLists[0];
+    }
+    return list;
+}
+
+// The items the team holds so far; returns how many.
+static u32 GetTeamItems(const struct RedTeam *team, u16 *items)
+{
+    u32 i;
+    for (i = 0; i < team->count; i++)
+        items[i] = team->members[i].set->item;
+    return team->count;
+}
+
+// Adds a Pokemon with one of the list's sets whose item fits the team (the
+// fixed members, which come first, take any set if none does).
+static void AddMember(struct RedTeam *team, const struct DailyRedSetList *list, u8 level, bool8 shiny, u32 *rng)
+{
+    u16 items[PARTY_SIZE];
+    u32 count = GetTeamItems(team, items);
+    struct RedMember *member = &team->members[team->count++];
+    u32 type;
+
+    member->set = DailyRed_PickFittingSet(list, items, count, rng);
+    if (member->set == NULL)
+        member->set = PickSet(list, rng);
+    member->species = member->set->species;
+    member->typeMask = GetTypeMask(list->species) | GetTypeMask(member->set->species);
+    member->baseSpecies = GET_BASE_SPECIES_ID(member->set->species);
+    member->level = level;
+    member->shiny = shiny;
+    for (type = 0; type < NUMBER_OF_MON_TYPES; type++)
+    {
+        if (member->typeMask & (1u << type))
+            team->typeCounts[type]++;
+    }
+    if (IsEeveelution(member->baseSpecies))
+        team->hasEeveelution = TRUE;
+}
+
+// Whether a species (its list of sets) can be one of the three picks (see
+// the rules at the top).
+static bool32 CanPick(const struct RedTeam *team, const struct DailyRedSetList *list)
+{
+    u16 items[PARTY_SIZE];
+    u32 i, typeMask = GetTypeMask(list->species);
+    u16 baseSpecies = GET_BASE_SPECIES_ID(list->species);
+
+    for (i = 0; i < team->count; i++)
+    {
+        if (team->members[i].baseSpecies == baseSpecies)
+            return FALSE;
+    }
+    if (typeMask & team->picksTypeMask)
+        return FALSE;
+    if (!DailyRed_TypesFit(team->typeCounts, typeMask))
+        return FALSE;
+    if (team->hasEeveelution && IsEeveelution(list->species))
+        return FALSE;
+    return DailyRed_HasFittingSet(list, items, GetTeamItems(team, items));
+}
+
+static void AddPick(struct RedTeam *team, const struct DailyRedSetList *list, u32 *rng)
+{
+    team->picksTypeMask |= GetTypeMask(list->species);
+    AddMember(team, list, LEVEL_PICK, FALSE, rng);
+}
+
+// Two of RED's own Pokemon, in a random order of sRedPool.
+static void AddPoolPicks(struct RedTeam *team, u32 *rng)
+{
+    u16 order[ARRAY_COUNT(sRedPool)];
+    u32 i, j, picked = 0;
+
+    for (i = 0; i < ARRAY_COUNT(sRedPool); i++)
+        order[i] = sRedPool[i];
+    for (i = 0; i < ARRAY_COUNT(sRedPool) - 1; i++)
+    {
+        u16 temp;
+        j = i + RedRandom(rng) % (ARRAY_COUNT(sRedPool) - i);
+        SWAP(order[i], order[j], temp);
+    }
+    for (i = 0; i < ARRAY_COUNT(sRedPool) && picked < 2; i++)
+    {
+        const struct DailyRedSetList *list = FindSetList(order[i], DAILYRED_SETS_NORMAL);
+        if (CanPick(team, list))
+        {
+            AddPick(team, list, rng);
+            picked++;
+        }
+    }
+}
+
+// One fully evolved Pokemon from a Gen 1 family: a random species, then a
+// random forme of it.
+static void AddAnyPick(struct RedTeam *team, u32 *rng)
+{
+    u32 attempt, i;
+
+    for (attempt = 0; attempt < MAX_PICK_ATTEMPTS; attempt++)
+    {
+        const struct DailyRedPickGroup *group = &gDailyRedPickGroups[RedRandom(rng) % gDailyRedNumPickGroups];
+        const struct DailyRedSetList *list = &gDailyRedSetLists[gDailyRedPickLists[group->first + RedRandom(rng) % group->count]];
+        if (CanPick(team, list))
+        {
+            AddPick(team, list, rng);
+            return;
+        }
+    }
+    // Practically never: take the first one that fits.
+    for (i = 0; i < gDailyRedNumPickGroups; i++)
+    {
+        const struct DailyRedPickGroup *group = &gDailyRedPickGroups[i];
+        const struct DailyRedSetList *list = &gDailyRedSetLists[gDailyRedPickLists[group->first]];
+        if (CanPick(team, list))
+        {
+            AddPick(team, list, rng);
+            return;
+        }
+    }
+}
+
+static bool32 SetsHazards(const struct DailyRedSet *set)
+{
+    u32 i;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        if (IsInList(set->moves[i], sHazardMoves, ARRAY_COUNT(sHazardMoves)))
+            return TRUE;
+    }
+    return FALSE;
+}
+
+// Picks the lead among members firstLead to lastLead (a hazard setter if
+// there is one), and the order of the others.
+static void OrderTeam(struct RedTeam *team, u8 firstLead, u8 lastLead, u8 *order, u32 *rng)
+{
+    u8 candidates[PARTY_SIZE] = {0};
+    u8 count = 0, i, j, temp;
+
+    for (i = firstLead; i <= lastLead; i++)
+    {
+        if (SetsHazards(team->members[i].set))
+            candidates[count++] = i;
+    }
+    if (count == 0)
+    {
+        for (i = firstLead; i <= lastLead; i++)
+            candidates[count++] = i;
+    }
+    order[0] = candidates[RedRandom(rng) % count];
+    for (i = 0, j = 1; i < team->count; i++)
+    {
+        if (i != order[0])
+            order[j++] = i;
+    }
+    for (i = 1; i < team->count - 1; i++)
+    {
+        j = i + RedRandom(rng) % (team->count - i);
+        SWAP(order[i], order[j], temp);
+    }
+}
+
+static u8 GetRedGender(u16 species)
+{
+    u8 ratio = gSpeciesInfo[species].genderRatio;
+
+    if (ratio == MON_GENDERLESS || ratio == MON_MALE || ratio == MON_FEMALE)
+        return TRAINER_MON_RANDOM_GENDER; // fixed anyway
+    if (IsEeveelution(species) || IsInList(GET_BASE_SPECIES_ID(species), sFemaleSpecies, ARRAY_COUNT(sFemaleSpecies)))
+        return TRAINER_MON_FEMALE;
+    return TRAINER_MON_MALE;
+}
+
+static void CreateRedMon(struct Pokemon *mon, const struct RedMember *member, struct TrainerGenerator *trainerGen)
+{
+    struct DailyRedSet set = *member->set;
+
+    set.species = member->species; // a capped Pikachu
+    DailyRed_CreateSetMon(mon, &set, member->level, GetRedGender(set.species), member->shiny, trainerGen);
+}
+
+static void BuildUsualTeam(struct RedTeam *team, u32 starter, u32 legendaryRoll, bool32 capPikachu, u32 *rng)
+{
+    // His Z-Move: the capped Pikachu's, or the legendary's (or starter's) sets may have one.
+    u8 zKind = capPikachu ? DAILYRED_SETS_NORMAL : DAILYRED_SETS_ZMOVE;
+    const struct RedStarter *info = &sRedStarters[starter];
+    u32 legendary;
+    u16 species;
+
+    if (legendaryRoll < MEGA_MEWTWO_ODDS)
+        legendary = LEGENDARY_MEGA_MEWTWO;
+    else if ((legendaryRoll -= MEGA_MEWTWO_ODDS) < MEW_ODDS)
+        legendary = legendaryRoll < SHINY_MEW_ODDS ? LEGENDARY_SHINY_MEW : LEGENDARY_MEW;
+    else if ((legendaryRoll -= MEW_ODDS) < DEOXYS_ODDS)
+        legendary = LEGENDARY_DEOXYS;
+    else if ((legendaryRoll -= DEOXYS_ODDS) < MEWTWO_ODDS)
+        legendary = LEGENDARY_MEWTWO;
+    else if ((legendaryRoll -= MEWTWO_ODDS) < GALARIAN_BIRD_ODDS)
+        legendary = LEGENDARY_GALARIAN_BIRD;
+    else if ((legendaryRoll -= GALARIAN_BIRD_ODDS) < JOHTO_DOG_ODDS)
+        legendary = LEGENDARY_JOHTO_DOG;
+    else
+        legendary = LEGENDARY_BIRD;
+
+    // The starter Mega Evolves, unless Mewtwo does.
+    if (legendary == LEGENDARY_MEGA_MEWTWO)
+        AddMember(team, FindSetList(info->species, zKind), LEVEL_STARTER, FALSE, rng);
+    else
+        AddMember(team, FindSetList(info->megas[RedRandom(rng) % 2], DAILYRED_SETS_MEGA), LEVEL_STARTER, FALSE, rng);
+
+    switch (legendary)
+    {
+    case LEGENDARY_MEGA_MEWTWO:
+        species = (RedRandom(rng) % 2) ? SPECIES_MEWTWO_MEGA_Y : SPECIES_MEWTWO_MEGA_X;
+        AddMember(team, FindSetList(species, DAILYRED_SETS_MEGA), LEVEL_MEWTWO, FALSE, rng);
+        break;
+    case LEGENDARY_MEWTWO:
+        AddMember(team, FindSetList(SPECIES_MEWTWO, zKind), LEVEL_MEWTWO, FALSE, rng);
+        break;
+    case LEGENDARY_MEW:
+    case LEGENDARY_SHINY_MEW:
+        AddMember(team, FindSetList(SPECIES_MEW, zKind), LEVEL_LEGENDARY, legendary == LEGENDARY_SHINY_MEW, rng);
+        break;
+    case LEGENDARY_DEOXYS:
+        species = sDeoxysFormes[RedRandom(rng) % ARRAY_COUNT(sDeoxysFormes)];
+        AddMember(team, FindSetList(species, zKind), LEVEL_LEGENDARY, FALSE, rng);
+        break;
+    case LEGENDARY_GALARIAN_BIRD:
+        AddMember(team, FindSetList(info->galarianBird, DAILYRED_SETS_NORMAL), LEVEL_LEGENDARY, FALSE, rng);
+        break;
+    case LEGENDARY_JOHTO_DOG:
+        AddMember(team, FindSetList(info->johtoDog, zKind), LEVEL_LEGENDARY, FALSE, rng);
+        break;
+    default:
+        AddMember(team, FindSetList(info->bird, zKind), LEVEL_LEGENDARY, FALSE, rng);
+        break;
+    }
+
+    // Members from here on can lead. Pikachu is member 2: in a cap, with its
+    // Pikanium Z, on capped-Pikachu days.
+    if (capPikachu)
+    {
+        AddMember(team, FindSetList(SPECIES_PIKACHU, DAILYRED_SETS_ZMOVE), LEVEL_PIKACHU, FALSE, rng);
+        team->members[team->count - 1].species = sCapPikachus[RedRandom(rng) % ARRAY_COUNT(sCapPikachus)];
+    }
+    else
+    {
+        AddMember(team, FindSetList(SPECIES_PIKACHU, DAILYRED_SETS_NORMAL), LEVEL_PIKACHU, FALSE, rng);
+    }
+    AddPoolPicks(team, rng);
+    AddAnyPick(team, rng);
+}
+
+static void BuildOriginalTeam(struct RedTeam *team, u32 *rng)
+{
+    const u8 *gimmicks = sGimmickOrders[RedRandom(rng) % ARRAY_COUNT(sGimmickOrders)];
+    u32 i;
+
+    for (i = 0; i < NUM_STARTERS; i++)
+    {
+        const struct RedStarter *info = &sRedStarters[i];
+        u16 species = info->species;
+        if (gimmicks[i] == DAILYRED_SETS_MEGA)
+            species = info->megas[RedRandom(rng) % 2];
+        AddMember(team, FindSetList(species, gimmicks[i]), LEVEL_ORIGINAL_TEAM, FALSE, rng);
+    }
+    // Pikachu (member NUM_STARTERS) always leads on these days.
+    AddMember(team, FindSetList(SPECIES_PIKACHU, DAILYRED_SETS_NORMAL), LEVEL_ORIGINAL_TEAM, FALSE, rng);
+    AddMember(team, FindSetList((RedRandom(rng) % 2) ? SPECIES_LAPRAS : SPECIES_ESPEON, DAILYRED_SETS_NORMAL), LEVEL_ORIGINAL_TEAM, FALSE, rng);
+    AddMember(team, FindSetList(SPECIES_SNORLAX, DAILYRED_SETS_NORMAL), LEVEL_ORIGINAL_TEAM, FALSE, rng);
+}
+
+// Returns RED's Kanto starter (SPECIES_NONE on original-team days, when he
+// has all three), which decides the player's starter.
+u16 DailyRed_GenerateRedTeam(u32 *rng)
+{
+    struct RedTeam team = {0};
+    struct TrainerGenerator trainerGen;
+    u8 order[PARTY_SIZE];
+    u32 i;
+
+    // Always the first three draws, in this order (see the top of the file).
+    bool32 originalTeam = RedRandom(rng) % 100 < ORIGINAL_TEAM_ODDS;
+    u32 starter = RedRandom(rng) % NUM_STARTERS;
+    u32 legendaryRoll = RedRandom(rng) % 100;
+    bool32 capPikachu = RedRandom(rng) % 100 < CAP_PIKACHU_ODDS && !originalTeam;
+
+    if (originalTeam)
+        BuildOriginalTeam(&team, rng);
+    else
+        BuildUsualTeam(&team, starter, legendaryRoll, capPikachu, rng);
+
+    // The starter and the legendary never lead; the capped Pikachu (member 2)
+    // always does, and on HGSS days so does Pikachu (member NUM_STARTERS).
+    // OrderTeam still makes its draw, so the RNG stream is unchanged.
+    if (originalTeam)
+        OrderTeam(&team, NUM_STARTERS, NUM_STARTERS, order, rng);
+    else if (capPikachu)
+        OrderTeam(&team, 2, 2, order, rng);
+    else
+        OrderTeam(&team, 2, team.count - 1, order, rng);
+
+    MakeTrainerGenerator(&trainerGen, GetTrainerStructFromId(TRAINER_DAILYRED_RED));
+    trainerGen.localRngState = LocalRandomSeed(RedRandom32(rng));
+    ZeroPartyMons(gDailyRedRedParty);
+    for (i = 0; i < team.count; i++)
+        CreateRedMon(&gDailyRedRedParty[i], &team.members[order[i]], &trainerGen);
+    return originalTeam ? SPECIES_NONE : sRedStarters[starter].species;
+}
+
+// Called as RED's battle starts (DailyRed_OnBattleStart, before the map
+// script's trainerbattle): when his lead is his capped Pikachu (holding its
+// Pikanium Z), its totem aura flares as the battle starts, raising Attack,
+// Defense, Speed, Sp. Atk and Sp. Def by one stage (the expansion's totem
+// boost, as the settotemboost script command queues it).
+void DailyRed_QueueRedTotemBoost(void)
+{
+    struct QueuedStatBoost *boost = &gQueuedStatBoosts[B_POSITION_OPPONENT_LEFT];
+    enum Stat stat;
+
+    if (GET_BASE_SPECIES_ID(GetMonData(&gDailyRedRedParty[0], MON_DATA_SPECIES)) != SPECIES_PIKACHU
+     || GetMonData(&gDailyRedRedParty[0], MON_DATA_HELD_ITEM) != ITEM_PIKANIUM_Z)
+        return;
+    for (stat = STAT_ATK; stat <= STAT_SPDEF; stat++)
+    {
+        boost->stats |= 1 << stat;
+        boost->statChanges[stat] = 1;
+    }
+}
+
+// Called from CreateNPCTrainerParty (battle_setup.c) for TRAINER_DAILYRED_RED.
+void DailyRed_CreateRedParty(struct Pokemon *party)
+{
+    u32 i;
+    for (i = 0; i < PARTY_SIZE; i++)
+        party[i] = gDailyRedRedParty[i];
+}
+
+// --- RED's battle sprite ---------------------------------------------------------
+// His HeartGold/SoulSilver battle sprite is animated: he stands with his cap
+// tipped down, then lifts it to look at you for a moment. The trainer picture
+// (TRAINER_PIC_DAILYRED_RED) is the cap-up frame; in battle his sprite uses both
+// frames, uncompressed in the ROM, and plays the animation once he has slid in
+// (the battle's own picture buffers only hold one trainer frame).
+
+static const u8 sRedHgssFrames_Gfx[] = INCGFX_U8("graphics/trainers/front_pics/dailyred_red_anim.png", ".4bpp");
+
+static const struct SpriteFrameImage sRedHgssFrames[] =
+{
+    {sRedHgssFrames_Gfx, TRAINER_PIC_SIZE},
+    {sRedHgssFrames_Gfx + TRAINER_PIC_SIZE, TRAINER_PIC_SIZE},
+};
+
+// He slides in with his cap tipped down (frame 1), lifts it to look at you
+// (frame 0, his trainer picture) and tips it back down.
+static const union AnimCmd sAnim_RedHgss_Still[] =
+{
+    ANIMCMD_FRAME(1, 1),
+    ANIMCMD_END,
+};
+
+static const union AnimCmd sAnim_RedHgss_CapLift[] =
+{
+    ANIMCMD_FRAME(1, 20),
+    ANIMCMD_FRAME(0, 50), // cap lifted, looking
+    ANIMCMD_FRAME(1, 1),
+    ANIMCMD_END,
+};
+
+enum
+{
+    ANIM_RED_HGSS_STILL,
+    ANIM_RED_HGSS_CAP_LIFT,
+};
+
+static const union AnimCmd *const sAnims_RedHgss[] =
+{
+    [ANIM_RED_HGSS_STILL] = sAnim_RedHgss_Still,
+    [ANIM_RED_HGSS_CAP_LIFT] = sAnim_RedHgss_CapLift,
+};
+
+// Slides in as usual, then lifts his cap.
+static void SpriteCB_RedHgssSlideIn(struct Sprite *sprite)
+{
+    SpriteCB_TrainerSlideIn(sprite);
+    if (sprite->callback != SpriteCB_RedHgssSlideIn)
+        StartSpriteAnim(sprite, ANIM_RED_HGSS_CAP_LIFT);
+}
+
+// Called from BtlController_HandleDrawTrainerPic (battle_controllers.c) for
+// every opponent's trainer sprite: RED's gets his frames and animation.
+void DailyRed_AnimateTrainerSprite(struct Sprite *sprite, u16 trainerPicId)
+{
+    if (trainerPicId != TRAINER_PIC_DAILYRED_RED)
+        return;
+    sprite->images = sRedHgssFrames;
+    sprite->anims = sAnims_RedHgss;
+    StartSpriteAnim(sprite, ANIM_RED_HGSS_STILL);
+    if (sprite->callback == SpriteCB_TrainerSlideIn)
+        sprite->callback = SpriteCB_RedHgssSlideIn;
+}
