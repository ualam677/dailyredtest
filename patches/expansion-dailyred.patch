--- /dev/null
+++ b/src/dailyred_team.c
@@ -0,0 +1,395 @@
+#include "global.h"
+#include "dailyred.h"
+#include "data.h"
+#include "pokemon.h"
+#include "random.h"
+#include "string_util.h"
+#include "trainer_util.h"
+#include "constants/pokeball.h"
+#include "constants/pokemon.h"
+#include "constants/trainers.h"
+
+// Daily Red's teams, built from Pokemon Showdown's Gen 7 Random Battle sets
+// (gDailyRedSets in dailyred_sets.c, generated by scripts/sets/generate.mjs).
+//
+// The player's team follows Showdown's own team builder (randomTeam() in
+// data/random-battles/gen7/teams.ts): species are drawn at random, a species
+// with a Mega forme is drawn as the Mega while the team has none (at most one
+// Mega), at most one Z-Move user, at most two Pokemon of any type, no more
+// than three weak to any type, and a few combinations it avoids. The sets
+// come with Showdown's own odds.
+//
+// Showdown balances its teams with levels; here everything is level 100. So
+// Daily Red keeps each Pokemon's Showdown level as a measure of strength (a
+// level 72 Mewtwo is much stronger than a level 93 Pikachu) and only deals
+// teams whose total strength falls in a band, TEAM_STRENGTH_MIN to
+// TEAM_STRENGTH_MAX. RED's team (dailyred_red.c) averages about 96, so the
+// band sets the difficulty.
+//
+// Teams depend only on the RNG state passed in, never on the game's Random().
+
+// A Pokemon's strength: how far below level 100 Showdown puts it.
+#define STRENGTH(forme) (100 - gDailyRedFormes[forme].level)
+
+// The player's team strength band (the sum over the six). For reference, a
+// Showdown Gen 7 Random Battle team has a median of 91 (10% under 70, 10%
+// over 111), and RED's team averages about 96 (69 to 123).
+#define TEAM_STRENGTH_MIN 70
+#define TEAM_STRENGTH_MAX 90
+
+#define MAX_TEAM_ATTEMPTS 200
+#define NUM_TYPES_MAX 18
+#define TYPE_FIRE_BIT 6       // bit of Fire in the type masks (see dailyred_sets.c)
+#define FREEZE_DRY NUM_TYPES_MAX
+#define PLAYER_SHINY_ODDS 4096
+#define RED_OT_ID 0x0000F00D
+
+static u32 RandomBelow(rng_value_t *rng, u32 n)
+{
+    return n == 0 ? 0 : ((u64)LocalRandom32(rng) * n) >> 32;
+}
+
+s32 DailyRed_FindForme(u16 species)
+{
+    s32 i;
+
+    for (i = 0; i < gDailyRedNumFormes; i++)
+    {
+        if (gDailyRedFormes[i].species == species)
+            return i;
+    }
+    return -1;
+}
+
+// --- Sets ---------------------------------------------------------------------
+
+static u32 SetWeight(const struct DailyRedSet *set, bool32 zUsed, u32 avoid)
+{
+    if (set->flags & avoid)
+        return 0;
+    return zUsed ? set->weightClosed : set->weightOpen;
+}
+
+u16 DailyRed_PickSet(u16 formeId, bool32 zUsed, u32 avoid, rng_value_t *rng)
+{
+    const struct DailyRedForme *forme = &gDailyRedFormes[formeId];
+    u32 total, pick, weight, i, pass;
+
+    // Prefer sets that don't double up on what the team already has; if that
+    // leaves nothing, any set will do (Showdown would have culled the move).
+    for (pass = 0; pass < 2; pass++)
+    {
+        if (pass == 1)
+            avoid = 0;
+        total = 0;
+        for (i = 0; i < forme->numSets; i++)
+            total += SetWeight(&gDailyRedSets[forme->firstSet + i], zUsed, avoid);
+        if (total != 0)
+            break;
+    }
+    if (total == 0)
+        return DAILYRED_NO_SET; // only Z-Move sets, and the team already has one
+
+    pick = RandomBelow(rng, total);
+    for (i = 0; i < forme->numSets; i++)
+    {
+        weight = SetWeight(&gDailyRedSets[forme->firstSet + i], zUsed, avoid);
+        if (pick < weight)
+            return forme->firstSet + i;
+        pick -= weight;
+    }
+    return forme->firstSet;
+}
+
+// --- The player's team: Showdown's randomTeam() -------------------------------
+
+struct TeamBuilder
+{
+    struct DailyRedPick picks[PARTY_SIZE]; // in the order they were generated
+    u8 count;
+    bool8 hasMega;
+    bool8 hasZMove;
+    u8 spikes;
+    u8 numMaxLevel;
+    u16 setFlags;    // DAILYRED_SET_* on the team
+    u16 compat;      // DAILYRED_COMPAT_* on the team
+    u8 typeCount[NUM_TYPES_MAX];
+    u8 weakCount[NUM_TYPES_MAX + 1]; // + Freeze-Dry
+    u8 doubleWeakCount[NUM_TYPES_MAX];
+    u8 groupTaken[(512 + 7) / 8];
+};
+
+static bool32 GroupTaken(const struct TeamBuilder *team, u32 group)
+{
+    return (team->groupTaken[group / 8] >> (group % 8)) & 1;
+}
+
+// From getPokemonCompatibility(): pairs Showdown never puts on one team.
+static bool32 IsCompatible(u32 formeFlags, u32 teamCompat)
+{
+    static const u16 pairs[][2] =
+    {
+        {DAILYRED_COMPAT_BLISSEY, DAILYRED_COMPAT_CHANSEY},
+        {DAILYRED_COMPAT_ILLUMISE, DAILYRED_COMPAT_VOLBEAT},
+        {DAILYRED_COMPAT_WEB, DAILYRED_COMPAT_WEB},
+        {DAILYRED_COMPAT_SCREENS, DAILYRED_COMPAT_SCREENS},
+        {DAILYRED_COMPAT_SUN_HATER, DAILYRED_COMPAT_SUN},
+        {DAILYRED_COMPAT_SHEDINJA, DAILYRED_COMPAT_SAND_HAIL},
+    };
+    u32 i;
+
+    for (i = 0; i < ARRAY_COUNT(pairs); i++)
+    {
+        if ((formeFlags & pairs[i][0]) && (teamCompat & pairs[i][1]))
+            return FALSE;
+        if ((formeFlags & pairs[i][1]) && (teamCompat & pairs[i][0]))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+// The "restrict" checks of the first pass.
+static bool32 PassesTeamLimits(const struct TeamBuilder *team, const struct DailyRedForme *forme)
+{
+    u32 t;
+
+    for (t = 0; t < gDailyRedNumTypes; t++)
+    {
+        if ((forme->types >> t) & 1 && team->typeCount[t] >= 2)
+            return FALSE; // two of any type
+    }
+    for (t = 0; t < gDailyRedNumTypes; t++)
+    {
+        if ((forme->weak >> t) & 1 && (team->weakCount[t] >= 3 || team->doubleWeakCount[t] >= 1))
+            return FALSE; // three weak to a type, or one 4x weak to it
+    }
+    if ((forme->flags & DAILYRED_FORME_DRY_SKIN) && team->weakCount[TYPE_FIRE_BIT] >= 3)
+        return FALSE;
+    if ((forme->flags & DAILYRED_FORME_FREEZE_DRY) && team->weakCount[FREEZE_DRY] >= 4)
+        return FALSE;
+    if (forme->level == 100 && team->numMaxLevel >= 1)
+        return FALSE;
+    return IsCompatible(forme->flags, team->compat);
+}
+
+static u32 AvoidFlags(const struct TeamBuilder *team)
+{
+    u32 avoid = team->setFlags & DAILYRED_SET_ONE_PER_TEAM;
+
+    if (team->spikes >= 2)
+        avoid |= DAILYRED_SET_SPIKES;
+    return avoid;
+}
+
+static void AddToTeam(struct TeamBuilder *team, u32 group, u16 formeId, u16 setId)
+{
+    const struct DailyRedForme *forme = &gDailyRedFormes[formeId];
+    const struct DailyRedSet *set = &gDailyRedSets[setId];
+    u32 t;
+
+    team->picks[team->count].forme = formeId;
+    team->picks[team->count].set = setId;
+    team->count++;
+    team->groupTaken[group / 8] |= 1 << (group % 8);
+
+    for (t = 0; t < gDailyRedNumTypes; t++)
+    {
+        if ((forme->types >> t) & 1)
+            team->typeCount[t]++;
+        if ((forme->weak >> t) & 1)
+            team->weakCount[t]++;
+        if ((forme->doubleWeak >> t) & 1)
+            team->doubleWeakCount[t]++;
+    }
+    if ((set->flags & DAILYRED_SET_FIRE_ABILITY) && (forme->flags & DAILYRED_FORME_DRY_SKIN))
+        team->weakCount[TYPE_FIRE_BIT]++;
+    if (forme->flags & DAILYRED_FORME_FREEZE_DRY)
+        team->weakCount[FREEZE_DRY]++;
+    if (forme->level == 100)
+        team->numMaxLevel++;
+    if (set->flags & DAILYRED_SET_MEGA)
+        team->hasMega = TRUE;
+    if (set->flags & DAILYRED_SET_ZMOVE)
+        team->hasZMove = TRUE;
+    if (set->flags & DAILYRED_SET_SPIKES)
+        team->spikes++;
+    team->setFlags |= set->flags;
+    team->compat |= forme->flags;
+}
+
+// Picks a forme of a species the way Showdown does: its Mega formes if it has
+// any and the team has no Mega yet, otherwise its other formes. -1 if none.
+static s32 PickForme(const struct TeamBuilder *team, const struct DailyRedGroup *group, rng_value_t *rng)
+{
+    u16 candidates[32];
+    u32 count = 0, i;
+    bool32 canMega = FALSE, isMega;
+
+    for (i = 0; i < group->numFormes; i++)
+    {
+        if (!team->hasMega && (gDailyRedFormes[group->firstForme + i].flags & DAILYRED_FORME_MEGA))
+            canMega = TRUE;
+    }
+    for (i = 0; i < group->numFormes && count < ARRAY_COUNT(candidates); i++)
+    {
+        isMega = (gDailyRedFormes[group->firstForme + i].flags & DAILYRED_FORME_MEGA) != 0;
+        if (team->hasMega && isMega)
+            continue;
+        if (canMega && !isMega)
+            continue;
+        candidates[count++] = group->firstForme + i;
+    }
+    return count == 0 ? -1 : candidates[RandomBelow(rng, count)];
+}
+
+// One Showdown Random Battle team (before Daily Red's strength band).
+static void BuildShowdownTeam(struct TeamBuilder *team, rng_value_t *rng)
+{
+    static EWRAM_DATA u16 sTickets[512 * 3] = {0};
+    u32 numTickets, i, j, pass;
+    u16 group, setId;
+    s32 formeId;
+
+    memset(team, 0, sizeof(*team));
+
+    // Two passes: the second drops the team limits if the first came up short.
+    for (pass = 0; pass < 2 && team->count < PARTY_SIZE; pass++)
+    {
+        // Base species, with 1-3 tickets each depending on their number of formes.
+        numTickets = 0;
+        for (i = 0; i < gDailyRedNumGroups; i++)
+        {
+            if (GroupTaken(team, i))
+                continue;
+            for (j = 0; j < gDailyRedGroups[i].weight && numTickets < ARRAY_COUNT(sTickets); j++)
+                sTickets[numTickets++] = i;
+        }
+
+        while (numTickets != 0 && team->count < PARTY_SIZE)
+        {
+            // Draw a ticket without replacement.
+            i = RandomBelow(rng, numTickets);
+            group = sTickets[i];
+            sTickets[i] = sTickets[--numTickets];
+
+            if (GroupTaken(team, group))
+                continue; // one of each species
+            formeId = PickForme(team, &gDailyRedGroups[group], rng);
+            if (formeId < 0)
+                continue;
+            if (pass == 0 && !PassesTeamLimits(team, &gDailyRedFormes[formeId]))
+                continue;
+
+            setId = DailyRed_PickSet(formeId, team->hasZMove, AvoidFlags(team), rng);
+            if (setId == DAILYRED_NO_SET)
+                continue;
+            if ((gDailyRedSets[setId].flags & DAILYRED_SET_ZMOVE) && team->hasZMove)
+                continue;
+            // Zoroark copies the last Pokemon, so it can't be the last one.
+            if ((gDailyRedSets[setId].flags & DAILYRED_SET_ILLUSION) && team->count == 0)
+                continue;
+            AddToTeam(team, group, formeId, setId);
+        }
+    }
+}
+
+static u32 TeamStrength(const struct TeamBuilder *team)
+{
+    u32 strength = 0, i;
+
+    for (i = 0; i < team->count; i++)
+        strength += STRENGTH(team->picks[i].forme);
+    return strength;
+}
+
+void DailyRed_PickPlayerTeam(struct DailyRedPick *picks, rng_value_t *rng)
+{
+    struct TeamBuilder team, best;
+    u32 attempt, strength, distance, bestDistance = 0xFFFFFFFF, i;
+
+    // Redraw whole teams until one falls in the band, so every team in the
+    // band is as likely as on Showdown. In the practically impossible case
+    // that none does, the closest one is used.
+    for (attempt = 0; attempt < MAX_TEAM_ATTEMPTS; attempt++)
+    {
+        BuildShowdownTeam(&team, rng);
+        if (team.count < PARTY_SIZE)
+            continue;
+        strength = TeamStrength(&team);
+        if (strength >= TEAM_STRENGTH_MIN && strength <= TEAM_STRENGTH_MAX)
+        {
+            best = team;
+            break;
+        }
+        distance = strength < TEAM_STRENGTH_MIN ? TEAM_STRENGTH_MIN - strength : strength - TEAM_STRENGTH_MAX;
+        if (distance < bestDistance)
+        {
+            bestDistance = distance;
+            best = team;
+        }
+    }
+
+    // Showdown adds each new Pokemon to the front, so the last one drawn leads.
+    for (i = 0; i < PARTY_SIZE; i++)
+        picks[i] = best.picks[PARTY_SIZE - 1 - i];
+}
+
+// --- Creating the Pokemon -------------------------------------------------------
+
+static const u8 sNeutralNatures[] = {NATURE_HARDY, NATURE_DOCILE, NATURE_SERIOUS, NATURE_BASHFUL, NATURE_QUIRKY};
+
+// Showdown's stat order (HP, Atk, Def, SpA, SpD, Spe) -> the game's.
+static const u8 sShowdownToGameStat[NUM_STATS] = {STAT_HP, STAT_ATK, STAT_DEF, STAT_SPATK, STAT_SPDEF, STAT_SPEED};
+
+void DailyRed_CreateMonFromSet(struct Pokemon *mon, const struct DailyRedPick *pick, bool32 forPlayer, rng_value_t *rng)
+{
+    const struct DailyRedSet *set = &gDailyRedSets[pick->set];
+    struct TrainerMon trainerMon = {0};
+    struct TrainerGenerator generator = {0};
+    u32 i, hp;
+    bool32 trained;
+
+    trainerMon.species = set->species;
+    trainerMon.lvl = MAX_LEVEL;
+    trainerMon.heldItem = set->item;
+    trainerMon.ability = set->ability;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+        trainerMon.moves[i] = set->moves[i];
+    trainerMon.ev = set->evs; // Showdown order, as struct TrainerMon expects
+    trainerMon.iv = TRAINER_PARTY_IVS(set->ivs[0], set->ivs[1], set->ivs[2], set->ivs[5], set->ivs[3], set->ivs[4]);
+    trainerMon.friendship = set->friendship;
+    trainerMon.nature = sNeutralNatures[RandomBelow(rng, ARRAY_COUNT(sNeutralNatures))]; // Showdown's sets have none
+    trainerMon.gender = TRAINER_MON_RANDOM_GENDER;
+    trainerMon.ball = forPlayer ? BALL_POKE : POKEBALL_COUNT; // POKEBALL_COUNT: the trainer class's ball
+    trainerMon.isShiny = forPlayer && RandomBelow(rng, PLAYER_SHINY_ODDS) == 0;
+
+    if (forPlayer)
+    {
+        // The player is the original trainer, so everything obeys.
+        StringCopyN(generator.name, gSaveBlock2Ptr->playerName, TRAINER_NAME_LENGTH + 1);
+        generator.gender = gSaveBlock2Ptr->playerGender;
+        generator.otID = OTID_STRUCT_PLAYER_ID;
+    }
+    else
+    {
+        const struct Trainer *red = GetTrainerStructFromId(TRAINER_DAILYRED_RED);
+        StringCopyN(generator.name, red->trainerName, TRAINER_NAME_LENGTH + 1);
+        generator.gender = MALE;
+        generator.trainerClass = red->trainerClass;
+        generator.otID = OTID_STRUCT_PRESET(RED_OT_ID);
+    }
+    generator.localRngState = *rng;
+    GenerateMonFromTrainerMon(mon, &trainerMon, &generator);
+    *rng = generator.localRngState;
+
+    // Showdown's level 100 sets use Bottle Caps where Hidden Power needed
+    // lower IVs: those stats count as 31.
+    for (i = 0; i < NUM_STATS; i++)
+    {
+        trained = (set->hyperTrained >> i) & 1;
+        SetMonData(mon, MON_DATA_HYPER_TRAINED_HP + sShowdownToGameStat[i], &trained);
+    }
+    CalculateMonStats(mon);
+    hp = GetMonData(mon, MON_DATA_MAX_HP);
+    SetMonData(mon, MON_DATA_HP, &hp);
+}
