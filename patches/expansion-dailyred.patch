index 00000000..3bcdb60e
--- /dev/null
+++ b/sound/voicegroups/dailyred_vs_red.inc
@@ -0,0 +1,137 @@
+@ Daily Red: the voicegroup for RED's battle theme (mus_dailyred_vs_red).
+@ FireRed's champion battle voicegroup (rg_vs_champion.inc), whose layout the
+@ song was arranged for: the same instruments at the same program numbers.
+@ The slots the song uses that rg_vs_champion leaves empty, or that would make
+@ two of its parts fight over a GBA sound channel, get FireRed's usual voice
+@ for that program instead; they are marked "changed" below. The song's
+@ synth parts each get a channel of their own: square 1 (80), square 2
+@ (81, 82, 84), the wave channel (3, 83, 87, 89) and noise (126, 127).
+voice_group dailyred_vs_red
+	voice_keysplit_all voicegroup_frlg_drumset  @ 0: drum kit
+	voice_keysplit voicegroup_piano_keysplit, keysplit_piano
+	voice_square_1 60, 0, 0, 2, 0, 0, 15, 0
+	voice_programmable_wave_alt 60, 0, ProgrammableWaveData_5, 0, 7, 15, 0  @ 3: wave, changed
+	voice_directsound 60, 0, DirectSoundWaveData_sd90_classical_detuned_ep1_low, 255, 249, 0, 165
+	voice_square_1 60, 0, 0, 2, 0, 0, 15, 0
+	voice_square_1 60, 0, 0, 2, 0, 0, 15, 0
+	voice_square_1 60, 0, 0, 2, 0, 0, 15, 0
+	voice_square_1 60, 0, 0, 2, 0, 0, 15, 0
+	voice_square_1 60, 0, 0, 2, 0, 0, 15, 0
+	voice_directsound 60, 0, DirectSoundWaveData_ethnic_flavours_atarigane, 255, 0, 255, 0
