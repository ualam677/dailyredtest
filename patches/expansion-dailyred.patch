+static void DrawHeader(void)
+{
+    struct Pokemon *mon = CurMon();
+    u16 species = GetMonData(mon, MON_DATA_SPECIES);
+    u8 *win = sSummary->windows;
+    u32 width;
+
+    FillWindowPixelBuffer(win[WIN_TITLE], PIXEL_FILL(0));
+    AddTextPrinterParameterized3(win[WIN_TITLE], FONT_NORMAL, 4, 1, sColor_Title, TEXT_SKIP_DRAW, sPageTitles[sSummary->page]);
+    FillWindowPixelBuffer(win[WIN_INSTRUCTIONS], PIXEL_FILL(0));
+    width = GetStringWidth(FONT_SMALL, sPageInstructions[sSummary->page], 0);
+    AddTextPrinterParameterized3(win[WIN_INSTRUCTIONS], FONT_SMALL, 0x54 - width, 0, sColor_Title, TEXT_SKIP_DRAW, sPageInstructions[sSummary->page]);
+
+    FillWindowPixelBuffer(win[WIN_NAME], PIXEL_FILL(0));
+    GetMonNickname(mon, gStringVar1);
+    AddTextPrinterParameterized3(win[WIN_NAME], FONT_NORMAL, 0, 2, sColor_Dark, TEXT_SKIP_DRAW, gStringVar1);
+    if (species != SPECIES_NIDORAN_M && species != SPECIES_NIDORAN_F)
+    {
+        switch (GetMonGender(mon))
+        {
+        case MON_FEMALE:
+            AddTextPrinterParameterized3(win[WIN_NAME], FONT_NORMAL, 62, 2, sColor_RedOnLight, TEXT_SKIP_DRAW, gText_FemaleSymbol);
+            break;
+        case MON_MALE:
+            AddTextPrinterParameterized3(win[WIN_NAME], FONT_NORMAL, 62, 2, sColor_BlueOnLight, TEXT_SKIP_DRAW, gText_MaleSymbol);
+            break;
+        }
+    }
+    if (sSummary->page == PAGE_MOVE_INFO)
+    {
+        BlitMenuInfoIcon(win[WIN_NAME], GetSpeciesType(species, 0) + 1, 6, 16);
+        if (GetSpeciesType(species, 0) != GetSpeciesType(species, 1))
+            BlitMenuInfoIcon(win[WIN_NAME], GetSpeciesType(species, 1) + 1, 38, 16);
+    }
+    else
+    {
+        u8 *end = StringCopy(gStringVar2, gText_Lv);
+        ConvertIntToDecimalStringN(end, GetMonData(mon, MON_DATA_LEVEL), STR_CONV_MODE_LEFT_ALIGN, 3);
+        AddTextPrinterParameterized3(win[WIN_NAME], FONT_NORMAL, 0, 14, sColor_Dark, TEXT_SKIP_DRAW, gStringVar2);
+    }
+    for (u32 i = WIN_TITLE; i <= WIN_NAME; i++)
+    {
+        PutWindowTilemap(win[i]);
+        CopyWindowToVram(win[i], COPYWIN_GFX);
+    }
+}
