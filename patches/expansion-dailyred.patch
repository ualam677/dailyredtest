+static void DrawMovesPage(void)
+{
+    struct Pokemon *mon = CurMon();
+    u8 a = sSummary->windows[WIN_PAGE_A], b = sSummary->windows[WIN_PAGE_B], c = sSummary->windows[WIN_PAGE_C];
+    u8 ppBonuses = GetMonData(mon, MON_DATA_PP_BONUSES);
+
+    for (u32 i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u16 move = GetMonData(mon, MON_DATA_MOVE1 + i);
+        u32 pp, maxPP;
+        const u8 *color = sColor_White;
+
+        if (move == MOVE_NONE)
+        {
+            AddTextPrinterParameterized3(a, FONT_NORMAL, 3, MOVE_ROW_Y(i), sColor_White, TEXT_SKIP_DRAW, gText_OneDash);
+            continue;
+        }
+        pp = GetMonData(mon, MON_DATA_PP1 + i);
+        maxPP = CalculatePPWithBonus(move, ppBonuses, i);
+        if (pp == 0)
+            color = sColor_Red;
+        else if (pp <= maxPP / 2)
+            color = sColor_Orange;
+        BlitMenuInfoIcon(c, GetMoveType(move) + 1, 8, MOVE_ROW_Y(i));
+        AddTextPrinterParameterized3(a, FONT_NORMAL, 3, MOVE_ROW_Y(i), sColor_White, TEXT_SKIP_DRAW, GetMoveName(move));
+        AddTextPrinterParameterized3(a, FONT_NORMAL, 20, i * 28 + 16, color, TEXT_SKIP_DRAW, COMPOUND_STRING("PP"));
+        ConvertIntToDecimalStringN(gStringVar1, pp, STR_CONV_MODE_LEFT_ALIGN, 3);
+        PrintRightAligned(a, gStringVar1, 52, i * 28 + 16, color);
+        AddTextPrinterParameterized3(a, FONT_NORMAL, 52, i * 28 + 16, color, TEXT_SKIP_DRAW, gText_Slash);
+        ConvertIntToDecimalStringN(gStringVar1, maxPP, STR_CONV_MODE_LEFT_ALIGN, 3);
+        PrintRightAligned(a, gStringVar1, 70, i * 28 + 16, color);
+    }
+
+    if (sSummary->page != PAGE_MOVE_INFO)
+        return;
+    AddTextPrinterParameterized3(a, FONT_NORMAL, 3, MAX_MON_MOVES * 28 + 5, sColor_White, TEXT_SKIP_DRAW, gText_Cancel);
+    if (sSummary->moveCursor < MAX_MON_MOVES)
+    {
+        u16 move = GetMonData(mon, MON_DATA_MOVE1 + sSummary->moveCursor);
+
+        if (move == MOVE_NONE)
+            return;
+        AddTextPrinterParameterized3(b, FONT_NORMAL, 14, 2, sColor_White, TEXT_SKIP_DRAW, COMPOUND_STRING("Category"));
+        AddTextPrinterParameterized3(b, FONT_NORMAL, 14, 17, sColor_White, TEXT_SKIP_DRAW, COMPOUND_STRING("Power"));
+        AddTextPrinterParameterized3(b, FONT_NORMAL, 14, 32, sColor_White, TEXT_SKIP_DRAW, COMPOUND_STRING("Accuracy"));
+        AddTextPrinterParameterized3(b, FONT_NORMAL, 10, 48, sColor_White, TEXT_SKIP_DRAW, COMPOUND_STRING("Effect"));
+        PrintRightAligned(b, sCategoryNames[GetMoveCategory(move)], 116, 3, sColor_Dark);
+        if (GetMovePower(move) <= 1)
+            StringCopy(gStringVar1, gText_ThreeDashes);
+        else
+            ConvertIntToDecimalStringN(gStringVar1, GetMovePower(move), STR_CONV_MODE_LEFT_ALIGN, 3);
+        PrintRightAligned(b, gStringVar1, 116, 18, sColor_Dark);
+        if (GetMoveAccuracy(move) == 0)
+            StringCopy(gStringVar1, gText_ThreeDashes);
+        else
+            ConvertIntToDecimalStringN(gStringVar1, GetMoveAccuracy(move), STR_CONV_MODE_LEFT_ALIGN, 3);
+        PrintRightAligned(b, gStringVar1, 116, 33, sColor_Dark);
+        if (WrapText(GetMoveDescription(move), FONT_NORMAL, 110) <= 4)
+            PrintLines(b, FONT_NORMAL, 7, 64, 12, sColor_Dark, gStringVar4);
+        else
+        {
+            WrapText(GetMoveDescription(move), FONT_SMALL, 110);
+            PrintLines(b, FONT_SMALL, 7, 63, 10, sColor_Dark, gStringVar4);
+        }
+    }
+}
