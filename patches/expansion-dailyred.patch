+static void CreateFixedSprites(void)
+{
+    for (u32 i = 0; i < HP_BAR_TILES; i++)
+        sSummary->hpBarSpriteIds[i] = CreateTileSprite(TAG_HP_BAR, TAG_HP_BAR, &sOam_8x8, i * 8 + 81, 33);
+    for (u32 i = 0; i < EXP_BAR_TILES; i++)
+        sSummary->expBarSpriteIds[i] = CreateTileSprite(TAG_EXP_BAR, TAG_HP_BAR, &sOam_8x8, i * 8 + 156, 130);
+    sSummary->statusSpriteId = CreateTileSprite(TAG_STATUS, TAG_STATUS, &sOam_32x8, 214, 38);
+    sSummary->shinySpriteId = CreateTileSprite(TAG_SHINY, TAG_SHINY, &sOam_8x16, 166, 50);
+    sSummary->cursorSpriteIds[0] = CreateTileSprite(TAG_CURSOR_LEFT, TAG_CURSOR_PAL, &sOam_64x32, 32, 34);
+    sSummary->cursorSpriteIds[1] = CreateTileSprite(TAG_CURSOR_RIGHT, TAG_CURSOR_PAL, &sOam_64x32, 96, 34);
+}
