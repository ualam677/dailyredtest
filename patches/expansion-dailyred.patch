new file mode 100644
index 00000000..0e7ff87b
--- /dev/null
+++ b/include/dailyred.h
@@ -0,0 +1,106 @@
+#ifndef GUARD_DAILYRED_H
+#define GUARD_DAILYRED_H
+
+// Daily Red: a one-battle challenge mode built on FireRed
+// (pokeemerald-expansion's FRLG build).
+//
+// The player boots straight onto a snowy mountain peak (MAP_DAILY_RED_SUMMIT)
+// as LEAF with six random level 100 Pokemon, climbs to RED and talks to him
+// to start the battle. Win or lose, a new team is generated and the next run
+// starts in the same room.
+//
+// Every vanilla file touched for this mode has a "Daily Red:" comment at the
+// change, so `grep -rn "Daily Red" src include data` lists them all.
+
+#include "global.h"
+#include "constants/dailyred.h"
+
+// src/dailyred.c
+bool8 DailyRed_HasInjectedSeed(void);
+void CB2_DailyRed_StartFromCopyright(void);
+void CB2_DailyRed_StartFromTitle(void);
+void DailyRed_InitNewGame(void);
+void DailyRed_StartNextRun(void);
+void DailyRed_OnBattleStart(void);
+void DailyRed_OnBattleEnd(void);
+void DailyRed_OnDailyGameOver(void);
+u16 DailyRed_IsDailyGame(void);
+bool32 DailyRed_IsOnSummit(void);
+const u16 *DailyRed_GetMtSilverBattlePalette(void);
+
+// The battle boxes' look (src/battle_bg.c; the tiles and frame colours come
+// from scripts/graphics/make-graphics.py): the inside of every box is the
+// HGSS healthboxes' light grey, and the action menu and move list print on
+// their own copy of the battle text palette with that background.
+#define DAILYRED_BATTLE_MENU_PAL_NUM 14
+#define DAILYRED_BATTLE_BOX_FILL_TILE 7 // a box's inside, in the textbox tiles (palette 0)
+#define DAILYRED_BATTLE_BOX_FILL RGB(28, 28, 28)
+#define DAILYRED_BATTLE_TEXT_SHADOW RGB(23, 23, 24)
+
+// src/dailyred_team.c
+void DailyRed_GenerateTeam(struct Pokemon *party, u32 *rngState, u16 redStarter);
+bool32 DailyRed_IsSpeciesInScope(u16 species);
+
+// src/dailyred_red.c
+u16 DailyRed_GenerateRedTeam(u32 *rngState);
+void DailyRed_CreateRedParty(struct Pokemon *party);
+struct Sprite;
+void DailyRed_AnimateTrainerSprite(struct Sprite *sprite, u16 trainerPicId);
+
+// src/dailyred_sets.c, generated by scripts/sets/generate.mjs from Pokemon
+// Showdown's Random Battle sets. Each species has a list of sets per kind:
+enum DailyRedSetKind
+{
+    DAILYRED_SETS_NORMAL, // no Z-Crystal and no Mega Stone
+    DAILYRED_SETS_MEGA,   // a Mega Evolution's sets (the set's species is the base form, holding the stone)
+    DAILYRED_SETS_ZMOVE,  // Z-Crystals allowed (Showdown's odds); the Kanto starters' always hold one
+    DAILYRED_SETS_TERA,   // Gen 9 sets with a Tera type
+};
+
+struct DailyRedSet
+{
+    u32 ivs;                  // packed like TRAINER_PARTY_IVS; only Hidden Power's type uses them
+    u16 species;              // the species to create
+    u16 item;
+    u16 ability;
+    u16 moves[MAX_MON_MOVES];
+    u8 evs[NUM_STATS];        // Showdown's order: HP, Atk, Def, SpA, SpD, Spe (as struct TrainerMon)
+    u8 nature;
+    u8 teraType;              // TYPE_NONE unless it's a Tera set
+    u8 friendship;
+    u8 weight;                // relative odds within its list
+};
+
+struct DailyRedSetList
+{
+    u16 species;              // the forme the sets are for (the Mega forme for Mega lists)
+    u16 firstSet;             // index in gDailyRedSets
+    u8 numSets;
+    u8 kind;                  // enum DailyRedSetKind
+    u8 level;                 // the player's level for it, from its Showdown tier (95-98)
+};
+
+struct DailyRedPickGroup
+{
+    u16 first;                // index in gDailyRedPickLists
+    u8 count;                 // formes of this species (Rotom has 6)
+};
+
+// src/dailyred_mon.c: helpers for both team builders.
+struct TrainerGenerator;
+u16 DailyRed_Random(u32 *rng);
+u32 DailyRed_Random32(u32 *rng);
+const struct DailyRedSetList *DailyRed_FindSetList(u16 species, u8 kind);
+const struct DailyRedSet *DailyRed_PickSet(const struct DailyRedSetList *list, u32 *rng);
+u32 DailyRed_GetTypeMask(u16 species);
+void DailyRed_CreateSetMon(struct Pokemon *mon, const struct DailyRedSet *set, u8 level, u8 gender, bool8 shiny, struct TrainerGenerator *trainerGen);
+
+extern const struct DailyRedSet gDailyRedSets[];
+extern const struct DailyRedSetList gDailyRedSetLists[];
+extern const u16 gDailyRedNumSetLists;
+// RED's random pick from any generation: list indices grouped by species.
+extern const struct DailyRedPickGroup gDailyRedPickGroups[];
+extern const u16 gDailyRedNumPickGroups;
+extern const u16 gDailyRedPickLists[];
+
+#endif // GUARD_DAILYRED_H
