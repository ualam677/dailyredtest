diff --git a/data/maps/DailyRed_Summit/scripts.inc b/data/maps/DailyRed_Summit/scripts.inc
new file mode 100644
index 00000000..69980b74
--- /dev/null
+++ b/data/maps/DailyRed_Summit/scripts.inc
@@ -0,0 +1,118 @@
+DailyRed_Summit_MapScripts::
+	.byte 0
+
+@ Talking to RED starts the battle. It's trainerbattle_earlyrival (an early
+@ rival battle with RIVAL_BATTLE_HEAL_AFTER: the player can lose without
+@ whiting out, and VAR_RESULT is TRUE if they lost) with the trainer flag check
+@ skipped, so RED can be battled again after a win, and without the trainer
+@ encounter jingle, so his battle theme is the first thing that plays. The
+@ DailyRed_On* specials tell the website how the battle is going (see
+@ src/dailyred.c).
+DailyRed_Summit_EventScript_Red::
+	lock
+	faceplayer
+	textcolor NPC_TEXT_COLOR_MALE
+	msgbox DailyRed_Summit_Text_RedIntro
+	special DailyRed_OnBattleStart
+	@ trainerbattle args: localIdA, trainer, intro, lose text, script, localIdB, trainer B, intro B, lose B, script B,
+	@ victory text, cannot-battle text, isDouble, playMusicA, playMusicB, isRematch, continueScript, facePlayer,
+	@ earlyRival, skipFlagCheck, rival battle flags
+	trainerbattle OBJ_ID_NONE, TRAINER_DAILYRED_RED, NULL, DailyRed_Summit_Text_RedDefeat, NULL, OBJ_ID_NONE, TRAINER_NONE, NULL, NULL, NULL, DailyRed_Summit_Text_RedVictory, NULL, FALSE, FALSE, FALSE, FALSE, TRUE, FALSE, TRUE, TRUE, RIVAL_BATTLE_HEAL_AFTER
+	special DailyRed_OnBattleEnd
+	addvar VAR_DAILYRED_BATTLES, 1
+	textcolor NPC_TEXT_COLOR_NEUTRAL
+	goto_if_eq VAR_RESULT, TRUE, DailyRed_Summit_EventScript_PlayerLost
+	addvar VAR_DAILYRED_WINS, 1
+	playfanfare MUS_OBTAIN_BADGE
+	message DailyRed_Summit_Text_PlayerWon
+	waitmessage
+	waitfanfare
+	waitbuttonpress
+	call DailyRed_Summit_EventScript_BufferRecord
+	specialvar VAR_RESULT, DailyRed_IsDailyGame
+	goto_if_eq VAR_RESULT, TRUE, DailyRed_Summit_EventScript_DailyWin
+	goto DailyRed_Summit_EventScript_NextRun
+	end
+
+DailyRed_Summit_EventScript_PlayerLost::
+	msgbox DailyRed_Summit_Text_PlayerLost
+	call DailyRed_Summit_EventScript_BufferRecord
+	specialvar VAR_RESULT, DailyRed_IsDailyGame
+	goto_if_eq VAR_RESULT, TRUE, DailyRed_Summit_EventScript_DailyLoss
+	goto DailyRed_Summit_EventScript_NextRun
+	end
+
+DailyRed_Summit_EventScript_BufferRecord::
+	buffernumberstring STR_VAR_1, VAR_DAILYRED_WINS
+	buffernumberstring STR_VAR_2, VAR_DAILYRED_BATTLES
+	return
+
+@ The website's daily game: one battle a day. After the record the screen
+@ fades out and the website closes the game.
+DailyRed_Summit_EventScript_DailyWin::
+	msgbox DailyRed_Summit_Text_RecordWin
+	goto DailyRed_Summit_EventScript_DailyGameOver
+	end
+
+DailyRed_Summit_EventScript_DailyLoss::
+	msgbox DailyRed_Summit_Text_RecordLoss
+	goto DailyRed_Summit_EventScript_DailyGameOver
+	end
+
+DailyRed_Summit_EventScript_DailyGameOver::
+	closemessage
+	fadescreen FADE_TO_BLACK
+	special DailyRed_OnDailyGameOver
+	@ Keep the script running so the player can't move or talk to RED again
+	@ before the website closes the game.
+DailyRed_Summit_EventScript_DailyGameOverHold::
+	delay 60
+	goto DailyRed_Summit_EventScript_DailyGameOverHold
+	end
+
+@ Anywhere else (practice runs, desktop emulators): straight into a new run.
+DailyRed_Summit_EventScript_NextRun::
+	msgbox DailyRed_Summit_Text_NextRun
+	closemessage
+	fadescreen FADE_TO_BLACK
+	special DailyRed_StartNextRun
+	@ Re-entering the map puts the player back at the start and resets RED.
+	warpsilent MAP_DAILY_RED_SUMMIT, DAILYRED_START_X, DAILYRED_START_Y
+	waitstate
+	release
+	end
+
+@ RED's lines: "…" when you talk to him, "…" when he wins and "…!" when he
+@ loses.
+DailyRed_Summit_Text_RedIntro::
+	.string "…$"
+
+@ Shown in battle when RED loses.
+DailyRed_Summit_Text_RedDefeat::
+	.string "…!$"
+
+@ Shown in battle when RED wins.
+DailyRed_Summit_Text_RedVictory::
+	.string "…$"
+
+DailyRed_Summit_Text_PlayerWon::
+	.string "You defeated RED!$"
+
+DailyRed_Summit_Text_PlayerLost::
+	.string "Your team was wiped out…$"
+
+DailyRed_Summit_Text_RecordWin::
+	.string "Record: {STR_VAR_1} win(s) in\n"
+	.string "{STR_VAR_2} battle(s).\p"
+	.string "Play again tomorrow!$"
+
+DailyRed_Summit_Text_RecordLoss::
+	.string "Record: {STR_VAR_1} win(s) in\n"
+	.string "{STR_VAR_2} battle(s).\p"
+	.string "Try again tomorrow.$"
+
+DailyRed_Summit_Text_NextRun::
+	.string "Record: {STR_VAR_1} win(s) in\n"
+	.string "{STR_VAR_2} battle(s).\p"
+	.string "A new team of six is ready.\n"
+	.string "Climb back up and face RED!$"
