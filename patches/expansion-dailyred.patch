diff --git a/include/dailyred.h b/include/dailyred.h
new file mode 100644
index 00000000..5bb1cc75
--- /dev/null
+++ b/include/dailyred.h
@@ -0,0 +1,153 @@
+#ifndef GUARD_DAILYRED_H
+#define GUARD_DAILYRED_H
+
+// Daily Red: a one-battle challenge mode built on FireRed (pokeemerald-expansion's
+// FRLG build).
+//
+// The player boots straight onto the summit of Mt. Silver
+// (MAP_DAILYRED_MT_SILVER) as LEAF with six random level 100 Pokemon, climbs
+// to RED and talks to him to start the battle. Both teams are built from
+// Pokemon Showdown's Gen 7 Random Battle sets (src/dailyred_sets.c, generated
+// by scripts/sets/generate.mjs). Win or lose, practice runs deal new teams and
+// start again at the foot of the summit.
+//
+// Every vanilla file touched for this mode has a "Daily Red:" comment at the
+// change, so `grep -rn "Daily Red" src include data` lists them all.
+
+#include "global.h"
+#include "random.h"
+#include "constants/dailyred.h"
+
+// ---------------------------------------------------------------------------
+// Showdown set data (src/dailyred_sets.c, generated)
+// ---------------------------------------------------------------------------
+
+// DailyRedSet.flags
+#define DAILYRED_SET_MEGA          (1 << 0)  // holds a Mega Stone (or is Rayquaza with Dragon Ascent)
+#define DAILYRED_SET_ZMOVE         (1 << 1)  // holds a Z-Crystal
+#define DAILYRED_SET_STEALTH_ROCK  (1 << 2)
+#define DAILYRED_SET_SPIKES        (1 << 3)
+#define DAILYRED_SET_TOXIC_SPIKES  (1 << 4)
+#define DAILYRED_SET_STICKY_WEB    (1 << 5)
+#define DAILYRED_SET_HAZARD_CLEAR  (1 << 6)  // Defog or Rapid Spin
+#define DAILYRED_SET_SCREENS       (1 << 7)  // Reflect + Light Screen, or Aurora Veil
+#define DAILYRED_SET_STATUS_CURE   (1 << 8)  // Heal Bell or Aromatherapy
+#define DAILYRED_SET_ILLUSION      (1 << 9)  // Zoroark: never the last Pokemon generated
+#define DAILYRED_SET_FIRE_ABILITY  (1 << 10) // Dry Skin / Fluffy: counts as a Fire weakness
+
+// Moves Showdown gives at most one Pokemon per team (it culls them from later
+// movesets). Spikes is allowed twice.
+#define DAILYRED_SET_ONE_PER_TEAM  (DAILYRED_SET_STEALTH_ROCK | DAILYRED_SET_TOXIC_SPIKES | DAILYRED_SET_STICKY_WEB \
+                                  | DAILYRED_SET_HAZARD_CLEAR | DAILYRED_SET_SCREENS | DAILYRED_SET_STATUS_CURE)
+#define DAILYRED_NO_SET            0xFFFF
+
+// One concrete set, as Showdown's own generator produced it. EVs and IVs use
+// Showdown's stat order (HP, Atk, Def, SpA, SpD, Spe). Every set is used at
+// level 100: stats with a bit in hyperTrained count as IV 31 (Bottle Caps),
+// while the real IVs keep their Hidden Power type.
+struct DailyRedSet
+{
+    u16 species;          // what to create; Mega Stones / Primal Orbs change it in battle
+    u16 item;
+    u16 ability;
+    u16 moves[MAX_MON_MOVES];
+    u16 flags;            // DAILYRED_SET_*
+    u8 evs[NUM_STATS];
+    u8 ivs[NUM_STATS];
+    u8 hyperTrained;      // bit i = stat i in Showdown order
+    u8 friendship;
+    u8 weightOpen;        // how often Showdown picks it while the team has no Z-Move user
+    u8 weightClosed;      // ... and once it has one (0 = never)
+};
+
+// DailyRedForme.flags (the compatibility rules from Showdown's team builder)
+#define DAILYRED_FORME_MEGA        (1 << 0)
+#define DAILYRED_FORME_DRY_SKIN    (1 << 1)  // could have Dry Skin / Fluffy and isn't Fire-weak
+#define DAILYRED_FORME_FREEZE_DRY  (1 << 2)  // weak to Freeze-Dry
+#define DAILYRED_COMPAT_BLISSEY    (1 << 3)
+#define DAILYRED_COMPAT_CHANSEY    (1 << 4)
+#define DAILYRED_COMPAT_ILLUMISE   (1 << 5)
+#define DAILYRED_COMPAT_VOLBEAT    (1 << 6)
+#define DAILYRED_COMPAT_WEB        (1 << 7)
+#define DAILYRED_COMPAT_SCREENS    (1 << 8)
+#define DAILYRED_COMPAT_SUN_HATER  (1 << 9)  // Dry Skin users that sun would hurt
+#define DAILYRED_COMPAT_SUN        (1 << 10)
+#define DAILYRED_COMPAT_SHEDINJA   (1 << 11)
+#define DAILYRED_COMPAT_SAND_HAIL  (1 << 12)
+
+// A Showdown Random Battle entry, e.g. "Charizard-Mega-X" or "Rotom-Wash".
+// Type masks use Showdown's alphabetical type order (see dailyred_sets.c).
+struct DailyRedForme
+{
+    u16 species;          // the forme itself (SPECIES_CHARIZARD_MEGA_X)
+    u16 firstSet;         // its sets: gDailyRedSets[firstSet .. firstSet + numSets)
+    u8 numSets;
+    u8 level;             // Showdown's Random Battle level: lower = stronger
+    u16 flags;            // DAILYRED_FORME_* and DAILYRED_COMPAT_*
+    u32 types;            // bit per type
+    u32 weak;             // types it's weak to (Showdown's getEffectiveness > 0)
+    u32 doubleWeak;       // types it's 4x weak to
+};
+
+// A Showdown base species with all of its formes (e.g. Charizard: Charizard,
+// -Mega-X, -Mega-Y). Showdown draws base species, then a forme.
+struct DailyRedGroup
+{
+    u16 firstForme;
+    u8 numFormes;
+    u8 weight;            // how many tickets it gets in the draw (1-3)
+};
+
+extern const struct DailyRedSet gDailyRedSets[];
+extern const struct DailyRedForme gDailyRedFormes[];
+extern const struct DailyRedGroup gDailyRedGroups[];
+extern const u16 gDailyRedNumSets;
+extern const u16 gDailyRedNumFormes;
+extern const u16 gDailyRedNumGroups;
+extern const u8 gDailyRedNumTypes;
+
+// ---------------------------------------------------------------------------
+// Game flow (src/dailyred.c)
+// ---------------------------------------------------------------------------
+bool8 DailyRed_HasInjectedSeed(void);
+void CB2_DailyRed_StartFromCopyright(void);
+void CB2_DailyRed_StartFromTitle(void);
+void DailyRed_InitNewGame(void);
+void DailyRed_StartNextRun(void);
+void DailyRed_OnBattleStart(void);
+void DailyRed_OnBattleEnd(void);
+void DailyRed_OnDailyGameOver(void);
+u16 DailyRed_IsDailyGame(void);
+
+// ---------------------------------------------------------------------------
+// Teams (src/dailyred_team.c)
+// ---------------------------------------------------------------------------
+
+// What a team generator decided for one Pokemon, before it's created.
+struct DailyRedPick
+{
+    u16 forme;            // index into gDailyRedFormes
+    u16 set;              // index into gDailyRedSets
+};
+
+// Fills `picks` with the player's six (Showdown's team rules plus Daily Red's
+// strength band). Same RNG state in, same team out.
+void DailyRed_PickPlayerTeam(struct DailyRedPick *picks, rng_value_t *rng);
+// RED's six, lead first (see the rules in dailyred_red.c).
+void DailyRed_PickRedTeam(struct DailyRedPick *picks, rng_value_t *rng);
+// Creates a level 100 Pokemon from a set. forPlayer: the player is its
+// original trainer (so it obeys); otherwise it's RED's.
+void DailyRed_CreateMonFromSet(struct Pokemon *mon, const struct DailyRedPick *pick, bool32 forPlayer, rng_value_t *rng);
+// Index of the forme for a species (the Showdown entry), or -1.
+s32 DailyRed_FindForme(u16 species);
+// Picks one of a forme's sets with Showdown's odds. zUsed: the team already
+// has a Z-Move user. avoid: DAILYRED_SET_* flags to stay away from if the
+// forme has other sets (hazards and the like the team already has, as
+// Showdown's move culling does). DAILYRED_NO_SET if every set is a Z-Move set
+// and zUsed is set.
+u16 DailyRed_PickSet(u16 forme, bool32 zUsed, u32 avoid, rng_value_t *rng);
+
+// RED's party for the current run, built at battle start (battle_setup.c).
+void DailyRed_CreateRedParty(struct Pokemon *party);
+
+#endif // GUARD_DAILYRED_H
